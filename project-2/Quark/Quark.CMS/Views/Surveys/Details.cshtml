@{
ViewData[ViewDataNames.Title] = _localizer["Survey"] + " " + _localizer["Details"];
ViewData[ViewDataNames.AsideMenu] = "Content";
ViewData[ViewDataNames.AsideSubMenu] = "Surveys";
ViewData["ShowBackButton"] = true;
ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
{
new BreadcrumbItem(_localizer["Content"], string.Empty),
new BreadcrumbItem(_localizer["Surveys"], "/Surveys/List")
};
}

@using Microsoft.IdentityModel.Tokens
@model Quark.CMS.Business.Models.Responses.SurveyResponses.SurveyDetailsResponse

@section Scripts {
<script src="//www.google.com/jsapi"></script>
<script src="/Scripts/Surveys/Details.js" asp-append-version="true"></script>

}


<input type="hidden" id="option1" value="@Model.Option1Answers"/>
<input type="hidden" id="option2" value="@Model.Option2Answers"/>
<input type="hidden" id="option3" value="@Model.Option3Answers"/>
<input type="hidden" id="option4" value="@Model.Option4Answers"/>

<div class="row g-5">
    <div class="col-xl-7 col-lg-12">
        <div class="card card-stretch h-100">
            <div class="card-header border-0">
                <div class="card-title m-0">
                    <h3 class="fw-bolder m-0">@_localizer["Survey"] @_localizer["Informations"]</h3>
                </div>
                <div class="card-toolbar">
                    <button class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end"><i class="ki-solid ki-dots-horizontal fs-2x me-1"></i></button>
                    <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-200px py-4" data-kt-menu="true">
                        <div class="menu-item px-3"><a onclick="EnableSurvey(@Model.ID)" class="menu-link px-3">@_localizer["Enable"]</a></div>
                        <div class="menu-item px-3"><a onclick="RefreshAnswers(@Model.ID)" class="menu-link px-3">@_localizer["UpdateData"]</a></div>
                    </div>
                </div>
            </div>
            <div class="card-body border-top pt-5">
                <h3 class="fw-bolder m-5 mb-10">@Model.Question</h3>
                <div class="row mb-4">
                    <div class="col-lg-9 d-flex align-items-center fs-6">
                        <div class="bullet bg-warning" style="border-radius: 3px;width: 12px;height: 12px;margin-right: 10px;"></div>
                        <div class="fs-5 fw-bold text-gray-800 fv-row">@Model.Option1</div>
                    </div>
                    <div class="col-lg-3 fw-bold text-gray-800 text-end fs-5">@Model.Option1Answers.ToFormattedPrice()</div>
                </div>
                <div class="row mb-4">
                    <div class="col-lg-9 d-flex align-items-center">
                        <div class="bullet bg-success me-3" style="border-radius: 3px;width: 12px;height: 12px"></div>
                        <div class="fs-5 fw-bold text-gray-800 me-5">@Model.Option2</div>
                    </div>
                    <div class="col-lg-3 fw-bold text-gray-800 text-end fs-5">@Model.Option2Answers.ToFormattedPrice()</div>
                </div>
                <div class="row mb-4">
                    <div class="col-lg-9 d-flex align-items-center">
                        <div class="bullet bg-danger me-3" style="border-radius: 3px;width: 12px;height: 12px"></div>
                        <div class="fs-5 fw-bold text-gray-800 me-5">@Model.Option3</div>
                    </div>
                    <div class="col-lg-3 fw-bold text-gray-800 text-end fs-5">@Model.Option3Answers.ToFormattedPrice()</div>
                </div>
                <div class="row mb-4">
                    <div class="col-lg-9 d-flex align-items-center">
                        <div class="bullet bg-primary me-3" style="border-radius: 3px;width: 12px;height: 12px"></div>
                        <div class="fs-5 fw-bold text-gray-800 me-5">@Model.Option4</div>
                    </div>
                    <div class="col-lg-3 fw-bold text-gray-800 text-end fs-5">@Model.Option4Answers.ToFormattedPrice()</div>
                </div>
                <div class="row mb-4">
                    <div class="col-lg-9 d-flex align-items-center">
                        <div class="me-3" style="border-radius: 3px;width: 12px;height: 12px"></div>
                        <div class="fs-5 fw-bold text-gray-800 me-5"></div>
                    </div>
                    <div class="col-lg-3">
                        <div class="separator separator-dashed border-1 mb-3 border-dark"></div>
                        <div class="fw-bold text-gray-800 text-end fs-5">@Model.TotalAnswers.ToFormattedPrice()</div>
                    </div>
                </div>
                <div class="d-flex flex-column flex-grow-1 pe-8 pt-20">
                    <div class="d-flex flex-wrap">
                        <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                            <div class="d-flex align-items-center">
                                <div class="fs-6 fw-bold counted">@Model.CreatedDate</div>
                            </div>
                            <div class="fw-semibold fs-6 text-gray-500">@_localizer["CreatedDate"]</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.LastUpdated))
                        {
                            <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="fs-6 fw-bold counted">@Model.LastUpdated</div>
                                </div>
                                <div class="fw-semibold fs-6 text-gray-500">@_localizer["LastUpdated"]</div>
                            </div>
                        }
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-5 col-lg-12">
        <div class="card card-stretch h-100">
            <div class="card-header border-0">
                <div class="card-title m-0">
                    <h3 class="fw-bolder m-0">Grafik Görünümü</h3>
                </div>
            </div>
            <div class="card-body border-top p-9">
                    <div id="kt_docs_google_chart_pie" style="width: 100%; height: 100%;"></div>
            </div>
        </div>
    </div>
</div>
