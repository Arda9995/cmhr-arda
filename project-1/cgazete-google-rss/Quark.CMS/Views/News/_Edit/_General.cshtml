@model Quark.CMS.Business.Models.Requests.NewsRequests.NewsRequest

<div class="card card-flush mb-10">
    <div class="card-header">
        <div class="card-title">
            <h2>@_localizer["GeneralInformation"]</h2>
        </div>
    </div>
    <div class="card-body pt-0">
        <div class="mb-10 fv-row">
            <label class="required form-label">@_localizer["Title2"]</label>
            <div class="input-group">
                <input asp-for="@Model.Title" type="text" class="form-control maxlength" maxlength="500" autocomplete="off"/>
                <span class="input-group-text py-0" id="openTitleAIPopup">
                    <a role="button" onclick="ToggleTitleAIDiv();" class="pulse pulse-success" data-bs-toggle="tooltip" data-bs-custom-class="tooltip-inverse" data-bs-placement="top" title="@_localizer["AskToAI"]">
                        <span id="spanTitlePulse" class="border-5"></span>
                        <img src="/img/AI.png" alt="@_localizer["AskToAI"]" class="w-30px"/>
                    </a>
                </span>
            </div>
            <span asp-validation-for="@Model.Title" class="fv-plugins-message-container invalid-feedback"></span>
            <div class="text-muted fs-7">@_localizer["NewsTitleText"]</div>
            <div id="divTitleAI" class="card card-flush shadow-lg position-absolute z-index-3 w-75 mt-n2" style="display: none;">
                <div class="card-header">
                    <h3 class="card-title">
                        <img src="/img/AI.png" alt="@_localizer["AskToAI"]" class="w-30px me-3"/>
                        @_localizer["AskToAI"]
                    </h3>
                    <div class="card-toolbar"></div>
                </div>
                <div class="card-body pt-0">
                    <div class="d-flex">
                        <input id="txtTitleAI" type="text" class="form-control form-control-solid" placeholder="@_localizer["TitleAI"]"/>
                    </div>
                    <div class="menu menu-rounded menu-column menu-title-gray-700 menu-icon-gray-500 menu-arrow-gray-500 menu-bullet-gray-500 menu-arrow-gray-500 menu-state-bg fw-semibold w-400px mt-5" data-kt-menu="true">
                        @foreach (var titlePrompt in Model.TitlePrompts)
                        {
                            <div class="menu-item">
                                <a onclick="sendTitleGenerationRequestToAi(@titlePrompt.ID)" class="menu-link py-3">
                                    <span class="menu-icon">
                                        <i class="bi bi-pen fs-3"></i>
                                    </span>
                                    <span class="menu-title">@titlePrompt.Name</span>
                                    <input id="titleRequestType" type="hidden" asp-for="@titlePrompt.RequestType" value="@titlePrompt.RequestType"/>
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end py-6 px-9">
                    @* <button type="submit" class="btn btn-primary me-2">Kullan</button> *@
                    <a role="button" onclick="ToggleTitleAIDiv();" class="btn btn-light btn-active-light-primary">@_localizer["Close"]</a>
                </div>
            </div>
        </div>
        <div class="mb-10 fv-row">
            <label class="required form-label">@_localizer["Subtitle"]</label>
            <div class="input-group">
                <textarea asp-for="@Model.Subtitle" type="text" class="form-control maxlength" maxlength="1000" rows="4"></textarea>
                <span class="input-group-text py-0" id="openSubtitleAIPopup">
                    <a role="button" onclick="ToggleSubtitleAIDiv();" class="pulse pulse-success" data-bs-toggle="tooltip" data-bs-custom-class="tooltip-inverse" data-bs-placement="top" title="@_localizer["AskToAI"]">
                        <img src="/img/AI.png" alt="@_localizer["AskToAI"]" class="w-30px"/>
                    </a>
                </span>
            </div>
            <span asp-validation-for="@Model.Subtitle" class="fv-plugins-message-container invalid-feedback"></span>
            <div class="text-muted fs-7">@_localizer["NewsSubtitleText"]</div>

            <div id="divSubtitleAI" class="card card-flush shadow-lg position-absolute z-index-3 w-75 mt-n2" style="display: none;">
                <div class="card-header">
                    <h3 class="card-title">
                        <img src="/img/AI.png" alt="@_localizer["AskToAI"]" class="w-30px me-3"/>
                        @_localizer["AskToAI"]
                    </h3>
                    <div class="card-toolbar"></div>
                </div>
                <div class="card-body pt-0">
                    <div class="d-flex">
                        <input id="txtsubTitleAI" type="text" class="form-control form-control-solid" placeholder="@_localizer["SubtitleAI"]"/>
                    </div>
                    <div class="menu menu-rounded menu-column menu-title-gray-700 menu-icon-gray-500 menu-arrow-gray-500 menu-bullet-gray-500 menu-arrow-gray-500 menu-state-bg fw-semibold w-400px mt-5" data-kt-menu="true">
                        @foreach (var subtitlePrompt in Model.SubtitlePrompts)
                        {
                            <div class="menu-item">
                                <a onclick="sendSubtitleGenerationRequestToAi(@subtitlePrompt.ID)" class="menu-link py-3">
                                    <span class="menu-icon">
                                        <i class="bi bi-pen fs-3"></i>
                                    </span>
                                    <span class="menu-title">@subtitlePrompt.Name</span>
                                    <input id="subtitleRequestType" type="hidden" asp-for="@subtitlePrompt.RequestType" value="@subtitlePrompt.RequestType"/>
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end py-6 px-9">
                    @* <button type="submit" class="btn btn-primary me-2">Kullan</button> *@
                    <a role="button" onclick="ToggleSubtitleAIDiv();" class="btn btn-light btn-active-light-primary">@_localizer["Close"]</a>
                </div>
            </div>
        </div>
        <div class="mb-10 fv-row">
            <label for="basic-url" class="required form-label">URL</label>
            <div class="input-group">
                @if (Model.NewsTypeID == (int)NewsTypesEnum.Ad)
                {
                    <span class="input-group-text" id="slug"> </span>
                    <input asp-for="@Model.Slug" type="text" class="form-control maxlength" maxlength="500" id="basic-url" aria-describedby="basic-addon3"/>

                }else{
                    <span class="input-group-text" id="slug">@Model.BaseURL</span>
                    <input asp-for="@Model.Slug" type="text" class="form-control maxlength" maxlength="500" id="basic-url" aria-describedby="basic-addon3"/>
                    <span class="input-group-text py-0">
                        <a role="button" onclick="ToggleUrlGenerate();" data-bs-toggle="tooltip" data-bs-custom-class="tooltip-inverse" data-bs-placement="top" title="Başlığa göre oluştur">
                            <i class="ki-duotone ki-subtitle fs-2x mt-1 text-primary">
                                <span class="path1"></span>
                                <span class="path2"></span>
                                <span class="path3"></span>
                                <span class="path4"></span>
                                <span class="path5"></span>
                            </i>
                        </a>
                    </span>
                }
            </div>
            <span asp-validation-for="@Model.Slug" class="fv-plugins-message-container invalid-feedback"></span>
            <div id="url-note" class="text-muted fs-7">@_localizer["NewsUrlHint"]</div>
        </div>
        <div class="mb-10 fv-row">
            <label class="required form-label">@_localizer["Content"]</label>
            <textarea asp-for="@Model.Content" class="form-control @_appSettings.Text_Editor summernote"></textarea>
            <span asp-validation-for="@Model.Content" class="fv-plugins-message-container invalid-feedback"></span>
        </div>
        <div class="mb-10 fv-row">
            <label class="form-label">Video</label>
            <input asp-for="@Model.Video" type="text" class="form-control maxlength" maxlength="250" />
            <div class="text-muted fs-7 mt-2">@_appSettings.VideoTextFieldHintText</div>
            <span asp-validation-for="@Model.Video" class="fv-plugins-message-container invalid-feedback"></span>
        </div>
    </div>
</div>