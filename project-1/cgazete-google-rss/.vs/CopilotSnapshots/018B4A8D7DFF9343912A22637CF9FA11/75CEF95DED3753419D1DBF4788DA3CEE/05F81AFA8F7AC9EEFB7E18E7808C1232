    private async Task<ServiceResult> UnPublish(long id, string description)
    {
        var result = new ServiceResult();

        await using var tx = await _context.Database.BeginTransactionAsync();
        try
        {
            // 1. Get and validate news
            var news = await _context.News.FirstOrDefaultAsync(x => x.ID == id);
            if (news.IsPublished == false)
            {
                result.SetError(_localizer["Error"]);
                return result;
            }

            // 3. Update news status
            news.StatusID = (int)NewsStatusEnum.Unpublished;
            news.IsPublished = false;
            _context.News.Update(news);
            await _context.SaveChangesAsync();

            // 4. Remove published news
            var publishedNew = await _context.NewsPublished.FirstOrDefaultAsync(x => x.NewsID == id);
            if (publishedNew != null)
            {
                _context.NewsPublished.Remove(publishedNew);
                await _context.SaveChangesAsync();
            }


            // 6. Remove published photos
            var publishedPhotos = await _context.NewsPublishedPhotos.Where(x => x.NewsID == news.ID).ToListAsync();
            _context.NewsPublishedPhotos.RemoveRange(publishedPhotos);
            await _context.SaveChangesAsync();

            // 7. Remove block items and related news
            var blockItem = await _context.BlockItems.FirstOrDefaultAsync(x => x.NewsID == id);
            if (blockItem != null)
            {
                _context.BlockItems.Remove(blockItem);
                await _context.SaveChangesAsync();
            }

            var relatedNews = await _context.RelatedNews.Where(x => x.RelatedNewsID == id).ToListAsync();
            if (relatedNews.Any())
            {
                _context.RelatedNews.RemoveRange(relatedNews);
                await _context.SaveChangesAsync();
            }

            // 8. Update author news count
            var author = await _context.Authors.FirstOrDefaultAsync(x => x.ID == news.AuthorID);
            if (author != null)
            {
                author.TotalNewsCount -= 1;
                _context.Authors.Update(author);
                await _context.SaveChangesAsync();
            }

            // 9. Add system log
            var log = new SystemLog
            {
                UserID = 86, //SYSTEM USER
                LogTypeID = (int)LogTypesEnum.News,
                IsSuccess = true,
                Message = news.Title + " yayından kaldırıldı.",
                ObjectID = (long)news.ID
            };
            _context.SystemLogs.Add(log);
            await _context.SaveChangesAsync();

            await tx.CommitAsync();

            // 10. Handle cache operations after transaction
            await _newsCachingService.HandleUnPublishCacheOperations(news);

            result.SetSuccess(_localizer["UnPublishMessage"]);
        }
        catch (Exception e)
        {
            await tx.RollbackAsync();
            result.SetError(_localizer["Error"]);
            return result;
        }

        return result;
    }

    private async Task<ServiceResult> UnLock(long id)
    {
        var result = new ServiceResult();

        using var tx = await _context.Database.BeginTransactionAsync();
        try
        {
            // 1. Get and validate news
            var news = await _context.News.FirstOrDefaultAsync(x => x.ID == id);
            if (!news.IsLocked)
            {
                result.SetError(_localizer["RecordNotFound"]);
                return result;
            }

            // 2. Update news lock status
            news.IsLocked = false;
            news.LockedBy = null;
            news.LockedTime = null;

            _context.News.Update(news);
            await _context.SaveChangesAsync();
            await tx.CommitAsync();

            result.SetSuccess(_localizer["UnLockMessage"]);
        }
        catch (Exception e)
        {
            await tx.RollbackAsync();
            result.SetError(_localizer["Error"]);
            return result;
        }

        return result;
    }

    public async Task UnPublishScheduledNews()
    {
        var publishedNews = await _context.NewsPublished.Where(x => x.PublishEndDate <= DateTime.Now).ToListAsync();
        var description = "Yayın süresi dolduğu için yayından kaldırıldı.";

        foreach (var news in publishedNews)
        {
            try
            {
                UnPublish((long)news.NewsID, description);
            }
            catch (Exception e)
            {
                var log = new SystemLog
                {
                    UserID = 86, //SYSTEM USER
                    LogTypeID = (int)LogTypesEnum.News,
                    IsSuccess = false,
                    Message = news.Title + " yayından kaldırılırken hata oluştu. Hata: " + e.Message,
                    ObjectID = (long)news.NewsID
                };
                _context.SystemLogs.Add(log);
                await _context.SaveChangesAsync();
            }
        }
    }

    public async Task UnLock()
    {
        var lockedNews = await _context.News.Where(x => x.IsLocked && x.LockedTime <= DateTime.Now).ToListAsync();

        foreach (var news in lockedNews)
        {
            await using var tx = await _context.Database.BeginTransactionAsync();
            try
            {
                news.IsLocked = false;
                news.LockedTime = null;
                _context.News.Update(news);

                var log = new SystemLog
                {
                    UserID = 86, //SYSTEM USER
                    LogTypeID = (int)LogTypesEnum.News,
                    IsSuccess = true,
                    Message = news.Title + " kilit süresi dolduğu için kilidi kaldırıldı.",
                    ObjectID = (long)news.ID
                };
                _context.SystemLogs.Add(log);

                await _context.SaveChangesAsync();
                await tx.CommitAsync();
            }
            catch (Exception e)
            {
                await tx.RollbackAsync();
                var log = new SystemLog
                {
                    UserID = 86, //SYSTEM USER
                    LogTypeID = (int)LogTypesEnum.News,
                    IsSuccess = false,
                    Message = news.Title + " kilidi kaldırılırken hata oluştu. Hata: " + e.Message,
                    ObjectID = (long)news.ID
                };
                _context.SystemLogs.Add(log);
                await _context.SaveChangesAsync();
            }
        }
    }

    public async Task RefreshNewsViewCount()
    {
        await using var tx = await _context.Database.BeginTransactionAsync();
        try
        {
            var increasedElasticDatas = await _newsCachingService.GetIncreasedNewsViewCount();
            if (increasedElasticDatas.Data.Any())
            {
                var increasedDatas = increasedElasticDatas.Data.Select(x => new NewsViewCountHangfireResponse
                {
                    Count = x.Count,
                    NewsID = x.NewsID,
                }).ToList();

                foreach (var data in increasedDatas)
                {
                    var news = await _context.News.FirstOrDefaultAsync(x=>x.ID == data.NewsID);
                    if(news == null)
                    {
                        continue;
                    }
                    if (news.ViewCount != null)
                    {
                        news.ViewCount += data.Count;
                    }
                    else
                    {
                        news.ViewCount = 0;
                    }
                    _context.News.Update(news);
                }
                await _context.SaveChangesAsync();
                await tx.CommitAsync();
            }
        }
        catch (Exception e)
        {
            await tx.RollbackAsync();
            var log = new SystemLog
            {
                LogTypeID = (int)LogTypesEnum.Hangfire,
                IsSuccess = false,
                Message = "Haber görüntülenme güncellenirken hata oluştu: " + e.Message,
            };

            _context.SystemLogs.Add(log);
            await _context.SaveChangesAsync();
        }


    }
