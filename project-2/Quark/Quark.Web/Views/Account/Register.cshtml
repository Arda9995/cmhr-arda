@model Quark.API.Business.Models.Requests.AccountRequests.RegistrationRequest

@{
	Layout = "_LayoutNoAds";
}

@section Styles {
	<link rel="stylesheet" href="~/assets/css/app.Cj_mCUCZ.css">
}

<partial name="_Header" />

<main id="main" class="my-4 px-5 tablet:px-0">
	<div class="max-w-container mx-auto space-y-6 undefined">
		<main class="max-w-5xl mx-auto px-4 py-8 w-full font-helvetica">
			<!-- Progress Steps -->
			<div class="flex items-center justify-center mb-12">
				<div class="flex items-center">
					<div class="flex flex-col items-center">
						<div class="w-10 h-10 rounded-full bg-red-600 text-white flex items-center justify-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
							</svg>
						</div> <span class="text-sm mt-1 text-center">Abone Kaydı</span>
					</div>
					<div class="w-12 sm:w-24 h-[1px] bg-gray-300 mx-4"></div>
				</div>
				<div class="flex items-center">
					<div class="flex flex-col items-center">
						<div class="w-10 h-10 rounded-full bg-gray-200 text-gray-400 flex items-center justify-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"></path>
							</svg>
						</div> <span class="text-sm mt-1 text-gray-400 text-center">Hesap Bilgileri</span>
					</div>
					<div class="w-12 sm:w-24 h-[1px] bg-gray-300 mx-4"></div>
				</div>
				<div class="flex items-center">
					<div class="flex flex-col items-center">
						<div class="w-10 h-10 rounded-full bg-gray-200 text-gray-400 flex items-center justify-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path>
								<path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"></path>
							</svg>
						</div> <span class="text-sm mt-1 text-gray-400 text-center">Ödeme</span>
					</div>
				</div>
			</div> <!-- Title -->
			<h1 class="text-2xl font-bold text-center mb-8">Reklamsız Cumhuriyet Abonelik</h1> <!-- Form -->
			<form class="max-w-3xl mx-auto space-y-6" asp-action="Register" asp-controller="Account" method="post">
				<div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
				<div>
					<label for="email" class="block text-sm font-medium text-gray-700">E-Posta adresi <span class="text-red-600">*</span></label>
					<input type="email" asp-for="Email" id="email" required
						   class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-red-500 focus:border-red-500 sm:text-sm">
					<span asp-validation-for="Email" class="text-red-500 text-sm"></span>
				</div>
				<div>
					<label for="password" class="block text-sm font-medium text-gray-700">Şifre <span class="text-red-600">*</span></label>
					<input type="password" asp-for="Password" id="password" required minlength="6"
						   class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-red-500 focus:border-red-500 sm:text-sm">
					<span asp-validation-for="Password" class="text-red-500 text-sm"></span>
				</div>
				<div>
					<label for="confirmPassword" class="block text-sm font-medium text-gray-700">Şifre Tekrar <span class="text-red-600">*</span></label>
					<input type="password" asp-for="ConfirmPassword" id="confirmPassword" required minlength="6"
						   class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-red-500 focus:border-red-500 sm:text-sm">
					<span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
				</div>
				<div class="grid sm:grid-cols-2 gap-4">
					<div>
						<label class="block text-sm font-medium mb-2">Adınız</label>
						<input asp-for="@Model.Firstname" type="text" class="w-full p-3 border border-gray-300 rounded-lg" required>
					</div>
					<div>
						<label class="block text-sm font-medium mb-2">Soyadınız</label>
						<input asp-for="@Model.Lastname" type="text" class="w-full p-3 border border-gray-300 rounded-lg" required>
					</div>
				</div>
				<div class="flex items-start gap-2">
					<input type="checkbox" id="terms" class="mt-1 w-4 h-4 text-red-600 border-gray-300 rounded focus:ring-red-500" required>
					<label for="terms" class="text-sm text-gray-600 font-helvetica">
						"DEVAM ET" butonuna basarak,
						<a href="#" class="text-blue-600">Üyelik</a>,
						<a href="#" class="text-blue-600">Gizlilik</a> ve
						<a href="#" class="text-blue-600">Kişisel Verilerin Korunması Şartları</a>'nı ve de Reklamsız Cumhuriyet aboneliğinizle ilgili tüm hizmet, bülten, kampanya ve promosyonlara ilişkin telefon, e-posta, bildirim ve SMS almayı kabul etmiş sayılırsınız.
					</label>
				</div>
				<div>
					<button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
						Kayıt Ol
					</button>
				</div>
				<div class="text-center">
					<p class="text-sm text-gray-600"> Hesabınız mı var? <a href="/uye/giris" class="text-blue-600">Giriş yapın</a> </p>
				</div>
			</form>
		</main>
	</div>
</main>