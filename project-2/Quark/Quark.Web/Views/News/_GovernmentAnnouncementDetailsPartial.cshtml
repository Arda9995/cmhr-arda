@model Quark.API.Business.Models.Responses.NewsResponses.GetNewsDetailResponse;
<style>
	.bik-metni p {
		font-size: 16px;
		font-family: Arial;
		margin: 16px 0;
	}
	@@media screen and (min-width: 1300px) {
		.bik-container
		{
			max-width: 1280px !important;
		}
	}
</style>
<div class="max-w-container mx-auto space-y-6 undefined bik-container">
	<input type="hidden" class="news-detail-header-title" asp-for="@Model.CategoryName"/>
	<input type="hidden" class="news-detail-news-type" asp-for="@Model.NewsTypeID"/>
	<input type="hidden" class="news-detail-header-title" asp-for="@Model.ScrollNewsIDs"/>
	<input type="hidden" class="news-detail-header-title" asp-for="@Model.ID"/>
	<!-- Breadcrumb Start -->
	<nav class="flex items-center gap-2 text-xs undefined">
		<a href="/" class="text-gray-500 hover:text-gray-600 transition-all font-medium"> Haberler </a>
		<span>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M6 12L10 8L6 4" stroke="#6B7280" stroke-width="2" stroke-linecap="round"
				      stroke-linejoin="round"></path>
			</svg>
		</span><a href="@Model.CategorySlug" class="text-red-600 font-semibold "> Resmi İlanlar </a>
	</nav> <!-- Breadcrumb End -->
	<div class="text-center mt-8 mb-9 space-y-4">
		<!-- Title Start -->
		<h1 class="text-slate-900 text-xl font-semibold title" data-title-news-id="@Model.ID"> @Model.Title </h1> <!-- Title End  -->
