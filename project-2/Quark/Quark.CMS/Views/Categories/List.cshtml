@{
    ViewData[ViewDataNames.Title] = _localizer["Categories"];
    ViewData[ViewDataNames.AsideMenu] = "Content";
    ViewData[ViewDataNames.AsideSubMenu] = "Categories";
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Content"], string.Empty)
    };
}

@section Styles{
<link href="https://metronic.b-cdn.net/8.1.5/assets/plugins/custom/jstree/jstree.bundle.css" rel="stylesheet" type="text/css" />
}

@section Scripts{
<script src="https://metronic.b-cdn.net/8.1.5/assets/plugins/custom/jstree/jstree.bundle.js" type="text/javascript"></script>
<script src="/Scripts/Categories/List.js" asp-append-version="true"></script>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="card-title">@_localizer["Categories"]</div>
                <div class="card-toolbar">
                    <div class="d-flex align-items-center position-relative my-1">
                        <ul class="nav">
                            <li class="nav-item">
                                <a class="nav-link btn btn-sm btn-color-muted btn-active-color-primary btn-active-light fw-bold fs-7 px-4 me-1 active" data-bs-toggle="tab" onclick="ShowOnlyEnableds();">
                                    @_localizer["Enabled"] @_localizer["Categories"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-sm btn-color-muted btn-active-color-primary btn-active-light fw-bold fs-7 px-4 me-1" data-bs-toggle="tab" onclick="ShowAll();">
                                    @_localizer["All"] @_localizer["Categories"]
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div id="divCategoriesTree"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title" id="spanSelectedCategories">--</h3>
            </div>
            <div class="card-body">
                <div class="d-flex">
                    <a class="btn btn-success me-4" href="/Categories/Create">
                        <i class="fa fa-plus"></i>
                        @_localizer["New"] @_localizer["Parent"] @_localizer["Category"]
                    </a>
                    <a class="btn btn-success" onclick="GotoAdd();">
                        <i class="fa fa-plus"></i>
                        @_localizer["New"] @_localizer["Child"] @_localizer["Category"]
                    </a>
                </div>
                <div class="separator my-10"></div>
                <div class="d-flex">
                    <a class="btn btn-primary me-4" onclick="GotoDetails();">
                        <i class="fa fa-edit"></i>
                        @_localizer["Details"]
                    </a>
                    <a class="btn btn-primary me-4" onclick="GotoUpdate();">
                        <i class="fa fa-edit"></i>
                        @_localizer["Update"]
                    </a>
                    <a class="btn btn-danger" onclick="Delete();">
                        <i class="fa fa-times"></i>
                        @_localizer["Delete"]
                    </a>
                </div>
                <div class="separator my-10"></div>
            </div>
        </div>
    </div>
</div>
