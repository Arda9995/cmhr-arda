@{
    ViewData[ViewDataNames.Title] = _localizer["Anomaly"] + " " + _localizer["List"];
    ViewData[ViewDataNames.AsideMenu] = "Management";
    ViewData[ViewDataNames.AsideSubMenu] = "Anomalies";
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Management"], string.Empty),
        new BreadcrumbItem(_localizer["Anomalies"], "/Anomalies/List")
    };
}
@model Quark.CMS.Business.Models.Requests.AnomalyRequests.ListFiltersRequest

@section Scripts{
    <script src="/Scripts/Anomalies/List.js" asp-append-version="true"></script>
}

<div class="card mb-7">
    <div class="card-body">
        <div class="d-flex align-items-center">
            <div class="position-relative w-md-400px me-md-2">
                <span class="svg-icon svg-icon-3 svg-icon-gray-500 position-absolute top-50 translate-middle ms-6">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect opacity="0.5" x="17.0365" y="15.1223" width="8.15546" height="2" rx="1" transform="rotate(45 17.0365 15.1223)" fill="currentColor"/>
                        <path d="M11 19C6.55556 19 3 15.4444 3 11C3 6.55556 6.55556 3 11 3C15.4444 3 19 6.55556 19 11C19 15.4444 15.4444 19 11 19ZM11 5C7.53333 5 5 7.53333 5 11C5 14.4667 7.53333 17 11 17C14.4667 17 17 14.4667 17 11C17 7.53333 14.4667 5 11 5Z" fill="currentColor"/>
                    </svg>
                </span>
                <input type="text" data-kt-filter="datatable-search" class="form-control form-control-solid ps-10" name="search" value="" placeholder="@_localizer["Search"]"/>
            </div>
            <div class="d-flex align-items-center">
                <button onclick="applyFilter()" class="btn btn-primary me-5">@_localizer["Search"]</button>
                <a id="kt_horizontal_search_advanced_link" class="btn btn-link" data-bs-toggle="collapse" href="#kt_advanced_search_form">@_localizer["AdvancedSearch"]</a>
            </div>
        </div>
        <div class="collapse" id="kt_advanced_search_form">
            <div class="separator separator-dashed mt-9 mb-6"></div>
            <div class="row">
                <div class="col-3">
                    <div class="mb-0">
                        <label class="fs-6 form-label fw-bolder text-dark">@_localizer["DataType"]</label>
                        <select asp-items="@Model.DataTypes" id="dataType" class="form-select form-select-solid" data-control="select2"></select>
                    </div>
                </div>
                <div class="col-3">
                    <div class="mb-0">
                        <label class="fs-6 form-label fw-bolder text-dark">@_localizer["Issue"]</label>
                        <select asp-items="@Model.IssueTypes" id="issueType" class="form-select form-select-solid" data-control="select2"></select>
                    </div>
                </div>
                <div class="col-3">
                    <div class="mb-0">
                        <label class="fs-6 form-label fw-bolder text-dark">@_localizer["User"]</label>
                        <select asp-items="@Model.Users" id="user" class="form-select form-select-solid" data-control="select2"></select>
                    </div>
                </div>
                <div class="col-3">
                    <div class="mb-0">
                        <label class="fs-6 form-label fw-bolder text-dark">@_localizer["ShowOnlyUnsolved"]</label>
                        <div class="form-check form-switch form-check-custom form-check-solid mt-2">
                            <input asp-for="OnlyShowUnResolved" class="form-check-input" type="checkbox" id="OnlyShowUnResolved"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card card-flush">
    <div class="card-body py-4">
        <table id="datatable">
            <thead>
            <tr>
                <th>@_localizer["Page"]</th>
                <th>@_localizer["DataType"]</th>
                <th>@_localizer["Issue"]</th>
                <th>@_localizer["CreatedDate"]</th>
                <th>@_localizer["Status"]</th>
                <th class="w-100px text-center"></th>
            </tr>
            </thead>
            <tbody>
            <div style="display:none">
                <div id="Col1">
                    <a href="{0}">{1}</a>
                </div>
                <div id="Col2">
                    {0}
                </div>
                <div id="Col3">
                    {0}
                </div>
                <div id="Col4">
                    {0}
                </div>
                <div id="Col5">
                    {0}
                </div>
                <div id="Col6">
                    <a href="/Anomalies/Details/{0}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Details"]">
                        <partial name="Icons/Details"/>
                    </a>
                </div>
            </div>
            </tbody>
        </table>
    </div>
</div>