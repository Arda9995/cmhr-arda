    public async Task UnlockNews()
    {
        await _newsCachingService.RefreshMainPageGovernmentAnnouncement();
        var newsList = (from n in await _context.News
                        where n.IsLocked
                              && n.LockedTime.Value.AddMinutes(30) >= DateTime.Now
                        select n).ToListAsync();

        if (newsList.Any())
        {
            foreach (var news in newsList)
            {
                await UnLock(news.ID);
            }

            await _context.SaveChangesAsync();
        }
    }

    public async Task PublishScheduledNews()
    {
        var scheduledNews = await _context.News.Where(x => x.StatusID == (int)NewsStatusEnum.Scheduled && x.PublishDate <= DateTime.Now).ToListAsync();

        foreach (var news in scheduledNews)
        {
            try
            {
                PublishNow(news);
            }
            catch (Exception e)
            {
                var log = new SystemLog
                {
                    UserID = 86, //SYSTEM USER
                    LogTypeID = (int)LogTypesEnum.News,
                    IsSuccess = false,
                    Message = news.Title + " yayına alınırken hata oluştu. Hata: " + e.Message,
                    ObjectID = (long)news.ID
                };
                _context.SystemLogs.Add(log);
                await _context.SaveChangesAsync();
            }
        }
    }

    public async Task UnPublishNewsByPublishEndDate()
    {
        var publishedNews = await _context.News
            .Where(x => x.StatusID == (int)NewsStatusEnum.Published && x.PublishEndDate <= DateTime.Now)
            .ToListAsync();

        var description = "Yayından kalkma tarihinden dolayı haber yayından kaldırıldı. ";

        if (publishedNews.Count > 0 && publishedNews is not null)
        {
            foreach (var news in publishedNews)
            {
                try
                {
                    UnPublish((long)news.ID, description);
                }
                catch (Exception e)
                {
                    var log = new SystemLog
                    {
                        LogTypeID = (int)LogTypesEnum.Hangfire,
                        IsSuccess = false,
                        Message = "Haber yayından kaldırılamadı. " + e,
                        ObjectID = (long)news.ID
                    };

                    _context.SystemLogs.Add(log);
                    await _context.SaveChangesAsync();
                }
            }

            // Cache refresh operations after all transactions
            await _xmlFeedCachingService.RefreshAllRSS();
            await _authorCachingService.RefreshAll();
            await _authorCachingService.RefreshMainPageAuthorsAll();
            await _systemLogCachingService.RefreshAll();
        }
    }

    public async Task RefreshSurveyCount()
    {
        await using var tx = await _context.Database.BeginTransactionAsync();
        try
        {
            var surveyIDs = await _context.Surveys.Select(x => x.ID).ToListAsync();
            foreach (var survey in surveyIDs)
            {

                var newsId = (from s in _context.Surveys
                              join nw in _context.NewsVersions on s.NewsVersionID equals nw.ID
                              where s.ID == survey
                              select nw.NewsID).FirstOrDefault();

                if (newsId != 0 && newsId != null)
                {
                    var surveyResult = await _newsCachingService.GetSurveyOptionResult(survey);
                    if (surveyResult.Data == null || !surveyResult.IsSuccess)
                    {
                        continue;
                    }
                    if (surveyResult.Data.SurveyOptions.Any())
                    {
                        var cachedSurveyOptions = surveyResult.Data.SurveyOptions;

                        var surveyOptions = await _context.SurveyOptions.Where(x => x.SurveyID == survey)
                            .ToListAsync();

                        foreach (var surveyOption in surveyOptions)
                        {
                            surveyOption.AnswerCount = cachedSurveyOptions.FirstOrDefault(x => x.OptionID == surveyOption.ID)?.AnswerCount ?? 0;
                            _context.SurveyOptions.Update(surveyOption);
                        }
                        await _context.SaveChangesAsync();
                        await _blockCachingService.RefreshBlockNewsWithKey("AnaSayfa-AnketHaberi");
                        await _newsCachingService.RefreshNewsDetails((int)newsId);
                        await _newsCachingService.RefreshNewsByCategorySlug((int)CategoryEnum.Survey);
                    }
                }
            }

            await tx.CommitAsync();
        }
        catch (Exception e)
        {
            await tx.RollbackAsync();
            var log = new SystemLog
            {
                LogTypeID = (int)LogTypesEnum.Hangfire,
                IsSuccess = false,
                Message = "Anket sonuçları güncellenirken hata oluştu: " + e.Message,
            };

            _context.SystemLogs.Add(log);
            await _context.SaveChangesAsync();
        }
    }

    public async Task RefreshAuthorsMainPageAndTodaysNewsList()
