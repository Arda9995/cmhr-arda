using AppSettingsKeys = Quark.Business.Common.Caching.AppSettingsKeys;

var cleanContent = typeof(XmlFeedCachingService).GetMethod("CleanGoogleAiContent", BindingFlags.NonPublic | BindingFlags.Static)
    ?? throw new InvalidOperationException("Google AI content cleanup method is missing.");
string CleanContent(string html) => (string)cleanContent.Invoke(null, new object[] { html });

void CheckContent(string original, string cleaned)
{
    var beforeHtml = new HtmlDocument();
    beforeHtml.LoadHtml(original ?? string.Empty);
    var afterHtml = new HtmlDocument();
    afterHtml.LoadHtml(cleaned);
    var beforeNodes = beforeHtml.DocumentNode.Descendants().ToList();
    var afterNodes = afterHtml.DocumentNode.Descendants().ToList();
    if (beforeNodes.Count != afterNodes.Count || beforeHtml.DocumentNode.InnerText != afterHtml.DocumentNode.InnerText)
        throw new InvalidOperationException("HTML structure or article text changed during cleanup.");
    for (var i = 0; i < beforeNodes.Count; i++)
    {
        var expectedAttributes = beforeNodes[i].Attributes
            .Where(x => !x.Name.Equals("style", StringComparison.OrdinalIgnoreCase) &&
                        !x.Name.Equals("class", StringComparison.OrdinalIgnoreCase))
            .Select(x => (x.Name, x.Value));
        if (beforeNodes[i].Name != afterNodes[i].Name ||
            !expectedAttributes.SequenceEqual(afterNodes[i].Attributes.Select(x => (x.Name, x.Value))))
            throw new InvalidOperationException("Only style/class attributes should be removed; preserve src/alt/href and other attributes.");
    }
}

if (args.Length == 1 && args[0] == "--check-content")
{
    string[] samples =
    {
        null, string.Empty, "Plain text: style=example class=example &amp; text",
        "<p style=\"color:red\" class='intro'>Türkçe <strong>bold</strong> <em>italic</em></p>",
        "<p STYLE='color:red' CLASS=lead><a href='https://example.com/?a=1&amp;b=2' title='style=keep' class='link'>Link</a><img src='photo.jpg' alt='Photo &amp; caption' style='width:100%' /></p>",
        "<span style='white-space: pre;'> </span><p class='one' class='two' style='a' style='b'>Text</p>",
        "<p data-style='keep' data-class='keep' title='a > b; class=keep' STYLE='x > y'>Text &bull;</p>",
        "<p class='lead'>Unclosed <strong style='color:red'>formatting"
    };
    foreach (var sample in samples)
    {
        var cleaned = CleanContent(sample);
        CheckContent(sample, cleaned);
        if (CleanContent(cleaned) != cleaned)
            throw new InvalidOperationException("Content cleanup must be idempotent.");
    }
    Console.WriteLine($"PASS {samples.Length} offline HTML cleanup cases: only style/class removed; text, markup and meaningful attributes preserved.");
    return;
}

if (args.Length != 3 || args[1] != "--write-archive" || !long.TryParse(args[2], out var newsId) || newsId <= 0)
    throw new ArgumentException("Usage: GoogleAiArchiveCheck --check-content OR <workspace-root> --write-archive <news-id>. Reads SQL only; rebuilds the article's daily archive twice to verify same-file updates; never contacts Elasticsearch.");

var root = Path.GetFullPath(args[0]);
var configuration = new ConfigurationBuilder()
    .SetBasePath(Path.Combine(root, "Quark.CMS"))
    .AddJsonFile("appsettings.json")
    .AddJsonFile("appsettings.Development.json")
    .Build();
var connectionString = configuration.GetConnectionString("ConnectionString");
var target = new SqlConnectionStringBuilder(connectionString);
if (target.DataSource != "192.168.35.32" || target.InitialCatalog != "News-Migration")
    throw new InvalidOperationException("Only the approved development database is allowed.");

var options = new DbContextOptionsBuilder<QuarkDataContext>()
    .UseSqlServer(connectionString)
    .UseQueryTrackingBehavior(QueryTrackingBehavior.NoTracking)
    .AddInterceptors(new RejectDatabaseWrites())
    .Options;
await using var context = new QuarkDataContext(options);
var services = new ServiceCollection();
services.AddMemoryCache();
services.AddScoped<ICacheManager, MemoryCacheManager>();
services.AddLocalization();
services.AddLogging(builder => builder.AddConsole());
using var provider = services.BuildServiceProvider();
using var scope = provider.CreateScope();
var cache = scope.ServiceProvider.GetRequiredService<ICacheManager>();
var keys = new[] { "Common_ClientWebSite", "CDN_BaseUrl", "CDN_MediaGalleryFolder" };
foreach (var setting in await context.AppSettings.Where(x => keys.Contains(x.Key)).ToListAsync())
    await cache.Set(setting.Key, setting.Value);
var settings = new AppSettingsKeys(cache);
var siteUrl = settings.Common_ClientWebSite;
if (string.IsNullOrWhiteSpace(siteUrl))
    throw new InvalidOperationException("The website URL setting is missing.");

var articleBefore = await context.NewsPublished.Where(x => x.NewsID == newsId)
    .Select(x => new { x.NewsID, x.ExcludeFromGoogleAiFeed, x.AllowToSendRSS, x.NewsTypeID, x.PublishedDate, x.Slug })
    .SingleOrDefaultAsync();
if (articleBefore == null)
    throw new InvalidOperationException("The requested published article does not exist.");
var day = articleBefore.PublishedDate.Date;
var nextDay = day.AddDays(1);
var expected = await context.NewsPublished
    .Where(x => x.PublishedDate >= day && x.PublishedDate < nextDay &&
                x.AllowToSendRSS && !x.ExcludeFromGoogleAiFeed &&
                (x.NewsTypeID == (int)NewsTypesEnum.News || x.NewsTypeID == (int)NewsTypesEnum.ColumnArticles))
    .Select(x => new { x.NewsID, x.Slug, x.Content, x.AuthorID })
    .ToListAsync();
var authorIds = expected.Where(x => x.AuthorID.HasValue).Select(x => x.AuthorID.Value).Distinct().ToList();
var authors = await context.Authors.Where(x => authorIds.Contains(x.ID))
    .ToDictionaryAsync(x => x.ID, x => ((x.Firstname ?? string.Empty) + " " + (x.Lastname ?? string.Empty)).Trim());
var archiveRoot = Path.Combine(root, "GoogleAiFeedArchive");
var expectedPath = Path.Combine(archiveRoot, day.Year.ToString(), $"feed-{day:yyyy-MM-dd}.xml");
Dictionary<string, string> SnapshotFiles() => Directory.Exists(archiveRoot)
    ? Directory.EnumerateFiles(archiveRoot, "*.xml", SearchOption.AllDirectories)
        .ToDictionary(x => x, x => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(x))))
    : new Dictionary<string, string>();
var before = SnapshotFiles();

var elastic = DispatchProxy.Create<IElasticSearchService, FailingElasticProxy>();
var service = new XmlFeedCachingService(
    new HttpContextAccessor { HttpContext = new DefaultHttpContext() }, context,
    scope.ServiceProvider.GetRequiredService<IStringLocalizer<CommonResource>>(), settings, cache, elastic,
    scope.ServiceProvider.GetRequiredService<ILogger<XmlFeedCachingService>>());
for (var repetition = 0; repetition < 2; repetition++)
{
    var result = await service.ArchiveGoogleAiNewsAsync(newsId);
    if (!result.IsSuccess)
        throw new InvalidOperationException($"Archive failed: {result.Message}");
    var path = result.Data;
    if (!string.Equals(path, expectedPath, StringComparison.OrdinalIgnoreCase))
        throw new InvalidOperationException($"Unexpected daily filename: {path}; expected {expectedPath}");
    var file = new FileInfo(path);
    if (!file.Exists || file.Length == 0)
        throw new InvalidOperationException($"Archive is missing or empty: {path}");
    var document = XDocument.Load(path);
    if (document.Root?.Name != "rss" || (string)document.Root.Attribute("version") != "2.0")
        throw new InvalidOperationException($"Invalid RSS document: {path}");
    if (document.Root.GetNamespaceOfPrefix("atom") != XNamespace.Get("http://www.w3.org/2005/Atom"))
        throw new InvalidOperationException($"RSS Atom namespace is missing or incorrect: {path}");
    var items = document.Root.Element("channel")?.Elements("item").ToList()
        ?? throw new InvalidOperationException("RSS channel is missing.");
    var expectedUrls = expected.Select(x => $"{siteUrl.TrimEnd('/')}/{(x.Slug ?? string.Empty).TrimStart('/')}")
        .OrderBy(x => x, StringComparer.Ordinal);
    var actualUrls = items.Select(x => (string)x.Element("guid")).OrderBy(x => x, StringComparer.Ordinal);
    if (items.Count != expected.Count || !expectedUrls.SequenceEqual(actualUrls))
        throw new InvalidOperationException($"Archive must contain every eligible article from {day:yyyy-MM-dd}, with no articles from other days: {path}");
    XNamespace content = "http://purl.org/rss/1.0/modules/content/";
    XNamespace media = "http://search.yahoo.com/mrss/";
    XNamespace atom = "http://www.w3.org/2005/Atom";
    XNamespace dc = "http://purl.org/dc/elements/1.1/";
    var channel = document.Root.Element("channel");
    if (document.Root.GetNamespaceOfPrefix("content") != content ||
        document.Root.GetNamespaceOfPrefix("media") != media || document.Root.GetNamespaceOfPrefix("dc") != dc ||
        (string)channel.Element("title") != "Cumhuriyet Gazetesi - Google AI Feed" ||
        (string)channel.Element("ttl") != "60" || channel.Element("image")?.Element("url") == null ||
        channel.Element("description") == null ||
        (string)channel.Element(atom + "link")?.Attribute("rel") != "self" ||
        (string)channel.Element(atom + "link")?.Attribute("href") != "https://www.cumhuriyet.com.tr/feeds/google-ai.xml")
        throw new InvalidOperationException("The full feed channel or namespaces are missing.");
    if (items.Any(x => x.Element("title") == null || x.Element("pubDate") == null || x.Element(content + "encoded") == null))
        throw new InvalidOperationException("An archive item is missing its title, date, or content.");
    foreach (var item in items)
    {
        if (item.Descendants("description").Any() || item.Element(content + "encoded").HasElements)
            throw new InvalidOperationException("Items must not include redundant descriptions or XML nested inside content:encoded.");
        var article = expected.Single(x => $"{siteUrl.TrimEnd('/')}/{(x.Slug ?? string.Empty).TrimStart('/')}" == (string)item.Element("guid"));
        CheckContent(article.Content, item.Element(content + "encoded").Value);
        var expectedAuthor = article.AuthorID.HasValue && authors.TryGetValue(article.AuthorID.Value, out var name)
            ? name : string.Empty;
        if (((string)item.Element(dc + "creator") ?? string.Empty) != expectedAuthor)
            throw new InvalidOperationException("dc:creator does not match the article's assigned author.");
        var enclosure = item.Element("enclosure");
        var photo = item.Element(media + "content");
        if (string.IsNullOrEmpty((string)enclosure?.Attribute("url")) ||
            (string)enclosure.Attribute("url") != (string)photo?.Attribute("url") ||
            !int.TryParse((string)photo?.Attribute("width"), out var width) || width <= 0 ||
            !int.TryParse((string)photo?.Attribute("height"), out var height) || height <= 0)
            throw new InvalidOperationException("The enclosure or media photo metadata is missing.");
        if (DateTimeOffset.Parse((string)item.Element("pubDate"), System.Globalization.CultureInfo.InvariantCulture).Date != day)
            throw new InvalidOperationException("An archive item belongs to a different publication day.");
        if (!item.Element(content + "encoded").Nodes().OfType<XCData>().Any())
            throw new InvalidOperationException("Full article content is not enclosed in CDATA.");
    }
    Console.WriteLine($"PASS refresh {repetition + 1}: {path}: all {items.Count} eligible daily articles, valid RSS/CDATA, {file.Length} bytes.");
}
var afterArchive = SnapshotFiles();
if (afterArchive.Count != before.Count + (before.ContainsKey(expectedPath) ? 0 : 1) ||
    before.Where(x => x.Key != expectedPath).Any(x => !afterArchive.TryGetValue(x.Key, out var hash) || hash != x.Value))
    throw new InvalidOperationException("A numbered file was created or an unrelated archive was changed.");
var missingArticle = await service.ArchiveGoogleAiNewsAsync(long.MaxValue);
if (!missingArticle.IsSuccess || missingArticle.Data != null || SnapshotFiles().Count != afterArchive.Count)
    throw new InvalidOperationException("An absent article must not create an empty archive.");
var refreshResult = await service.RefreshGoogleAiRSS();
if (((FailingElasticProxy)(object)elastic).UpdateCalls != 1 || refreshResult.IsSuccess)
    throw new InvalidOperationException("The simulated Elasticsearch outage was not reported.");
var afterRefresh = SnapshotFiles();
if (afterRefresh.Count != afterArchive.Count || afterArchive.Any(x => afterRefresh[x.Key] != x.Value))
    throw new InvalidOperationException("A live feed refresh must not create or overwrite archives.");
var articleAfter = await context.NewsPublished.Where(x => x.NewsID == newsId)
    .Select(x => new { x.NewsID, x.ExcludeFromGoogleAiFeed, x.AllowToSendRSS, x.NewsTypeID, x.PublishedDate, x.Slug })
    .SingleOrDefaultAsync();
if (!Equals(articleBefore, articleAfter))
    throw new InvalidOperationException("Article state changed during validation; repeat on a stable database.");
Console.WriteLine($"PASS article {newsId} exclusion unchanged: {articleAfter?.ExcludeFromGoogleAiFeed}.");
Console.WriteLine("PASS the same daily file is reused; no numbered files created; other archives unchanged; live refresh isolated from archives. No database settings were changed.");

public class FailingElasticProxy : DispatchProxy
{
    public int UpdateCalls { get; private set; }

    protected override object Invoke(MethodInfo targetMethod, object[] args)
    {
        if (targetMethod.Name == nameof(IElasticSearchService.UpdateDocumentAsync))
        {
            UpdateCalls++;
            return Task.FromException<bool>(new InvalidOperationException("Simulated Elasticsearch outage for archive validation; no network request was made."));
        }
        throw new InvalidOperationException("Unexpected Elasticsearch operation in archive check.");
    }
}

public class RejectDatabaseWrites : SaveChangesInterceptor
{
    public override InterceptionResult<int> SavingChanges(DbContextEventData eventData, InterceptionResult<int> result)
        => throw new InvalidOperationException("Database writes are not allowed in this check.");

    public override ValueTask<InterceptionResult<int>> SavingChangesAsync(DbContextEventData eventData, InterceptionResult<int> result, CancellationToken cancellationToken = default)
        => throw new InvalidOperationException("Database writes are not allowed in this check.");
}
