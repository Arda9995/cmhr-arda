@model MainPageResponse

@{
    var mainSlideR = Model.PageNewsCachingResponses.Where(x => x.BlockKey == "AnaSayfa-AnaSlider").ToList();
    var miniSlideR = Model.PageNewsCachingResponses.Where(x => x.BlockKey == "AnaSayfa-MiniSlider").ToList();
}

<div class="grid grid-cols-12 gap-6" data-astro-cid-j7pv25f6>
    <div class="col-span-12 md:col-span-8 " data-astro-cid-j7pv25f6>
        <div class="splide second--slider with-page-numbers red" role="group">
            <div class="splide__track aspect-[16/9]">
                <ul class="splide__list">
                    @foreach (var news in mainSlideR)
                    {
                        <li class="splide__slide relative" data-astro-cid-j7pv25f6>
                            <a target="_blank" tabindex="0" href="@news.NewsSlug" class="block relative" data-astro-cid-j7pv25f6>
                               
                                <div class="aspect-[16/9]" data-astro-cid-j7pv25f6>
                                    <img class="w-full h-full object-cover" src="@news.NewsPhoto" alt="@news.NewsUpHeadline" data-astro-cid-j7pv25f6>
                                </div>
                                @if (news.ShowHeadline)
                                {
                                    <div class="absolute manset-gradient inset-0" data-astro-cid-j7pv25f6></div>
                                    <div class="absolute bottom-0 left-0 right-0 flex flex-col justify-center items-center py-3 gap-y-1" data-astro-cid-j7pv25f6>
                                        @if (news.ShowUpHeadline && !string.IsNullOrEmpty(news.NewsUpHeadline))
                                        {
                                            <div class="bg-[#FF0101] text-xl font-medium py-1 px-3 text-white" data-astro-cid-j7pv25f6> @news.NewsUpHeadline </div>
                                        }
                                    
                                            <div class="text-3xl font-bold text-white px-10 text-center" data-astro-cid-j7pv25f6> @news.NewsHeadline </div>
                                    </div>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-span-12 md:col-span-4 flex flex-col justify-between" data-astro-cid-j7pv25f6>
        @{
            var survey = Model.PageNewsCachingResponses.Where(x => x.BlockKey == "AnaSayfa-AnketHaberi").FirstOrDefault();
        }
        @if (survey != null && survey.SurveyItem != null)
        {
            <!-- Poll Start -->
            <a target="_blank" href="@survey.NewsSlug" class="primary-gradient p-3 text-white block">
                <!-- Title Start -->
                <div class="flex items-center gap-4 justify-between">
                    <span class="font-semibold">Cumhuriyet Soruyor?</span>
                    <!-- <span class="flex-1 bg-gradient-to-r from-white to-transparent h-px"></span> -->
                    <span class="text-sm text-[#72C877] font-helvetica">@survey.SurveyItem.JoinedUserCount kişi katıldı</span>
                </div>
                <!-- Title End -->
                <div class="flex gap-3 items-end mt-2">
                    <!-- Text Start -->
                    <div class="font-medium line-clamp-2">
                        @survey.SurveyItem.Question
                    </div>
                    <!-- Text End -->
                    <!-- Button Start -->
                    <div class="flex justify-end">
                        <div class="font-bold">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M6.07794 2.74405C6.22144 2.60057 6.41235 2.51438 6.61487 2.50164C6.8174 2.48891 7.01761 2.55051 7.17794 2.67488L7.25628 2.74405L13.9229 9.41072C14.0664 9.55421 14.1526 9.74513 14.1653 9.94765C14.1781 10.1502 14.1165 10.3504 13.9921 10.5107L13.9229 10.5891L7.25628 17.2557C7.10631 17.4052 6.90508 17.4919 6.69346 17.4984C6.48183 17.5049 6.27568 17.4305 6.11688 17.2905C5.95807 17.1505 5.85852 16.9553 5.83844 16.7445C5.81837 16.5337 5.87926 16.3232 6.00877 16.1557L6.07794 16.0774L12.1554 9.99989L6.07794 3.92238C5.92171 3.76611 5.83395 3.55419 5.83395 3.33322C5.83395 3.11225 5.92171 2.90032 6.07794 2.74405Z" fill="#F2F2F7"></path>
                            </svg>
                        </div>
                    </div>
                    <!-- Button End -->
                </div>
            </a>
            <!-- Poll End -->
        }
        <div class="splide third--slider with-page-numbers aspect-[16/9] w-full" role="group">
            <div class="splide__track">
                <ul class="splide__list">
                    @foreach (var news in miniSlideR)
                    {
                        <li class="splide__slide" data-astro-cid-j7pv25f6>
                            <a target="_blank" class="flex flex-col h-full" href="@news.NewsSlug" data-astro-cid-j7pv25f6>
                                <div class="aspect-[16/9]" data-astro-cid-j7pv25f6>
                                    <img class="w-full h-full object-cover" src="@news.NewsPhoto" alt="@news.NewsHeadline" loading="lazy" data-astro-cid-j7pv25f6>
                                </div>
                                <div class="primary-gradient text-white py-2 px-3 font-semibold line-clamp-2 flex-1 flex flex-col justify-center" data-astro-cid-j7pv25f6> @news.NewsHeadline </div>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>