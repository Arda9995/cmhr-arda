@model Quark.CMS.Business.Models.Responses.NewsResponses.NewsVersionLiveResponse

<div class="alert alert-dismissible bg-danger d-flex flex-column flex-sm-row p-8">
    <i class="ki-duotone ki-lock-2 fs-2hx text-light me-4 mb-5 mb-sm-0">
        <span class="path1"></span>
        <span class="path2"></span>
        <span class="path3"></span>
        <span class="path4"></span>
        <span class="path5"></span>
    </i>
    <div class="d-flex flex-column text-light pe-0 pe-sm-10">
        <h4 class="mb-2 text-light">@_localizer["NewsLocked"]</h4>
        <span>@string.Format(_localizer["NewsLockedBy"], Model.LockedBy)</span>
        <span>@string.Format(_localizer["NewsLockedText"], (Model.LockedTime.Value.AddMinutes(30) - DateTime.Now).TotalMinutes.ToString("N0"), (@Model.LockedTime.Value.AddMinutes(30).Hour), (Model.LockedTime.Value.AddMinutes(30).Minute.ToString("00")))</span>
    </div>
    <button type="button" class="position-absolute position-sm-relative m-2 m-sm-0 top-0 end-0 btn btn-icon ms-sm-auto" data-bs-dismiss="alert">
        <i class="ki-duotone ki-cross-circle fs-2x text-light">
            <span class="path1"></span><span class="path2"></span>
        </i>
    </button>
</div>