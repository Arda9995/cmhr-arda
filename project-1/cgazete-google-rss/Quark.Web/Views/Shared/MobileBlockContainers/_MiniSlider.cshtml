@model MainPageResponse
@{
    var miniSliderNews = Model.PageNewsCachingResponses.Where(x => x.BlockKey == "AnaSayfa-MiniSlider").ToList();
}

<div class="splide third--slider mobile-pagination mt-6" role="group">
    <div class="splide__track">
        <ul class="splide__list">

            @foreach (var news in miniSliderNews)
            {
                <li class="splide__slide">
                    <a href="@news.NewsSlug" target="_blank" class="flex flex-col h-full">
                        <div class="aspect-[16/9]">
                            <img class="w-full h-full object-cover" src="@news.NewsPhoto" alt="@news.NewsHeadline" loading="lazy">
                        </div>
                        <div class="primary-gradient text-white py-2 px-3 font-semibold flex-1 flex flex-col justify-center">
                            <span class="line-clamp-2">@news.NewsHeadline</span>
                        </div>
                    </a>
                </li>
            }
        </ul>
    </div>
</div>