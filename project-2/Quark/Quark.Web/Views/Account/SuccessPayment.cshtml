@{
	Layout = "_LayoutNoAds";
}

<head>
	<meta name="description" content="Reklamsız Cumhuriyet aboneliğiniz başarıyla oluşturuldu">
	<title>Ödeme Başarılı - Reklamsız Cumhuriyet</title><!-- Plugins -->
</head>

<partial name="_Header"/>

<main id="main" class="my-4 px-5 tablet:px-0">
	<div class="max-w-container mx-auto space-y-6 max-w-none">
		<main class="max-w-4xl mx-auto px-4 py-12 w-full font-helvetica"> <!-- Success Message -->
			<div class="max-w-2xl mx-auto">
				<div class="bg-green-100 border border-green-300 rounded-lg p-5">
					<div class="flex items-center justify-center mb-4">
						<div class="w-12 h-12 rounded-full bg-green-300 flex items-center justify-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" viewBox="0 0 20 20"
							     fill="currentColor">
								<path fill-rule="evenodd"
								      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
								      clip-rule="evenodd"></path>
							</svg>
						</div>
					</div>
					<h2 class="text-lg font-semibold text-gray-900 text-center mb-2">Teşekkür Ederiz!</h2>
					<p class="text-sm text-gray-600 text-center leading-relaxed mb-6"> Abonelik bilgileriniz başarıyla
						tamamlandı. Artık Reklamsız Cumhuriyet aboneliğinize ait e-posta ve şifrenizle, Cumhuriyet mobil
						uygulamamıza ve masaüstü veya mobil tarayıcınızdan Cumhuriyet.com.tr'ye giriş yaparak, dünyanın
						her yerinden, tüm cihazlardan reklamsız okuma deneyimi yaşayabilir, E-Gazetemize
						erişebilirsiniz. </p>
					<div class="text-center"><a href="/uye/anasayfa"
					                            class="inline-flex items-center justify-center px-5 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
							Reklamsız Cumhuriyet Giriş </a></div>
				</div>
			</div>
		</main>
	</div>
</main>
