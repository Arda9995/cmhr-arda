@{
    ViewData[ViewDataNames.Title] = _localizer["Caricaturists"];
    ViewData[ViewDataNames.AsideMenu] = "Content";
    ViewData[ViewDataNames.AsideSubMenu] = "Caricaturists";
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Content"], string.Empty),
        new BreadcrumbItem(_localizer["Caricaturists"], "/Caricaturists/List")
    };
}

@section Scripts {
    <script src="/Scripts/Caricaturists/List.js" asp-append-version="true"></script>
}

<div class="card">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
            <div class="d-flex align-items-center position-relative my-1">
                <partial name="Icons/Search" />
                <input type="text" data-kt-filter="datatable-search" id="search-value" class="form-control form-control-solid w-250px ps-14" placeholder="@_localizer["Search"]">
            </div>
        </div>
        <div class="card-toolbar">
            <div class="d-flex justify-content-end">
                <a href="/Caricaturists/Create" class="btn btn-primary me-3">
                    <partial name="Icons/Add" />
                    @_localizer["New"] @_localizer["Caricaturist"]
                </a>
            </div>
        </div>
    </div>
    <div class="card-body py-4">
        <table id="datatable">
            <thead>
                <tr>
                    <th class="w-70px text-center"></th>
                    <th>@_localizer["Caricaturist"]</th>
                    <th class="text-center">@_localizer["Headline"]</th>
                    <th class="text-center"></th>
                </tr>
            </thead>
            <tbody>
                <div style="display:none">
                    <div id="Col1">
                        {0}
                    </div>
                    <div id="Col2">
                        <a href="/Caricaturists/Details/{1}">{0}</a>
                    </div>
                    <div id="Col3">
                        {0}
                    </div>
                    <div class="text-center" id="Col12">
                        <a href="/Caricaturists/Update/{0}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Update"]">
                            <partial name="Icons/Edit" />
                        </a>
                        <a onclick="DeleteRecordAndRefreshPage('/Caricaturists/Delete/{1}')" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Delete"]">
                            <partial name="Icons/Delete" />
                        </a>
                    </div>
                </div>
            </tbody>
        </table>
    </div>
</div>