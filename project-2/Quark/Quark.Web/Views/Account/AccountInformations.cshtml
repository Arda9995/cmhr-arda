@using Quark.Data.Models
@model Quark.API.Business.Models.Requests.AccountRequests.RegistrationRequest
@{
    Layout = "_LayoutNoAds";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/app.Cj_mCUCZ.css">
}


@section Scripts {
    <script src="~/js/Scripts/Account/Account.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            const bireyselValue = '@((int)MemberTypeEnum.Individual)';

            $("input[name='TypeID']").change(function () {
                const selectedValue = $(this).val();
                const bireyselForm = $("#bireysel-form");
                const kurumsalForm = $("#kurumsal-form");

                if (selectedValue === bireyselValue) {
                    bireyselForm.show();
                    kurumsalForm.hide();
                    
                    bireyselForm.find('input[required], select[required], textarea[required]').prop('required', true);
                    kurumsalForm.find('input[required], select[required], textarea[required]').prop('required', false);
                } else {
                    bireyselForm.hide();
                    kurumsalForm.show();
                    
                    kurumsalForm.find('input[required], select[required], textarea[required]').prop('required', true);
                    bireyselForm.find('input[required], select[required], textarea[required]').prop('required', false);
                }
            });

            $("input[name='TypeID']:checked").trigger('change');
            
            $("form").on('submit', function(e) {
                $("#MobilePhone, #CompanyPhone").each(function() {
                    let phoneNumber = $(this).val().trim();
                    
                    if (!phoneNumber && !$(this).prop('required')) {
                        return true;
                    }
                    
                    phoneNumber = phoneNumber.replace(/\D/g, '');
                    
                    if (phoneNumber.length === 10) {
                        phoneNumber = "+90" + phoneNumber;
                    } else if (phoneNumber.length === 11 && phoneNumber.startsWith('0')) {
                        phoneNumber = "+9" + phoneNumber;
                    } else if (phoneNumber.length === 12 && phoneNumber.startsWith('90')) {
                        phoneNumber = "+" + phoneNumber;
                    } else if (!phoneNumber.startsWith('+')) {
                        phoneNumber = "+" + phoneNumber;
                    }
                    
                    $(this).val(phoneNumber);
                });
            });
        });

    </script>
}

