@model Quark.CMS.Business.Models.Requests.NewsRequests.GetNewsFiltersRequest
@if (Model.HasCreateUpdateRight)
{
    <div class="app-navbar-item ms-1 ms-md-4">
        <div class="btn btn-primary btn-sm" data-kt-menu-trigger="{default: 'click'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
            <partial name="Icons/Add"/>
            @_localizer["New"] @_localizer["News"]
        </div>

        <div class="menu menu-sub menu-sub-dropdown menu-column w-100 w-sm-350px mt-2" data-kt-menu="true" style="max-height: 400px; overflow-y: auto;">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">@_localizer["New"] @_localizer["News"]</div>
                </div>
                <div class="card-body py-5">
                    @foreach (var newsType in @Model.CreateTypes)
                    {
                        <div class="row">
                            <div class="col-12 p-0">
                                <a href="/News/Create/@newsType.ID" class="d-flex flex-column text-start text-gray-800 text-hover-primary bg-hover-light rounded py-4 px-3">
                                    <div class="row">
                                        <div class="col-3">
                                            <partial name="@newsType.Icon"/>
                                        </div>
                                        <div class="col-9 mt-3">
                                            <span class="text-dark fw-bold d-block fs-3">@newsType.Name</span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
