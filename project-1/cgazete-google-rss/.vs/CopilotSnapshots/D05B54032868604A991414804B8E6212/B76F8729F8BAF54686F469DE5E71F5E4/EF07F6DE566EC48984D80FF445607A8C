IF NOT EXISTS (
    SELECT 1
    FROM [dbo].[News.NewsPhotoTypes]
    WHERE [ID] = 10
)
BEGIN
    SET IDENTITY_INSERT [dbo].[News.NewsPhotoTypes] ON;

    INSERT INTO [dbo].[News.NewsPhotoTypes] (
        [ID],
        [Key],
        [Name],
        [Description],
        [Width],
        [Height],
        [IsEnabled],
        [IsRequired],
        [Order]
    )
    VALUES (
        10,
        'GoogleAiHighResPhoto',
        N'Google AI Yüksek Çözünürlüklü Görsel',
        N'Google AI Feed için yüksek çözünürlüklü görsel. Minimum 1600x1200, maksimum 3200x3200.',
        1600,
        1200,
        1,
        0,
        50
    );

    SET IDENTITY_INSERT [dbo].[News.NewsPhotoTypes] OFF;
END
ELSE
BEGIN
    UPDATE [dbo].[News.NewsPhotoTypes]
    SET [Key] = 'GoogleAiHighResPhoto',
        [Name] = N'Google AI Yüksek Çözünürlüklü Görsel',
        [Description] = N'Google AI Feed için yüksek çözünürlüklü görsel. Minimum 1600x1200, maksimum 3200x3200.',
        [Width] = 1600,
        [Height] = 1200,
        [IsEnabled] = 1,
        [IsRequired] = 0
    WHERE [ID] = 10;
END
GO
