        private ServiceResult ValidateGoogleAiHighResPhotos(NewsRequest request)
        {
            var result = new ServiceResult();
            if (request != null && request.AllowGoogleAiFeed &&
                request.Photos?.Any(x => x.PhotoTypeID == (int)NewsPhotoTypesEnum.GoogleAiHighResPhoto &&
                                         !string.IsNullOrWhiteSpace(x.PhotoURL)) != true)
            {
                result.SetError(_localizer["Error_GoogleAiPhotoRequired"]);
                return result;
            }

            if (request?.Photos == null)
            {
                return result;
            }

            const int minWidth = 1600;
            const int minHeight = 1200;
            const int maxSize = 3200;

            foreach (var photo in request.Photos.Where(x =>
                         x.PhotoTypeID == (int)NewsPhotoTypesEnum.GoogleAiHighResPhoto &&
                         !string.IsNullOrWhiteSpace(x.PhotoURL)))
            {
                // Width/Height 0 ise upload/galeri validasyonuna güven; burada false-fail etme.
                if (photo.Width <= 0 || photo.Height <= 0)
                {
                    continue;
                }

                if (photo.Width < minWidth || photo.Height < minHeight ||
                    photo.Width > maxSize || photo.Height > maxSize)
                {
                    result.SetError(_localizer["Error_GoogleAiPhotoSize"]);
                    return result;
                }
            }

            return result;
        }

