@using Microsoft.IdentityModel.Tokens
@model Quark.CMS.Business.Models.Responses.NewsResponses.DetailsNewsResponse

<div class="card mb-5" id="photoGalleryItems">
    <div class="card-header collapsible cursor-pointer rotate collapsed" data-bs-toggle="collapse" data-bs-target="#kt_docs_card_collapsible1">
        <div class="card-title">
            <h2>@_localizer["PhotoGalleryItems"]</h2>
        </div>
        <div class="card-toolbar rotate-180">
            <i class="ki-duotone ki-down fs-1"></i>
        </div>
    </div>
    <div id="kt_docs_card_collapsible1" class="collapse">
        <div class="card-body">
            <div class="row tab-content tab-content-photo-gallery">
                @foreach (var item in Model.PhotoGalleryItems)
                {
                    <div class="col-md-2 p-2 photo-item " id="tab_@item.Order" data-order="@item.Order">
                        <div class="photo-items position-relative">
                            <img src="@item.PhotoURL" alt="@item.PhotoURL" class="img-fluid cursor-move" />
                            <input type="hidden" asp-for="@item.Content" id="photogallery-content-input_@item.ID" class="content" />
                            <button class="btn p-0 btn-primary position-absolute top-0 start-0 m-1 edit-photo" data-id="@item.ID">
                                <i class="ki-duotone ki-pencil fs-1 text-light">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                            </button>
                            <button class="btn p-0 btn-danger position-absolute top-0 end-0 m-1 delete-photo" data-id="@item.Order">
                                <i class="ki-duotone ki-cross-circle p-0 fs-1 text-light">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                            </button>
                            <div id="preview-content_@item.ID" class="p-2"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card-footer">
            <a class="btn btn-sm btn-info btn-light mediaGalleryForPhotoGallery">
                <partial name="Icons/Add" />
                @_localizer["New"]
            </a>
            <a class="btn btn-sm btn-primary" onclick="SendPhotoGalleryItems()">
                @_localizer["Save"]
            </a>
            <a class="btn btn-sm btn-warning" onclick="BlendAndSendPhotoGalleryItems()">
                @_localizer["BlendAndSave"]
            </a>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="photo-gallery-content-modal">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title w-100 text-center">
                    @_localizer["PhotoGalleryItem_Content"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="photo-id" />

                <div class="mb-3">
                    <textarea id="photo-content" class="form-control content tinymce" rows="10"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" id="save-photo-content" class="btn btn-primary">
                    @_localizer["Save"]
                </button>

                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    @_localizer["Close"]
                </button>
            </div>

        </div>
    </div>
</div>
