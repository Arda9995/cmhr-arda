var articleAfter = await context.NewsPublished.Where(x => x.NewsID == newsId)
    .Select(x => new { x.NewsID, x.AllowGoogleAiFeed,
    .SingleOrDefaultAsync();
if (!Equals(articleBefore, articleAfter))
    throw new InvalidOperationException("Article state changed during validation; repeat on a stable database.");
{articleAfter?.AllowGoogleAiFeed}
