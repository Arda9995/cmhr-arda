public class NewsRequestValidator : AbstractValidator<NewsRequest>
{
    public NewsRequestValidator(IStringLocalizer<CommonResource> _localizer)
    {
        RuleFor(x => x.Title)
            .NotEmpty().WithMessage(_localizer["ValidationForRequired"])
            .MaximumLength(500).WithMessage(_localizer["ValidationForMaxLength"]);

        RuleFor(x => x.Subtitle)
            .NotEmpty().WithMessage(_localizer["ValidationForRequired"])
            .MaximumLength(1000).WithMessage(_localizer["ValidationForMaxLength"]);

        RuleFor(x => x.NewsTypeID)
            .NotEmpty().WithMessage(_localizer["ValidationForRequired"]);

        RuleFor(x => x.Content)
            .NotEmpty().WithMessage(_localizer["ValidationForRequired"]);

        RuleFor(x => x.CategoryID)
            .GreaterThanOrEqualTo(0).WithMessage(_localizer["ValidationForRequired"]);

        RuleFor(x => x.AuthorID)
            .GreaterThanOrEqualTo(0).WithMessage(_localizer["ValidationForRequired"]);

        RuleFor(x => x.RedirectLink)
            .NotEmpty().WithMessage(_localizer["ValidationForRequired"]);

        RuleFor(x => x.BoxCount)
            .NotEmpty().WithMessage(_localizer["ValidationForRequired"])
            .GreaterThan(0).WithMessage(_localizer["ValidationForRequired"]);

        RuleFor(x => x.SelectedTagIDs)
            .NotNull().WithMessage(_localizer["ValidationForRequired"])
            .Must(tags => tags != null && tags.Any())
            .WithMessage(_localizer["ValidationForRequired"]);

        RuleFor(x => x.SourceIDs)
          .NotNull().WithMessage(_localizer["ValidationForRequired"])
          .Must(source => source != null && source.Any())
          .WithMessage(_localizer["ValidationForRequired"]);

        RuleFor(x => x.AuthorID)
            .NotNull().WithMessage(_localizer["ValidationForRequired"])
            .GreaterThan(0).WithMessage(_localizer["ValidationForRequired"]);  
        
        // RuleFor(x => x.Video)
        //     .NotEmpty().WithMessage(_localizer["ValidationForRequired"])
        //     .MaximumLength(250).WithMessage(_localizer["ValidationForMaxLength"]);

        RuleFor(x => x.PressNo)
            .NotEmpty().WithMessage(_localizer["ValidationForRequired"])
            .MaximumLength(30).WithMessage(_localizer["ValidationForMaxLength"]);

        RuleFor(x => x.Headline)
            .NotEmpty().WithMessage(_localizer["ValidationForRequired"])
            .MaximumLength(500).WithMessage(_localizer["ValidationForMaxLength"]);

    }
}