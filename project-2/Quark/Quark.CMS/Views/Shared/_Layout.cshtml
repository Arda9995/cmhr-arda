<!DOCTYPE html>
<html lang="tr">
<head>
    <title>@ViewData[ViewDataNames.Title] | @_appSettings.Common_AppName</title>
    <meta charset="utf-8"/>
    <meta name="description" content="@_appSettings.Common_AppName"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="shortcut icon" href="/img/favicon.svg"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700"/>
    <link href="@_appSettings.CDN_AssetsFolderFullUrl/assets/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" type="text/css"/>
    <link href="@_appSettings.CDN_AssetsFolderFullUrl/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css"/>
    <link href="@_appSettings.CDN_AssetsFolderFullUrl/assets/css/style.bundle.css" rel="stylesheet" type="text/css"/>

    <link href="/css/custom.css" rel="stylesheet" type="text/css" asp-append-version="true"/>
</head>
<body data-kt-name="metronic" id="kt_app_body" data-kt-app-page-loading-enabled="true" data-kt-app-layout="dark-sidebar" data-kt-app-header-fixed="true" data-kt-app-sidebar-enabled="true" data-kt-app-sidebar-fixed="true" data-kt-app-sidebar-hoverable="true" data-kt-app-sidebar-push-header="true" data-kt-app-sidebar-push-toolbar="true" data-kt-app-sidebar-push-footer="true" class="app-default">
<script>
        var defaultThemeMode = "light";
        var themeMode;
        if (document.documentElement) {
            if (document.documentElement.hasAttribute("data-theme-mode")) {
                themeMode = document.documentElement.getAttribute("data-theme-mode");
            } else {
                if (localStorage.getItem("data-theme") !== null) {
                    themeMode = localStorage.getItem("data-theme");
                } else {
                    themeMode = defaultThemeMode;
                }
            }
            if (themeMode === "system") {
                themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.setAttribute("data-theme", themeMode);
        }
        var timeoutLimit = @_appSettings.Timeout_Time * 60000;
    </script>
<div class="app-page-loader">
    <span class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Yükleniyor</span>
    </span>
</div>
<div class="d-flex flex-column flex-root app-root" id="kt_app_root">
    <div class="app-page flex-column flex-column-fluid" id="kt_app_page">
        <partial name="_Header"/>
        <div class="app-wrapper flex-column flex-row-fluid" id="kt_app_wrapper">
            <partial name="_Sidebar"/>
            <div class="app-main flex-column flex-row-fluid" id="kt_app_main">
                <div class="d-flex flex-column flex-column-fluid">
                    <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
                        <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
                            @if (ViewData["ShowBackButton"] != null)
                            {
                                <partial name="_BackButton"/>
                            }
                            @* <partial name="_Breadcrumb"/> *@
                            <div class="d-flex align-items-center gap-2 gap-lg-3">
                                @await RenderSectionAsync("ToolBarLeft", required: false)
                            </div>
                            <div class="d-flex align-items-center gap-2 gap-lg-3">
                                @await RenderSectionAsync("ToolBarRight", required: false)
                            </div>
                        </div>
                    </div>
                    <div id="kt_app_content" class="app-content flex-column-fluid pt-0">
                        <div id="kt_app_content_container" class="app-container container-fluid">
                            <partial name="_MessageBox"/>
                            @RenderBody()
                        </div>
                    </div>
                </div>
                <partial name="_Footer"/>
            </div>
        </div>
    </div>
</div>
<div id="kt_scrolltop" class="scrolltop" data-kt-scrolltop="true">
    <i class="ki-duotone ki-arrow-up">
        <span class="path1"></span>
        <span class="path2"></span>
    </i>
</div>
@if (int.Parse(_localizer["Current_Language_ID"]) == (int)LanguageEnum.Turkish)
{
    <script src="/localization/tr.js" asp-append-version="true"></script>
    <script>var datatablesLanguageFile = "https://quark.avvamobile.com/js/datatables.turkish.json";</script>
}
else if (int.Parse(_localizer["Current_Language_ID"]) == (int)LanguageEnum.English)
{
    <script src="/localization/en.js" asp-append-version="true"></script>
    <script>var datatablesLanguageFile = "https://quark.avvamobile.com/js/datatables.turkish.json";</script>
}

<script src="@_appSettings.CDN_AssetsFolderFullUrl/assets/plugins/global/plugins.bundle.js"></script>
<script src="@_appSettings.CDN_AssetsFolderFullUrl/assets/js/scripts.bundle.js"></script>
<script src="@_appSettings.CDN_AssetsFolderFullUrl/assets/plugins/custom/datatables/datatables.bundle.js"></script>
<script src="https://quark.avvamobile.com/js/jquery.validate.min.js"></script>
<script src="https://quark.avvamobile.com/js/jquery.validate.unobtrusive.min.js"></script>
    
<script src="https://quark.b-cdn.net/js/flatpicker/tr.js"></script>
<script src="https://quark.avvamobile.com/js/select2/tr.js"></script>
@* <script src="https://quark.avvamobile.com/js/Quark.js" asp-append-version="true"></script> *@
<script src="/Common.js" asp-append-version="true"></script>
<script src="/Quark.js" asp-append-version="true"></script>
<script src="/Timeout.js" asp-append-version="true"></script>
 <script src="@_appSettings.CDN_BaseUrl/js/datatable.js" asp-append-version="true"></script> 
@* <script src="/datatable.js"></script> *@

<script>
    $(document).ready(function () {
        $("#menu" + "@ViewData[ViewDataNames.AsideMenu]").addClass("active");
        $("#menu" + "@ViewData[ViewDataNames.AsideMenu]").addClass("here show");
        $("#submenu" + "@ViewData[ViewDataNames.AsideSubMenu]").addClass("active");
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
@await RenderSectionAsync("Styles", required: false)
</body>

</html>
