    INSERT INTO [dbo].[News.NewsPhotoTypes] (
        [ID],
        [Key],
        [Name],
        [Description],
        [Width],
        [Height],
        [IsEnabled],
        [IsRequired],
        [Order]
    )
    VALUES (
        10,
        'GoogleAiHighResPhoto',
        N'Google AI Yüksek Çözünürlüklü Görsel',
        N'Google AI Feed için yüksek çözünürlüklü görsel. Minimum 1600x1200, maksimum 3200x3200.',
        1600,
        1200,
        1,
        0,
        50
    );

    SET IDENTITY_INSERT [dbo].[News.NewsPhotoTypes] OFF;
