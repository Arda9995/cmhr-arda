				</div>
			</nav>
		</div> <!-- Share Area End --> <!-- Date Start -->
		<div class="font-helvetica">Yayınlanma @Model.CreatedDate.ToString()</div> <!-- Date End  -->
	</div>
	<div property="ilanBody" class="bik-metni" style="font-family: Arial; font-size:16px !important; text-align:justify;" data-content-news-id="@Model.ID">
		
		@Html.Raw(Model.Content)
		
	</div>
	<div class="font-bold text-end text-slate-900 text-sm mt-5"> #ilangovtr BASIN NO: @Model.PressNo </div>
</div>