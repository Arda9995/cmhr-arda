@{
    Layout = "_LayoutPublic";
    ViewData[ViewDataNames.Title] = "Şifremi Unuttum";
}

@model Quark.CMS.Business.Models.Requests.AccountRequests.ForgotPasswordRequest

<div class="d-flex flex-column flex-lg-row flex-column-fluid">
    <a class="d-block d-lg-none mx-auto py-20">
        <img alt="Logo" src="/img/logo.svg" class="theme-light-show h-25px"/>
        <img alt="Logo" src="/img/logo-white.svg" class="theme-dark-show h-25px"/>
    </a>
    <div class="d-flex flex-column flex-column-fluid flex-center w-lg-50 p-10">
        <div class="d-flex justify-content-between flex-column-fluid flex-column w-100 mw-450px">
            <div class="d-flex flex-stack py-2">
                <div class="me-2">
                    <a href="/Account/SignIn" class="btn btn-icon bg-light rounded-circle">
                        <span class="svg-icon svg-icon-2 svg-icon-gray-800">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M9.60001 11H21C21.6 11 22 11.4 22 12C22 12.6 21.6 13 21 13H9.60001V11Z" fill="currentColor"></path>
                                <path opacity="0.3" d="M9.6 20V4L2.3 11.3C1.9 11.7 1.9 12.3 2.3 12.7L9.6 20Z" fill="currentColor"></path>
                            </svg>
                        </span>
                    </a>
                </div>
                <div class="m-0">
                    <span class="text-gray-400 fw-bold fs-5 me-2">Giriş yapmak mı istiyorsunuz?</span>
                    <a href="/Account/SignIn" class="link-primary fw-bold fs-5">Giriş Yap</a>
                </div>
            </div>
            <div class="py-20">
                <form class="form w-100" method="post">
                    <div class="card-body">
                        <div class="text-start mb-10">
                            <h1 class="text-dark mb-3 fs-3x">Şifremi Unuttum</h1>
                            <div class="text-gray-400 fw-semibold fs-6">
                                Şifrenizin sıfırlanması için lütfen aşağıdaki alana hesap bilgilerinizi giriniz.
                            </div>
                        </div>
                        <partial name="_MessageBox"/>
                        <div class="fv-row mb-8">
                            <input type="text" asp-for="Email" placeholder="E-Posta" class="form-control form-control-solid" autocomplete="off"/>
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Email"></span>
                        </div>
                        <div class="d-flex flex-stack">
                            <div class="m-0">
                                <button type="submit" class="btn btn-primary me-2 flex-shrink-0">Gönder</button>
                                <a href="/Account/SignIn" class="btn btn-lg btn-light-primary fw-bold">Vazgeç</a>
                            </div>

                        </div>
                    </div>
                </form>
            </div>
            <div class="m-0"></div>
        </div>
    </div>
    <div class="d-none d-lg-flex flex-lg-row-fluid w-50 bgi-size-cover bgi-position-y-center bgi-position-x-start bgi-no-repeat" style="background-image: url('https://quark.avvamobile.com/img/bg/bg11.png')"></div>
</div>