        private string SerializeXml(XDocument doc)
        {
            using var ms = new MemoryStream();
            using (var writer = XmlWriter.Create(ms, _xmlSettings))
            {
                doc.Save(writer);
            }

            return Encoding.UTF8.GetString(ms.ToArray());
        }

        private string FormatRfc822Date(DateTime? date)
        {
            if (!date.HasValue)
                return string.Empty;

            var offset = TimeZoneInfo.Local.GetUtcOffset(date.Value);
            var sign = offset.Hours >= 0 ? "+" : "-";
            var hours = Math.Abs(offset.Hours).ToString("00");
            var minutes = Math.Abs(offset.Minutes).ToString("00");

            return date.Value.ToString($"ddd, dd MMM yyyy HH:mm:ss {sign}{hours}{minutes}",
                CultureInfo.InvariantCulture);
        }

        public static string ConvertToIso8601WithOffset(DateTime dateTime)
        {
            var offset = TimeSpan.FromHours(3); // UTC+3
            var dateTimeOffset = new DateTimeOffset(dateTime, offset);
            return dateTimeOffset.ToString("yyyy-MM-ddTHH:mm:sszzz");
        }

        private async Task<string> GetOrRefreshXmlAsync(string documentId, string indexName,
            Func<Task<ServiceResult>> refresh)
        {
            var cachedContent = await _elasticSearchService.GetDocumentAsync<SitemapRssCachingResponse>(
                documentId, indexName);

            if (cachedContent != null && !string.IsNullOrEmpty(cachedContent.Content))
            {
                return cachedContent.Content;
            }

            await refresh();
            cachedContent = await _elasticSearchService.GetDocumentAsync<SitemapRssCachingResponse>(
                documentId, indexName);

            return cachedContent?.Content ?? string.Empty;
        }

        private Task<bool> CacheXmlAsync(XDocument xml, string documentId, string key, string indexName)
        {
            var document = new SitemapRssCachingResponse
            {
                ID = documentId,
                Key = key,
                Content = SerializeXml(xml)
            };
            return _elasticSearchService.UpdateDocumentAsync(document, documentId, indexName);
        }

        private XDocument CreateRssDocument(string title, string link, string description, string language,
            string selfUrl, DateTime lastBuildDate, DateTime publicationDate)
        {
            return new XDocument(
                new XDeclaration("1.0", "utf-8", null),
                new XElement("rss",
                    new XAttribute("version", "2.0"),
                    new XAttribute(XNamespace.Xmlns + "content", ContentNamespace.NamespaceName),
                    new XAttribute(XNamespace.Xmlns + "media", MediaNamespace.NamespaceName),
                    new XAttribute(XNamespace.Xmlns + "atom", AtomNamespace.NamespaceName),
                    new XAttribute(XNamespace.Xmlns + "dc", DcNamespace.NamespaceName),
                    new XElement("channel",
                        new XElement("title", title),
                        new XElement("link", link),
                        new XElement("description", description),
                        new XElement("language", language),
                        new XElement("category", "News"),
                        new XElement("lastBuildDate", FormatRfc822Date(lastBuildDate)),
                        new XElement("pubDate", FormatRfc822Date(publicationDate)),
                        new XElement("copyright", "Cumhuriyet Gazetesi"),
                        new XElement("ttl", "60"),
                        new XElement("image",
                            new XElement("url", "https://media.cumhuriyet.com.tr/cumhuriyet-amp-logo.png"),
                            new XElement("title", title),
                            new XElement("link", link),
                            new XElement("width", "144"),
                            new XElement("height", "60")),
                        new XElement(AtomNamespace + "link",
                            new XAttribute("href", selfUrl),
                            new XAttribute("rel", "self"),
                            new XAttribute("type", "application/rss+xml")))));
        }

        private XElement CreateRssItem(string title, string link, string guid, DateTime publishedDate,
            string imageUrl, string imageHeight, string imageWidth, params object[] content)
        {
            return new XElement("item",
                new XElement("title", title),
                new XElement("link", link),
                new XElement("enclosure",
                    new XAttribute("url", $"{imageUrl}"),
                    new XAttribute("length", "50000"),
                    new XAttribute("type", "image/jpeg")),
                new XElement(MediaNamespace + "content",
                    new XAttribute("url", $"{imageUrl}"),
                    new XAttribute("type", "image/jpeg"),
                    new XAttribute("height", imageHeight),
                    new XAttribute("width", imageWidth),
                    new XAttribute("expression", "full")),
                new XElement("guid", new XAttribute("isPermaLink", "false"), guid),
                new XElement("pubDate", FormatRfc822Date(publishedDate)),
                content);
        }

