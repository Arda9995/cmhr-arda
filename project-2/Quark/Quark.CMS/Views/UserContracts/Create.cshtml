@{
ViewData[ViewDataNames.Title] = _localizer["New"] + " " + _localizer["UserContract"];
ViewData[ViewDataNames.AsideMenu] = "Management";
ViewData[ViewDataNames.AsideSubMenu] = "UserContractManagement";
ViewData["ShowBackButton"] = true;
ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
{
new BreadcrumbItem(_localizer["Management"], string.Empty),
new BreadcrumbItem(_localizer["UserContractManagement"], "/UserContracts/List")
};
}

@model Quark.CMS.Business.Models.Requests.UserContractRequests.CreateUserContractRequest

@section Scripts{
<partial name="_CKEditorScripts"/>
<script src="/Scripts/UserContracts/Create.js" asp-append-version="true"></script>
}

<div class="card mb-5 mb-xl-10 col-12">
    <div class="card-header border-0">
        <div class="card-title m-0">
            <h3 class="fw-bolder m-0">@_localizer["UserContract"] @_localizer["Informations"]</h3>
        </div>
    </div>
    <form class="form" method="post" enctype="multipart/form-data">
        <div class="card-body border-top p-9">
            <div class="row mb-8">
                <label class="col-lg-2 col-form-label fw-bold fs-6 required">@_localizer["Title2"]</label>
                <div class="col-lg-10">
                    <input type="text" asp-for="Title" class="form-control maxlength" maxlength="100"/>
                    <span asp-validation-for="@Model.Title" class="fv-plugins-message-container invalid-feedback"></span>
                    <span class="fv-plugins-message-container invalid-feedback"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-2 col-form-label fw-bold fs-6 required">@_localizer["Content"]</label>
                <div class="col-lg-10">
                    <textarea type="text" asp-for="Content" id="summernote" class="form-control"></textarea>
                    <span asp-validation-for="@Model.Content" class="fv-plugins-message-container invalid-feedback"></span>
                    <span class="fv-plugins-message-container invalid-feedback"></span>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end py-6 px-9">
            <button type="submit" class="btn btn-primary me-2">@_localizer["Save"]</button>
            <a href="/UserContracts/List" class="btn btn-light btn-light-primary">@_localizer["Cancel"]</a>
        </div>
    </form>
</div>