@{
    ViewData[ViewDataNames.Title] = _localizer["Caricaturist"] + " " + _localizer["Update"];
    ViewData[ViewDataNames.AsideMenu] = "Content";
    ViewData[ViewDataNames.AsideSubMenu] = "Caricaturists";
    ViewData["ShowBackButton"] = true;
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Content"], string.Empty),
        new BreadcrumbItem(_localizer["Caricaturists"], "/Caricaturists/List")
    };
}

@model Quark.CMS.Business.Models.Requests.CaricaturistRequests.UpdateCaricaturistRequest

<div class="card mb-5 mb-xl-10 col-12">
    <div class="card-header border-0">
        <div class="card-title m-0">
            <h3 class="fw-bolder m-0">@_localizer["Caricaturist"] @_localizer["Informations"]</h3>
        </div>
    </div>
    <form class="form" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ID"/>
        <div class="card-body border-top p-9">
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6 required">@_localizer["Caricaturist"]</label>
                <div class="col-lg-9">
                    <input type="text" asp-for="Name" class="form-control form-control-lg form-control-solid"/>
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Name"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6 required">@_localizer["Headline"]</label>
                <div class="col-lg-9">
                    <input type="text" asp-for="Headline" class="form-control form-control-lg form-control-solid"/>
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Headline"></span>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end py-6 px-9">
            <button type="submit" class="btn btn-primary me-2">@_localizer["Save"]</button>
            <a href="/Caricaturists/Details/@Model.ID" class="btn btn-light btn-light-primary">@_localizer["Cancel"]</a>
        </div>
    </form>
</div>