                var rss = CreateRssDocument($"Cumhuriyet Gazetesi - {categoryEntity.Name}",
                    $"{_siteUrl.TrimEnd('/')}/{categoryEntity.Url.TrimStart('/')}", "Cumhuriyet Gazetesi", "tr-TR",
                    $"{_siteUrl.TrimEnd('/')}/rss/{categoryEntity.Url.TrimStart('/')}", DateTime.Now, DateTime.Now);

                foreach (var item in news)
                {
                    rss.Root.Element("channel").Add(
                        CreateRssItem(item.Title, $"{_siteUrl.TrimEnd('/')}/{item.Slug}",
                            $"{_siteUrl.TrimEnd('/')}/{item.Slug.TrimStart('/')}",
                            item.PublishedDate, item.ImageURL, "720", "1280",
