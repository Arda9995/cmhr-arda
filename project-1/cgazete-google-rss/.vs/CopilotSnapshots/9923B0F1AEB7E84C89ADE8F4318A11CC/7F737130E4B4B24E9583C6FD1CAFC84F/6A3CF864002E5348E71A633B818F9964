                    {
                        changefreq = "daily";
                        priority = "0.8";
                    }
                    else if (daysDiff <= 30)
                    {
                        changefreq = "weekly";
                        priority = "0.7";
                    }
                    else if (daysDiff <= 365)
                    {
                        changefreq = "monthly";
                        priority = "0.6";
                    }
                    else
                    {
                        changefreq = "yearly";
                        priority = "0.5";
                    }

                    return new
                    {
                        LastMod = ConvertToIso8601WithOffset((DateTime)lastMod),
                        ChangeFreq = changefreq,
                        Priority = priority,
                        Slug = item.Slug
                    };
                }).ToList();

                var sitemapNs = XNamespace.Get("http://www.sitemaps.org/schemas/sitemap/0.9");

                var sitemap = new XDocument(
