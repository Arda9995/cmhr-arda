@{
	Layout = "_LayoutNoAds";
}

@model Quark.API.Business.Models.Responses.AccountResponses.GetMembershipIntroductionResponse

<head>
	<meta name="description" content="Size özel hazırlanmış Reklamsız Cumhuriyet paketlerini keşfedin">
	<title>Hoş Geldiniz - Reklamsız Cumhuriyet</title><!-- Plugins -->
</head>

<partial name="_Header"/>
@{
	var username = Context.User.Identity?.Name;
	var isAuthenticated = Context.User.Identity?.IsAuthenticated ?? false;
	var hrefLink = isAuthenticated ? "/uye/hesap-bilgileri" : "/uye/kayit-ol";
}

<main id="main" class="my-4 px-5 tablet:px-0">
	<div class="max-w-container mx-auto space-y-6 max-w-none">
		<main class="max-w-5xl mx-auto px-4 py-12 w-full font-helvetica"> <!-- Welcome Section -->
			<div class="text-center mb-16">
				<h1 class="text-3xl md:text-4xl font-bold mb-4">
					Hoş Geldiniz
				</h1>
				<p class="text-gray-600 text-lg max-w-2xl mx-auto"> Reklamsız Cumhuriyet'e adım attın! Şimdi üye olarak kaliteli ve reklamsız içeriklerin keyfini çıkarın. </p>
			</div> <!-- Plans Grid -->
			<div class="flex items-center justify-center gap-8 max-w-4xl mx-auto"> <!-- Monthly Plan -->
				<div
					class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 overflow-hidden border border-gray-100 relative">
					<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500 to-red-600"></div>
					<div class="p-8">
						<div class="flex items-center justify-between mb-6">
							<h3 class="text-xl font-bold">Aylık Plan</h3> <span
								class="bg-red-50 text-red-600 px-3 py-1 rounded-full text-sm font-medium">En Popüler</span>
						</div>
						<div class="mb-8">
							<div class="flex items-baseline">
								<span class="font-bold">100₺ yerine </span><span class="text-5xl font-bold">@Model.PlanPrice</span> <span class="text-2xl font-medium ml-1">₺</span> <span class="text-gray-500 ml-2 text-lg">/ @Model.PlanType</span>
							</div>
							<p class="text-sm text-gray-500 mt-2">Her ay yenilenir, dilediğiniz zaman iptal
								edebilirsiniz.</p>
						</div>
						<ul class="space-y-4 mb-8">
							<li class="flex items-center text-gray-700">
								<svg class="w-5 h-5 text-green-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor"
								     viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
									      d="M5 13l4 4L19 7"></path>
								</svg>
								<span>Reklamsız okuma deneyimi</span></li>
							<li class="flex items-center text-gray-700">
								<svg class="w-5 h-5 text-green-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor"
								     viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
									      d="M5 13l4 4L19 7"></path>
								</svg>
								<span>Mobil uygulamada premium deneyim</span></li>
							<li class="flex items-center text-gray-700">
								<svg class="w-5 h-5 text-green-500 mr-3 flex-shrink-0" fill="none" stroke="currentColor"
								     viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
									      d="M5 13l4 4L19 7"></path>
								</svg>
								<span>İstediğiniz zaman iptal etme</span></li>
						</ul>

						<a href="@hrefLink"
						   class="w-full bg-red-600 text-white py-4 rounded-xl font-medium hover:bg-red-700 transition-colors text-lg relative overflow-hidden group block text-center">
							<span class="relative z-10">HEMEN BAŞLA</span>
							<div class="absolute inset-0 bg-gradient-to-r from-red-500 to-red-600 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></div>
						</a>


					</div>
				</div>
			</div> <!-- Features Section -->
			<div class="mt-20">
				<h2 class="text-2xl font-bold text-center mb-12">Neden Reklamsız Cumhuriyet?</h2>
				<div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
					<div class="text-center group">
						<div
							class="bg-red-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 transition-transform transform group-hover:scale-110">
							<svg class="w-8 h-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
								      d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path>
							</svg>
						</div>
						<h3 class="text-lg font-semibold mb-2">Reklamsız Deneyim</h3>
						<p class="text-gray-600">Hiçbir reklam olmadan, kesintisiz okuma deneyimi</p>
					</div>
					<div class="text-center group">
						<div
							class="bg-red-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 transition-transform transform group-hover:scale-110">
							<svg class="w-8 h-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
								      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
							</svg>
						</div>
						<h3 class="text-lg font-semibold mb-2">Güvenli Ödeme</h3>
						<p class="text-gray-600">256-bit SSL sertifikası ile güvenli ödeme</p>
					</div>
				</div>
			</div> <!-- FAQ Section -->
			<div class="mt-20 max-w-3xl mx-auto">
				<h2 class="text-2xl font-bold text-center mb-8">Sıkça Sorulan Sorular</h2>
				<div class="space-y-4">
					<div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow">
						<h3 class="font-semibold mb-2">Aboneliğimi nasıl iptal edebilirim?</h3>
						<p class="text-gray-600">Aboneliğinizi dilediğiniz zaman hesap ayarlarınızdan kolayca iptal
							edebilirsiniz. İptal işlemi anında gerçekleşir.</p>
					</div>
					<div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow">
						<h3 class="font-semibold mb-2">Hangi ödeme yöntemlerini kullanabilirim?</h3>
						<p class="text-gray-600">Kredi kartı ile ödeme yapabilirsiniz. Tüm
							ödemeleriniz 256-bit SSL sertifikası ile güvence altındadır.</p>
					</div>
					<div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow">
						<h3 class="font-semibold mb-2">Reklamsız Cumhuriyet üyeliğim ne zaman başlayacak?</h3>
						<p class="text-gray-600">Ödemeniz onaylandıktan hemen sonra Reklamsız Cumhuriyet üyeliğiniz aktif olur ve tüm
							premium özelliklere anında erişim sağlarsınız.</p>
					</div>
				</div>
			</div>
		</main>
	</div>
</main>

