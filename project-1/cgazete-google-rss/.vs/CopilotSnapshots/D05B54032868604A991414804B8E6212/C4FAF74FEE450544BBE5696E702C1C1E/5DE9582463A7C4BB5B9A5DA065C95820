                            Name = x.Name,
                            Slug = _appSettingsKeys.Common_ClientWebSite + _appSettingsKeys.SlugPrefix_Sources + "/" +
                                   x.Url.TrimStart('/')
                        }).ToListAsync();
                }

                news.Sources = string.Join(", ", news.SourceList.Select(x => x.Name));
