            #region İlişkili Haberler

            if (procedureModel.Data.RelatedNewsIDsList != null)
            {
                var idList = procedureModel.Data.RelatedNewsIDsList.Split(",").Select(int.Parse).ToList();

                news.RelatedNewsList = await (from np in _context.NewsPublished
