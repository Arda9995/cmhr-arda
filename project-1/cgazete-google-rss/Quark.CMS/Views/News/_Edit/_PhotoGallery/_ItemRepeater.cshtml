@model Quark.CMS.Business.Models.Requests.NewsRequests.NewsRequest

<div id="gallery_items">
    <div class="form-group">
        <div data-repeater-list="PhotoGalleryItems">
            <div data-repeater-item>
                <div class="card card-flush mb-10">
                    <div class="card-header">
                        <div class="card-title">
                            <h2> @_localizer["PhotoGalleryItemInformation"]</h2>
                        </div>
                        <div class="form-group mt-5">
                            <a class="btn btn-light-danger btn-sm" data-repeater-delete>
                                <partial name="Icons/Delete"/>
                            </a>
                        </div>
                    </div>
                    <div class="card-body pt-0 form-group row repeaterElement">
                        <div class="row pb-5">
                            <div class="mb-10 fv-row">
                                <label class="form-label">@_localizer["Subtitle"]</label>
                                <input type="text" name="Subtitle" class="form-control maxlength" maxlength="1000"/>
                            </div>
                            <div class="text-muted fs-7">@_localizer["NewsSubtitleText"]</div>
                            <div class="mb-10 fv-row">
                                <label class="required form-label">@_localizer["Content"]</label>
                                <input type="text" name="Content" class="form-control @_appSettings.Text_Editor summernote"/>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex flex-row">
        <div class="form-group">
            <button type="button" data-repeater-create class="btn btn-primary">
                <i class="ki-duotone ki-plus fs-2"></i> @_localizer["New"] @_localizer["PhotoGalleryItem"]
            </button>
        </div>
    </div>
</div>