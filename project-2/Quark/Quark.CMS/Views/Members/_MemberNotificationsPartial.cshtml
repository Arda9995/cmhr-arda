<div class="card">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
            <h2>@_localizer["Notifications"]</h2>
        </div>
        <div class="card-toolbar">
            <div class="d-flex justify-content-end" data-kt-user-table-toolbar="base">
               
            </div>
        </div>
    </div>
    <div class="card-body py-4">
        <table id="memberNotificationsDatatable" class="table align-middle table-row-dashed fs-6 gy-3">
            <thead>
                <tr class="text-start text-gray-400 fw-bolder fs-7 gs-0">
                    <th>@_localizer["CreatedDate"]</th>
                    <th>@_localizer["Sender"]</th>
                    <th>@_localizer["Title2"]</th>
                    <th>@_localizer["Content"]</th>
                    <th>@_localizer["Image"]</th>
                    <th class="text-center">@_localizer["IsRead"]</th>
                </tr>
            </thead>
            <tbody class="fw-bolder text-gray-600">
                <div style="display:none">
                    <div id="Col81">
                        {0}
                    </div>
                    <div id="Col82">
                        {0}
                    </div>
                    <div id="Col83">
                        {0}
                    </div>
                    <div id="Col84">
                        {0}
                    </div>
                    <div id="Col85">
                        <img src="{0}" class="w-150px" /> 
                    </div>
                    <div id="Col86">
                        <span class="badge badge-light-{0}">{1}</span>
                    </div>
                </div>
            </tbody>
        </table>
    </div>
</div>