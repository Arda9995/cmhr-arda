@using Microsoft.IdentityModel.Tokens
@model Quark.CMS.Business.Models.Responses.NewsResponses.NewsVersionLiveResponse

@if (!Model.Description.IsNullOrEmtpy())
{
    <div class="card card-flush mb-10 shadow">
        <div class="card-header">
            <div class="card-title">
                <h2>@_localizer["UnpublishDescription"]</h2>
            </div>
        </div>
        <div class="card-body m-5">
            <h1 class="fw-bold mb-5">@Model.Description</h1>
        </div>
    </div>
}
