    public async Task<ServiceResult> RefreshMainPageGovernmentAnnouncement()
    {
        var result = new ServiceResult();
        var governmentAnnouncementList = await (
            from np in _context.NewsPublished
            let photo = (from ph in _context.NewsPhotos
                where ph.NewsID == np.NewsID &&
                      (ph.PhotoTypeID == (int)NewsPhotoTypesEnum.MainPhoto ||
                       ph.PhotoTypeID == (int)NewsPhotoTypesEnum.CoverPhoto)
                orderby
                    ph.PhotoTypeID == (int)NewsPhotoTypesEnum.MainPhoto && !string.IsNullOrEmpty(ph.PhotoUrl) ? 0 :
                        ph.PhotoTypeID == (int)NewsPhotoTypesEnum.CoverPhoto && !string.IsNullOrEmpty(ph.PhotoUrl) ? 1 :
                        2
                select ph).FirstOrDefault()
            where np.NewsTypeID == (int)NewsTypesEnum.GovernmentAnnouncement &&
                  np.PublishedDate.Date == DateTime.Today.Date
            select new GovernmentAnnouncementItem
            {
                ID = (int)np.NewsID,
                Headline = np.Headline ?? np.Title,
                UpSubtitle = np.UpSubtitle ?? np.Subtitle ?? np.Content.ExtractTextFromHtml(),
                Slug = _appSettingsKeys.Common_ClientWebSite + np.Slug.TrimStart('/'),
                CoverPhoto = photo.PhotoUrl.PrepareCDNUrl(_appSettingsKeys.CDN_BaseUrl,
                    _appSettingsKeys.CDN_MediaGalleryFolder),
                BoxCount = np.BoxCount ?? 0,
                PressNo = np.PressNo,
                OrderGroup = np.BoxCount >= 150 ? (int)GovernmentOrderGroupEnum.UnderAnaSlider : 0
            }).ToListAsync();

        var counter = 1;
        foreach (var item in governmentAnnouncementList.Where(x =>
                     x.OrderGroup != (int)GovernmentOrderGroupEnum.UnderAnaSlider))
        {
            item.OrderGroup = (int)Math.Ceiling((counter / 4.0)) + 1;
            if (item.OrderGroup == (int)GovernmentOrderGroupEnum.Remaining)
                continue;
            counter++;
        }

        var serializedData = JsonConvert.SerializeObject(governmentAnnouncementList);
        await _cache.Set(RedisKeys.DailyGovernmentAnnouncement, serializedData,
            RedisTTLSeconds.MainPageGovernmentAnnouncement_TTL);
        return result;
    }

    public async Task<ServiceResult> IncreaseSurveyResult(int surveyID, int optionID)
    {
        var result = new ServiceResult();

        var surveyOptions = await _context.SurveyOptions.Where(x => x.SurveyID == surveyID).Select(x =>
            new SurveyOptionsResult
            {
                OptionID = x.ID,
                OptionName = x.Option,
                AnswerCount = x.AnswerCount
            }).ToListAsync();

        var increasedSurveyOption = surveyOptions.FirstOrDefault(x => x.OptionID == optionID);
        increasedSurveyOption.AnswerCount += 1;

        var surveyOptionResultCachingResponse = new SurveyOptionResultCachingResponse()
        {
            SurveyID = surveyID,
            SurveyOptions = surveyOptions
        };
        var jsonData = JsonConvert.SerializeObject(surveyOptionResultCachingResponse);
        await _cache.Set(string.Format(RedisKeys.SurveyResult, surveyID), jsonData, TimeSpan.FromSeconds(180));
        return result;
    }

    public async Task<ServiceResult> RefreshSurveyResult(int surveyID)
    {
        var result = new ServiceResult();

        var surveyOptionList = await _context.SurveyOptions.Where(x => x.SurveyID == surveyID).ToListAsync();
        var totalAnswers = surveyOptionList.Sum(y => y.AnswerCount);

        var surveyOptions = surveyOptionList.Select(x => new SurveyOptionsResult
        {
            OptionID = x.ID,
            OptionName = x.Option,
            AnswerCount = x.AnswerCount,
            PercentRatio = totalAnswers == 0 ? 0 : (int)Math.Round(((double)x.AnswerCount / totalAnswers) * 100)
        }).ToList();

        var surveyOptionResultCachingResponse = new SurveyOptionResultCachingResponse()
        {
            SurveyID = surveyID,
            SurveyOptions = surveyOptions
        };

        var jsonData = JsonConvert.SerializeObject(surveyOptionResultCachingResponse);
        await _cache.Set(string.Format(RedisKeys.SurveyResult, surveyID), jsonData, TimeSpan.FromSeconds(180));
        return result;
    }

    public async Task<ServiceResult<SurveyOptionResultCachingResponse>> GetSurveyOptionResult(int surveyID)
    {
        var result = new ServiceResult<SurveyOptionResultCachingResponse>();

        result.Data =
            await _cache.Get<SurveyOptionResultCachingResponse>(string.Format(RedisKeys.SurveyResult, surveyID));
        if (result.Data == null)
        {
            await RefreshSurveyResult(surveyID);
            return result;
        }

        result.Data =
            await _cache.Get<SurveyOptionResultCachingResponse>(string.Format(RedisKeys.SurveyResult, surveyID));
        return result;
    }

    public async Task<ServiceResult<List<int>>> GetNewsIdsByNewsType(int newsTypeID, int size = 10000)
    {
        var result = new ServiceResult<List<int>>();

        var getElasticSearchNewsResponse = await elasticSearchService
            .SearchDocumentsAsync<GetNewsPublishedCacheResponse>(
                IndexNames.News_Published_Search,
                q => q
                    .Bool(b => b
                        .Should(
                            s => s.Match(m => m
                                .Field(f => f.NewsTypeID)
                                .Query(newsTypeID.ToString())
                            ),
                            s => s.Range(x => x.DateRange(r => r.Field(f => f.PublishDate)
                                .Gte(DateTime.UtcNow.AddDays(-2))
                            ))
                        )
                        .MinimumShouldMatch(2)
                    ),
                sort => sort
                    .Field(f => f.PublishDate, field => field.Order(SortOrder.Desc)),
                size: size
            );

        if (getElasticSearchNewsResponse == null)
        {
            result.SetError("ElasticSearch'ten veri alınırken hata oluştu.");
            return result;
        }

        // get random max size
        var random = new Random();
        var maxSize = Math.Min(size, getElasticSearchNewsResponse.Count);

        var randomNewsIds = getElasticSearchNewsResponse
            .OrderBy(x => random.Next())
            .Take(maxSize)
            .Select(x => x.ID)
            .ToList();

        result.Data = randomNewsIds;
        return result;
    }

