@using Quark.CMS.Business.Models.Responses.CommonResponses
@using Quark.CMS.Business.Models.Responses.BlockResponses
@model PagingResponse<ListBlockNewsResponseItem>

<ul class="pagination pagination-circle pagination-outline">
    <li class="page-item first m-1 @(Model.HasPrevious ? "" : "disabled")">
        <button onclick="getNewsPaged(1, 10)" class="page-link px-0">
            <i class="ki-duotone ki-double-left fs-2"><span class="path1"></span><span class="path2"></span></i>
        </button>
    </li>
    <li class="page-item previous @(Model.HasPrevious ? "" : "disabled") m-1">
        <button onclick="getNewsPaged(@(Model.CurrentPage - 1), 10)" class="page-link px-0">
            <i class="ki-duotone ki-left fs-2"></i>
        </button>
    </li>

    @{
        int totalPages = Model.PageCount;
        int currentPage = Model.CurrentPage;
        int maxVisiblePages = 5;

        int startPage = Math.Max(1, currentPage - 2);
        int endPage = Math.Min(totalPages, startPage + maxVisiblePages - 1);

        if (endPage - startPage + 1 < maxVisiblePages)
        {
            startPage = Math.Max(1, endPage - maxVisiblePages + 1);
        }
    }

    @for (int i = startPage; i <= endPage; i++)
    {
        <li class="page-item m-1 @(i == currentPage ? "active" : "")">
            <button onclick="getNewsPaged(@i, 10)" class="page-link">@i</button>
        </li>
    }
    
    <li class="page-item next m-1 @(Model.HasNext ? "" : "disabled")">
        <button onclick="getNewsPaged(@(Model.CurrentPage + 1), 10)" class="page-link px-0">
            <i class="ki-duotone ki-right fs-2"></i>
        </button>
    </li>
    <li class="page-item last m-1 @(Model.HasNext ? "" : "disabled")">
        <button onclick="getNewsPaged(@(Model.PageCount), 10)" class="page-link px-0">
            <i class="ki-duotone ki-double-right fs-2"><span class="path1"></span><span class="path2"></span></i>
        </button>
    </li>
</ul>