@{
    Layout = "_LayoutPublic";
    ViewData[ViewDataNames.Title] = _localizer["SecureLogin"];
}
@model Quark.CMS.Business.Models.Requests.AccountRequests.LoginRequest

<div class="d-flex flex-column flex-lg-row flex-column-fluid">
    <a class="d-block d-lg-none mx-auto py-20">
        <img alt="Logo" src="/img/logo.svg" class="theme-light-show h-25px" />
        <img alt="Logo" src="/img/logo-white.svg" class="theme-dark-show h-25px" />
    </a>
    <div class="d-flex flex-column flex-column-fluid flex-center w-lg-50 p-10">
        <div class="d-flex justify-content-between flex-column-fluid flex-column w-100 mw-450px">
            <div class="d-flex flex-stack py-2">
                <div class="me-2"></div>
            </div>
            <div class="py-20">
                <form class="form w-100" method="post">
                    <div class="card-body">
                        <div class="text-start mb-10">
                            <h1 class="text-dark mb-3 fs-3x">@_localizer["SecureLogin"]</h1>
                            <div class="text-gray-400 fw-semibold fs-6">@_localizer["SecureLoginDescription"]</div>
                        </div>
                        <partial name="_MessageBox" />
                        <div class="fv-row mb-8">
                            <input type="text" asp-for="Email" placeholder="@_localizer["EMail"]" class="form-control form-control-solid" />
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Email"></span>
                        </div>
                        <div class="fv-row mb-7">
                            <input type="password" asp-for="Password" placeholder="@_localizer["Password"]" class="form-control form-control-solid" />
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Password"></span>
                        </div>
                        <div class="d-flex flex-stack flex-wrap gap-3 fs-base fw-semibold mb-10">
                            <div></div>
                            <a href="/Account/ForgotPassword" class="link-primary">@_localizer["ForgotPassword"]</a>
                        </div>
                        <div class="d-flex flex-stack">
                            <button type="submit" class="btn btn-primary me-2 flex-shrink-0">@_localizer["SignIn"]</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="m-0"></div>
        </div>
    </div>
    <div class="d-none d-lg-flex flex-lg-row-fluid w-50 bgi-size-cover bgi-position-y-center bgi-position-x-start bgi-no-repeat" style="background-image: url('https://quark.avvamobile.com/img/bg/bg11.png')"></div>
</div>