@{
    ViewData[ViewDataNames.Title] = _localizer["Users"] + " " + _localizer["Update"];
    ViewData[ViewDataNames.AsideMenu] = "Management";
    ViewData[ViewDataNames.AsideSubMenu] = "Users";
    ViewData["ShowBackButton"] = true;
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Management"], string.Empty),
        new BreadcrumbItem(_localizer["Users"], "/Users/List")
    };
}
@model Quark.CMS.Business.Models.Requests.UserRequests.UpdateRequest

<div class="card mb-5 mb-xl-10 col-8">
    <div class="card-header border-0">
        <div class="card-title m-0">
            <h3 class="fw-bolder m-0">@_localizer["User"] @_localizer["Informations"]</h3>
        </div>
    </div>
    <form class="form" method="post" enctype="multipart/form-data">
        <div class="card-body border-top p-9">
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label required fw-bold fs-6">@_localizer["ProfilePhoto"]</label>
                <div class="col-lg-8">
                    <div class="image-input image-input-outline" data-kt-image-input="true">
                        <div id="backgroundPhoto" class="image-input-wrapper w-125px h-125px bgi-position-center" style="background-size: 75%;
                            background-image: url('@(Model.ProfilePhotoUrl)')"></div>
                        <label class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow" data-kt-image-input-action="change" data-bs-toggle="tooltip" title="@_localizer["Update"]">
                            <i class="bi bi-pencil-fill fs-7"></i>
                            <input type="file" name="ProfilePhoto" accept=".png, .jpg, .jpeg" />
                            <input type="hidden" name="avatar_remove" />
                        </label>
                        <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow" data-kt-image-input-action="cancel" data-bs-toggle="tooltip" title="@_localizer["Cancel"]">
                            <i class="bi bi-x fs-2"></i>
                        </span>
                    </div>
                    <div class="form-text">@_localizer["UploadImageHelpText"]</div>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6 required">@_localizer["FullName"]</label>
                <div class="col-lg-8">
                    <div class="row">
                        <div class="col-lg-6 fv-row">
                            <input type="text" asp-for="Firstname" class="form-control form-control-lg form-control-solid" placeholder="@_localizer["Name"]" />
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Firstname"></span>
                        </div>
                        <div class="col-lg-6 fv-row">
                            <input type="text" asp-for="Lastname" class="form-control form-control-lg form-control-solid" placeholder="@_localizer["LastName"]" />
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Lastname"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6 required">@_localizer["EMail"]</label>
                <div class="col-lg-8 fv-row">
                    <input type="text" asp-for="Email" class="form-control form-control-lg form-control-solid emailaddress" placeholder="eposta@adresi.com" />
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Email"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6 required">@_localizer["Password"]</label>
                <div class="col-lg-8 fv-row">
                    <input type="text" asp-for="Password" class="form-control form-control-lg form-control-solid" />
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Password"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6 required">@_localizer["Phone"]</label>
                <div class="col-lg-8 fv-row">
                    <input type="tel" asp-for="MobilePhone" class="form-control form-control-lg form-control-solid phonenumber" />
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="MobilePhone"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6 required">@_localizer["Role"]</label>
                <div class="col-lg-8 fv-row">
                    <select asp-for="SelectedRoleID" asp-items="@Model.Roles" class="form-select form-select-lg form-select-solid" data-control="select2">
                    </select>
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="SelectedRoleID"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6 required">@_localizer["Categories"]</label>
                <div class="col-lg-8">
                    <select asp-items="@Model.Categories" asp-for="SelectedCategoryIds" class="form-select form-select-lg form-select-solid" data-control="select2" multiple="multiple" data-close-on-select="false"></select>
                    <div class="form-text">@_localizer["UserNewsCategoriesHintText"]</div>
                    <span asp-validation-for="@Model.SelectedCategoryIds" class="fv-plugins-message-container invalid-feedback"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6">@_localizer["Status"]</label>
                <div class="col-lg-8 fv-row">
                    <div class="form-check form-switch form-check-custom form-check-solid mt-2">
                        <input asp-for="IsEnabled" class="form-check-input" type="checkbox" />
                    </div>
                    <span class="fv-plugins-message-container invalid-feedback"></span>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end py-6 px-9">
            <button type="submit" class="btn btn-primary me-2">@_localizer["Save"]</button>
            <a href="/Users/List" class="btn btn-light btn-light-primary">@_localizer["Cancel"]</a>
        </div>
    </form>
</div>