        public async Task<ServiceResult> RefreshMonthlyPostsSitemap(int year, int month)
        {
            var result = new ServiceResult();
            try
            {
                var now = DateTime.UtcNow;

                var sitemapResults = (await _context.NewsPublished
                        .Where(n => n.AllowToSendGoogleSideMap && n.PublishedDate.Year == year &&
                                    n.PublishedDate.Month == month && n.ManuelUpdatedDate != null)
                        .OrderByDescending(n => n.PublishedDate)
                        .Select(n => new
                        {
                            n.PublishedDate,
                            n.ManuelUpdatedDate,
                            n.Slug,
                        })
                        .ToListAsync())
                    .Select(item =>
                    {
                        var lastMod = item.ManuelUpdatedDate < item.PublishedDate
                            ? item.PublishedDate
                            : item.ManuelUpdatedDate;
                        var daysDiff = (now - lastMod)?.TotalDays;
                        var hoursDiff = (now - lastMod)?.TotalHours;

                        string changefreq;
                        string priority;

                        if (hoursDiff <= 24)
                        {
                            changefreq = "always";
                            priority = "1.0";
                        }
                        else if (hoursDiff <= 48)
                        {
                            changefreq = "hourly";
                            priority = "0.9";
                        }
                        else if (daysDiff <= 7)
                        {
                            changefreq = "daily";
                            priority = "0.8";
                        }
                        else if (daysDiff <= 30)
                        {
                            changefreq = "weekly";
                            priority = "0.7";
                        }
                        else if (daysDiff <= 365)
                        {
                            changefreq = "monthly";
                            priority = "0.6";
                        }
                        else
                        {
                            changefreq = "yearly";
                            priority = "0.5";
                        }

                        return new
                        {
                            LastMod = ConvertToIso8601WithOffset((DateTime)lastMod),
                            ChangeFreq = changefreq,
                            Priority = priority,
                            Slug = item.Slug
                        };
                    })
                    .ToList();

                var sitemapNs = XNamespace.Get("http://www.sitemaps.org/schemas/sitemap/0.9");

                var sitemap = new XDocument(
                    new XDeclaration("1.0", "utf-8", null),
                    new XElement(sitemapNs + "urlset"));

                sitemapResults = sitemapResults.Where(x =>
                    x.ChangeFreq != null
                    && x.LastMod != null
                    && x.Priority != null
                    && x.Slug != null).ToList();

                foreach (var post in sitemapResults)
                {
                    sitemap.Root.Add(
                        new XElement(sitemapNs + "url",
                            new XElement(sitemapNs + "loc", $"{_siteUrl.TrimEnd('/')}/{post.Slug.TrimStart('/')}"),
                            new XElement(sitemapNs + "lastmod", post.LastMod),
                            new XElement(sitemapNs + "changefreq", post.ChangeFreq),
                            new XElement(sitemapNs + "priority", post.Priority)));
                }

                await CacheXmlAsync(sitemap, $"{year}-{month}",
                    ElasticSitemapKeys.MonthlyPostsSitemapKey(year, month), IndexNames.Monthly_Post_Sitemap);
            }
            catch (Exception ex)
            {
                result.Message = ex.Message;
            }

            return result;
        }

        public async Task<ServiceResult> RefreshMonthlyTagsSitemap(int year, int month)
        {
            var result = new ServiceResult();
            try
            {
                var now = DateTime.Now;

                var sitemapResults = (await (
                    from nt in _context.NewsTags
                    join t in _context.Tags on nt.TagID equals t.ID
                    join n in _context.NewsPublished on nt.NewsID equals n.NewsID
                    where t.CreatedDate.Value.Year == year && t.CreatedDate.Value.Month == month
                    group new { t, n } by new { t.ID, t.Url, t.CreatedDate.Value.Year, t.CreatedDate.Value.Month }
                    into t
                    orderby t.Key.Year descending, t.Key.Month descending
                    select new
                    {
                        Slug = t.Key.Url,
                        TagCreatedYear = t.Key.Year,
                        TagCreatedMonth = t.Key.Month,
                        LastModifiedDate = t.Max(item => item.n.ManuelUpdatedDate)
                    }).ToListAsync()).Select(item =>
                {
                    var lastMod = item.LastModifiedDate;
                    var daysDiff = (now - lastMod).Value.TotalDays;
                    var hoursDiff = (now - lastMod).Value.TotalHours;

                    string changefreq;
                    string priority;

                    if (hoursDiff <= 24)
                    {
                        changefreq = "always";
                        priority = "1.0";
                    }
                    else if (hoursDiff <= 48)
                    {
                        changefreq = "hourly";
                        priority = "0.9";
                    }
                    else if (daysDiff <= 7)
                    {
                        changefreq = "daily";
                        priority = "0.8";
                    }
                    else if (daysDiff <= 30)
                    {
                        changefreq = "weekly";
                        priority = "0.7";
                    }
                    else if (daysDiff <= 365)
                    {
                        changefreq = "monthly";
                        priority = "0.6";
                    }
                    else
                    {
                        changefreq = "yearly";
                        priority = "0.5";
                    }

                    return new
                    {
                        LastMod = ConvertToIso8601WithOffset((DateTime)lastMod),
                        ChangeFreq = changefreq,
                        Priority = priority,
                        Slug = item.Slug
                    };
                }).ToList();

                var sitemapNs = XNamespace.Get("http://www.sitemaps.org/schemas/sitemap/0.9");

                var sitemap = new XDocument(
                    new XDeclaration("1.0", "utf-8", null),
                    new XElement(sitemapNs + "urlset"));

                foreach (var tag in sitemapResults)
                {
                    sitemap.Root.Add(
                        new XElement(sitemapNs + "url",
                            new XElement(sitemapNs + "loc",
                                $"{_siteUrl.TrimEnd('/')}/{_appSettingsKeys.SlugPrefix_Tags}/{tag.Slug}"),
                            new XElement(sitemapNs + "lastmod", tag.LastMod),
                            new XElement(sitemapNs + "changefreq", tag.ChangeFreq),
                            new XElement(sitemapNs + "priority", tag.Priority)));
                }

                await CacheXmlAsync(sitemap, $"{year}-{month}",
                    ElasticSitemapKeys.MonthlyTagsSitemapKey(year, month), IndexNames.Monthly_Tag_Sitemap);
            }
            catch (Exception ex)
            {
                result.Message = ex.Message;
            }

            return result;
        }

