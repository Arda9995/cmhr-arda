@using Microsoft.IdentityModel.Tokens
@model Quark.CMS.Business.Models.Responses.NewsResponses.DetailsNewsResponse

@if (!Model.Video.IsNullOrEmtpy())
{
    <input type="hidden" id="videoPlayerID" value="@Model.VideoPlayerID"/>
    <input type="hidden" id="videoCode" value="@Model.Video"/>
    <div class="card card-flush mb-10">
        <div class="card-header">
            <div class="card-title">
                <h2>@(Model.VideoPlayerID == (int)VideoPlayerEnum.Youtube ? "YouTube" : "Dailymotion")</h2>
            </div>
        </div>
        <div class="card-body pt-0 text-center">
            <div class="row">
                @if (Model.VideoPlayerID == (int)VideoPlayerEnum.Youtube)
                {
                    <div style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden;">
                        <iframe 
                            src="https://www.youtube.com/embed/@(Model.Video)" 
                            title="YouTube video player" 
                            frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen 
                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
                        </iframe>
                    </div>

                }else if (Model.VideoPlayerID == (int)VideoPlayerEnum.Dailymotion)
                {
                    <script src="https://geo.dailymotion.com/libs/player/x7lpf.js"></script>
                    <div id="my-dailymotion-player"></div>
                }
            </div>
        </div>
    </div>
}
