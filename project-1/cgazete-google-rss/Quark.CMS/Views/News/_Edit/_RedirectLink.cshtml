@model Quark.CMS.Business.Models.Requests.NewsRequests.NewsRequest

<div class="mb-10 fv-row">
    <div class="col-12">
        <label class="required form-label">@_localizer["RedirectLink"]</label>
        <div class="input-group">
            <input asp-for="@Model.RedirectLink" type="text" class="form-control maxlength" maxlength="500" autocomplete="off" />
        </div>
        <span asp-validation-for="@Model.RedirectLink" class="fv-plugins-message-container invalid-feedback"></span>
    </div>
</div>