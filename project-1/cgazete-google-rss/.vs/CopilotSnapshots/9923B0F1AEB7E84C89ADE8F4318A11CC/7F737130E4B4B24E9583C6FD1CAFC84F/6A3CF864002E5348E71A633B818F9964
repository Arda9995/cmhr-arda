        private async Task ArchiveGoogleAiFeedAsync()
        {
            // Rebuild complete calendar days, including empty days after exclusion or unpublishing.
            var today = DateTime.Now.Date;
            var since = today.AddDays(-2);
            var until = today.AddDays(1);

            var news = await (from np in _context.NewsPublished
                join author in _context.Authors on np.AuthorID equals author.ID into authors
                from author in authors.DefaultIfEmpty()
                where np.AllowToSendRSS
                      && !np.ExcludeFromGoogleAiFeed
                      && np.PublishedDate >= since
                      && np.PublishedDate < until
                      && (np.NewsTypeID == (int)NewsTypesEnum.News ||
                          np.NewsTypeID == (int)NewsTypesEnum.ColumnArticles)
                select new
                {
                    np.NewsID,
                    Title = !string.IsNullOrEmpty(np.Title)
                        ? np.Title
                        : (!string.IsNullOrEmpty(np.Headline) ? np.Headline : string.Empty),
                    Subtitle = !string.IsNullOrEmpty(np.Subtitle)
                        ? np.Subtitle
                        : (!string.IsNullOrEmpty(np.UpSubtitle)
                            ? np.UpSubtitle
                            : (!string.IsNullOrEmpty(np.Content)
                                ? np.Content.ExtractTextFromHtml()
                                : string.Empty)),
                    Content = !string.IsNullOrEmpty(np.Content) ? np.Content : string.Empty,
                    Slug = !string.IsNullOrEmpty(np.Slug) ? np.Slug : string.Empty,
                    PublishedDate = np.PublishedDate,
                    AuthorName = author != null
                        ? ((author.Firstname ?? string.Empty) + " " + (author.Lastname ?? string.Empty)).Trim()
                        : string.Empty
                }).ToListAsync();

            var contentNs = XNamespace.Get("http://purl.org/rss/1.0/modules/content/");
            var dcNs = XNamespace.Get("http://purl.org/dc/elements/1.1/");

            var groupedByDay = news
                .ToLookup(x => x.PublishedDate.Date);

            for (var day = since; day <= today; day = day.AddDays(1))
            {
                var dayNews = groupedByDay[day]
                    .GroupBy(x => x.NewsID)
                    .Select(g => g.OrderByDescending(x => x.PublishedDate).First())
                    .OrderByDescending(x => x.PublishedDate)
                    .ToList();

                var rss = new XDocument(
                    new XDeclaration("1.0", "utf-8", null),
                    new XElement("rss",
                        new XAttribute("version", "2.0"),
                        new XAttribute(XNamespace.Xmlns + "content", contentNs.NamespaceName),
                        new XAttribute(XNamespace.Xmlns + "dc", dcNs.NamespaceName),
                        new XElement("channel",
                            new XElement("title", "Cumhuriyet Gazetesi - Google AI Feed Archive"),
                            new XElement("link", $"{_siteUrl}"),
                            new XElement("description",
                                $"Cumhuriyet Gazetesi Google News AI Pilot Feed Archive - {day:yyyy-MM-dd}"),
                            new XElement("language", "tr-TR"),
                            new XElement("category", "News"),
                            new XElement("lastBuildDate", FormatRfc822Date(DateTime.Now)),
                            new XElement("pubDate", FormatRfc822Date(day)),
                            new XElement("copyright", "Cumhuriyet Gazetesi")
                        )));

                foreach (var item in dayNews)
                {
                    var itemUrl = $"{_siteUrl.TrimEnd('/')}/{item.Slug.TrimStart('/')}";
                    var itemElement = new XElement("item",
                        new XElement("title", item.Title),
                        new XElement("link", itemUrl),
                        new XElement("guid",
                            new XAttribute("isPermaLink", "false"),
                            itemUrl
                        ),
                        new XElement("pubDate", FormatRfc822Date(item.PublishedDate)),
                        new XElement("description", new XCData(item.Subtitle)),
                        new XElement(contentNs + "encoded", new XCData(item.Content))
                    );

                    if (!string.IsNullOrWhiteSpace(item.AuthorName))
                    {
                        itemElement.Add(new XElement(dcNs + "creator", item.AuthorName));
                    }

                    rss.Root.Element("channel").Add(itemElement);
                }

                var yearDirectory = Path.Combine(GoogleAiFeedArchiveBasePath, day.Year.ToString());
                Directory.CreateDirectory(yearDirectory);

                var archiveFilePath = Path.Combine(yearDirectory, $"feed-{day:yyyy-MM-dd}.xml");
                var xmlContent = SerializeXml(rss);
                var temporaryPath = archiveFilePath + "." + Guid.NewGuid().ToString("N") + ".tmp";
                try
                {
                    await File.WriteAllTextAsync(temporaryPath, xmlContent, Encoding.UTF8);
                    File.Move(temporaryPath, archiveFilePath, true);
                }
                finally
                {
                    if (File.Exists(temporaryPath))
                        File.Delete(temporaryPath);
                }

                _logger.LogInformation("Google AI archive written to {ArchivePath} with {ItemCount} items",
                    archiveFilePath, dayNews.Count);
            }
        }

