        throw new InvalidOperationException($"Archive failed: {result.Message}");
    var path = result.Data;
    if (!string.Equals(path, expectedPath, StringComparison.OrdinalIgnoreCase))
        throw new InvalidOperationException($"Unexpected daily filename: {path}; expected {expectedPath}");
    var file = new FileInfo(path);
    if (!file.Exists || file.Length == 0)
        throw new InvalidOperationException($"Archive is missing or empty: {path}");
    var document = XDocument.Load(path);
    if (document.Root?.Name != "rss" || (string)document.Root.Attribute("version") != "2.0")
        throw new InvalidOperationException($"Invalid RSS document: {path}");
    if (document.Root.GetNamespaceOfPrefix("atom") != XNamespace.Get("http://www.w3.org/2005/Atom"))
        throw new InvalidOperationException($"RSS Atom namespace is missing or incorrect: {path}");
    var items = document.Root.Element("channel")?.Elements("item").ToList()
        ?? throw new InvalidOperationException("RSS channel is missing.");
    var oldestPossible = refreshStartedAt.Date;
    var newestCutoff = refreshFinishedAt.Date;
    var expected = candidates.Where(x => x.PublishedDate >= newestCutoff).ToList();
    var expectedUrls = expected.Select(x => $"{siteUrl.TrimEnd('/')}/{(x.Slug ?? string.Empty).TrimStart('/')}")
        .OrderBy(x => x, StringComparer.Ordinal);
    var actualUrls = items.Select(x => (string)x.Element("guid")).OrderBy(x => x, StringComparer.Ordinal);
    var boundaryUrls = candidates.Where(x => x.PublishedDate >= oldestPossible && x.PublishedDate < newestCutoff)
        .Select(x => $"{siteUrl.TrimEnd('/')}/{(x.Slug ?? string.Empty).TrimStart('/')}").ToHashSet();
    if (!expectedUrls.SequenceEqual(actualUrls.Where(x => !boundaryUrls.Contains(x))))
        Archive must contain every eligible article published today
    XNamespace content = "http://purl.org/rss/1.0/modules/content/";
    XNamespace media = "http://search.yahoo.com/mrss/";
    XNamespace atom = "http://www.w3.org/2005/Atom";
    XNamespace dc = "http://purl.org/dc/elements/1.1/";
    var channel = document.Root.Element("channel");
    if (document.Root.GetNamespaceOfPrefix("content") != content ||
        document.Root.GetNamespaceOfPrefix("media") != media || document.Root.GetNamespaceOfPrefix("dc") != dc ||
        (string)channel.Element("title") != "Cumhuriyet Gazetesi - Google AI Feed" ||
        (string)channel.Element("ttl") != "60" || channel.Element("image")?.Element("url") == null ||
        channel.Element("description") == null ||
        (string)channel.Element(atom + "link")?.Attribute("rel") != "self" ||
        (string)channel.Element(atom + "link")?.Attribute("href") != "https://www.cumhuriyet.com.tr/feeds/google-ai.xml")
        throw new InvalidOperationException("The full feed channel or namespaces are missing.");
    if (items.Any(x => x.Element("title") == null || x.Element("pubDate") == null || x.Element("description") == null || x.Element(content + "encoded") == null))
        throw new InvalidOperationException("An archive item is missing its title, date, description, or content.");
    foreach (var item in items)
    {
        if (item.Element(content + "encoded").HasElements)
            throw new InvalidOperationException("Article HTML must be enclosed in CDATA, not nested XML elements.");
        var article = candidates.Single(x => $"{siteUrl.TrimEnd('/')}/{(x.Slug ?? string.Empty).TrimStart('/')}" == (string)item.Element("guid"));
        CheckContent(CleanContent(article.Content), item.Element(content + "encoded").Value);
        var expectedAuthor = article.AuthorID.HasValue && authors.TryGetValue(article.AuthorID.Value, out var name)
            ? name : string.Empty;
        if (string.IsNullOrWhiteSpace(expectedAuthor))
            expectedAuthor = editors.TryGetValue(article.NewsID, out var editorName) ? editorName : string.Empty;
        if (((string)item.Element(dc + "creator") ?? string.Empty) != expectedAuthor)
            throw new InvalidOperationException("dc:creator does not match the assigned author or creating editor fallback.");
        var enclosure = item.Element("enclosure");
        var photo = item.Element(media + "content");
        if (string.IsNullOrEmpty((string)enclosure?.Attribute("url")) ||
            (string)enclosure.Attribute("url") != (string)photo?.Attribute("url") ||
            !int.TryParse((string)photo?.Attribute("width"), out var width) || width <= 0 ||
            !int.TryParse((string)photo?.Attribute("height"), out var height) || height <= 0)
            throw new InvalidOperationException("The enclosure or media photo metadata is missing.");
        if (article.PublishedDate < oldestPossible || article.PublishedDate > refreshFinishedAt)
            throw new InvalidOperationException("An archive item is outside the rolling 48-hour window.");
        if (!item.Element(content + "encoded").Nodes().OfType<XCData>().Any())
            throw new InvalidOperationException("Full article content is not enclosed in CDATA.");
    }
    Console.WriteLine($"PASS refresh {repetition + 1}: {path}: all {items.Count} eligible rolling-window articles, valid RSS/CDATA, {file.Length} bytes.");
}
