@{
    ViewData[ViewDataNames.Title] = _localizer["Users"];
    ViewData[ViewDataNames.AsideMenu] = "Management";
    ViewData[ViewDataNames.AsideSubMenu] = "Users";
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Management"], string.Empty),
        new BreadcrumbItem(_localizer["Users"], "/Users/List")
    };
}

<div class="card">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
            <div class="d-flex align-items-center position-relative my-1">
                <partial name="Icons/Search" />
                <input type="text" data-kt-filter="datatable-search" class="form-control form-control-solid w-250px ps-14" placeholder="@_localizer["Search"]">
            </div>
        </div>
        <div class="card-toolbar">
            <div class="d-flex justify-content-end" data-kt-user-table-toolbar="base">
                <a href="/Users/Create" class="btn btn-primary">
                    <partial name="Icons/Add" />
                    @_localizer["New"] @_localizer["User"]
                </a>
            </div>
        </div>
    </div>
    <div class="card-body py-4">
        <table id="datatable">
            <thead>
                <tr>
                    <th>@_localizer["FullName"]</th>
                    <th>@_localizer["EMail"]</th>
                    <th>@_localizer["Phone"]</th>
                    <th>@_localizer["Role"]</th>
                    <th>@_localizer["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <div style="display:none">
                    <div id="Col2">
                        <a href="/Users/Update/{0}">{1} {2}</a>
                    </div>
                    <div id="Col3">
                        {0}
                    </div>
                    <div id="Col3">
                        {0}
                    </div>
                    <div id="Col4">
                        <span class="badge badge-light-primary">{0}</span>
                    </div>
                    <div id="Col5">
                        <span class="badge badge-light-{0}">{1}</span>
                    </div>
                    <div class="text-center" id="Col12">
                        <a href="/Users/Update/{0}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Update"]">
                            <partial name="Icons/Edit" />
                        </a>
                        <a onclick="DeleteRecordAndRefreshPage('/Users/Delete/{0}')" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Delete"]">
                            <partial name="Icons/Delete" />
                        </a>
                    </div>
                </div>
            </tbody>
        </table>
    </div>
</div>

@section Scripts{
    <script src="/Scripts/Users/List.js"></script>
}