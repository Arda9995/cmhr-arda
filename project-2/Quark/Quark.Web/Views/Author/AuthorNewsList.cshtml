@using Quark.Web.ViewComponents.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Quark.API.Business.Models.Responses.AuthorResponses.GetAuthorNewsListResponse

@section Metatags {
    <meta name="title" itemprop="title" content="Günün Köşe Yazıları | Cumhuriyet" />

    <meta name="description" content="Türkiye'nin en iyi köşe yazarları en güzel köşe yazıları ile Cumhuriyet'te! Usta yazarlar ve güncel köşe yazılarını okumak için tıklayın!">

    <title>Günün Köşe Yazıları | Cumhuriyet Gazetesi</title>

    <meta property="og:title" content="Günün Köşe Yazıları | Cumhuriyet Gazetesi" />
    <meta property="og:description" content="Cumhuriyet Gazetesi Köşe Yazarlarının Bugün yazdığı gündeme dair köşe yazıları..." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.cumhuriyet.com.tr/gunun-kose-yazilari" />
    <meta property="og:image:url" content="https://www.cumhuriyet.com.tr/assets/img/cumhuriyet-ana-foto-101-yasinda.jpg" />
    <meta property="og:image" content="https://www.cumhuriyet.com.tr/assets/img/cumhuriyet-ana-foto-101-yasinda.jpg" />
    <meta property="fb:admins" content="619332001" />
    <meta property="fb:app_id" content="168546753348847" />
    <link rel="canonical" href="https://www.cumhuriyet.com.tr/gunun-kose-yazilari" />
    <link rel="alternate" type="application/rss+xml" href="https://www.cumhuriyet.com.tr/rss" />
}
@{
    var hasPremiumMembership = "False";

    var id = User?.Identities?.FirstOrDefault()?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
    if (id != null)
    {
        hasPremiumMembership = @User.Identities.FirstOrDefault(u => u.IsAuthenticated && u.HasClaim(c => c.Type == "HasPremiumMembership")).FindFirst("HasPremiumMembership").Value;
    }
}
@if (hasPremiumMembership == "False")
{

    @section AdScripts {
        <!-- Google -->
        <!-- Start GPT Tag -->
        <script async src="https://securepubads.g.doubleclick.net/tag/js/gpt.js"></script>
        <script data-cfasync="false" async src="https://media.cumhuriyet.com.tr/assets/js/cmhads.js?v=1.01"></script>
    }
}

@section Scripts {
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [{
        "@@type": "ListItem",
        "position": 1,
        "item": {
            "@@id": "https://www.cumhuriyet.com.tr/",
            "name": "Cumhuriyet"
            }
        },{
        "@@type": "ListItem",
        "position": 2,
        "item": {
            "@@id": "https://www.cumhuriyet.com.tr/gunun-kose-yazilari",
            "name": "Günün Köşe Yazıları"
            }
        }]
        }
    </script>
}

<partial name="~/Views/Shared/_Header.cshtml" />
<partial name="~/Views/Shared/AdContainers/_GeneralFloatingAdArea.cshtml" />
<main id="main" class="my-4 px-5 tablet:px-0">
    <partial name="~/Views/Shared/AdContainers/_GeneralHeaderAdArea.cshtml" />
    <div class="max-w-container mx-auto space-y-6 undefined">
        <!-- Ad Start -->
         <!-- Ad End --> <!-- Breadcrumb Start -->
        <nav class="flex items-center gap-2 text-xs undefined">
            <a href="/" class="text-gray-500 hover:text-gray-600 transition-all font-medium"> Anasayfa </a><span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 12L10 8L6 4" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </span><a href="/gunun-kose-yazilari" class="text-red-600 font-semibold "> Günün Köşe Yazıları </a>
        </nav> <!-- Breadcrumb End -->
        <div class="grid grid-cols-12 gap-8">
            <div class="col-span-12 lg:col-span-8">
                <!-- Links Start -->
                <div class="undefined overflow-x-auto">
                    <nav class="flex gap-4 whitespace-nowrap"> 
                        <a href="/gunun-kose-yazilari" class="px-3 py-1  transition-all font-semibold bg-[#051E4B] text-white"> Günün Köşe Yazıları </a>
                        <a href="/yazarlar/spor-yazarlari" class="px-3 py-1  transition-all font-semibold bg-gray-200 hover:bg-gray-300 text-secondary-400 "> Spor </a>
                        <a href="/yazarlar/konuk-yazarlari" class="px-3 py-1  transition-all font-semibold bg-gray-200 hover:bg-gray-300 text-secondary-400 "> Konuk </a>
                        <a href="/yazarlar/yasam-yazarlari" class="px-3 py-1  transition-all font-semibold bg-gray-200 hover:bg-gray-300 text-secondary-400 "> Yaşam </a>
                        <a href="/yazarlar" class="px-3 py-1  transition-all font-semibold bg-gray-200 hover:bg-gray-300 text-secondary-400 "> Tüm Yazarlar </a> 
                    </nav>
                </div> <!-- Links End -->
                <div class="mt-5 space-y-5">
                    @foreach (var newsListItem in Model.TodaysNewsList)
                    {
                        <div class="p-4 bg-[#FAFAFA] flex items-center gap-3">
                            <!-- Image Start -->
                            <a href="@newsListItem.Slug" class="shrink-0">
                                <img src="@newsListItem.Photo" alt="" loading="lazy" class="size-14 rounded-full shrink-0">
                            </a> <!-- Image End  -->
                            <div class="space-y-1 flex flex-col">
                                <a href="@newsListItem.Slug" clas s="font-medium text-[#6B6B7D]">@newsListItem.AuthorName</a>
                                <a href="@newsListItem.Slug" class="font-semibold lg:text-xl">@newsListItem.Headline</a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @await Component.InvokeAsync("News", new NewsViewComponentModel { MethodName = "MostViewedNews", NewsCount = 6 })

        </div>
    </div>
</main>