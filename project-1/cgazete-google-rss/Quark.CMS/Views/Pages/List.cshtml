@{
    ViewData[ViewDataNames.Title] = _localizer["Pages"];
    ViewData[ViewDataNames.AsideMenu] = "Content";
    ViewData[ViewDataNames.AsideSubMenu] = "Pages";
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Content"], string.Empty),
        new BreadcrumbItem(_localizer["Pages"], "/Pages/List")
    };
}

@section Scripts{
    <script src="/Scripts/Pages/List.js" asp-append-version="true"></script>
}

<div class="card">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
        </div>
        <div class="card-toolbar">
            <div class="d-flex justify-content-end">
                <a href="/Pages/Create" class="btn btn-primary">
                    <partial name="Icons/Add"/>
                    @_localizer["New"] @_localizer["Page"]
                </a>
            </div>
        </div>
    </div>
    <div class="card-body py-4">
        <table id="datatable">
            <thead>
            <tr>
                <th class="w-70px text-center"></th>
                <th>@_localizer["Page"] @_localizer["Name"]</th>
                <th>@_localizer["Description"]</th>
                <th>@_localizer["KeyWord"]</th>
                <th class="w-100px text-center"></th>
            </tr>
            </thead>
            <tbody>
            <div style="display:none">
                <div id="Col1">
                    {0}
                </div>
                <div id="Col2">
                    <a href="/Pages/Update/{1}">{0}</a>
                </div>
                <div id="Col3">
                    {0}
                </div>
                <div id="Col4">
                    {0}
                </div>
                <div class="text-center" id="Col12">
                    <a href="/Pages/Update/{0}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Update"]">
                        <partial name="Icons/Edit"/>
                    </a>
                    <a onclick="DeleteRecordAndRefreshPage('/Pages/Delete/{1}')" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Delete"]">
                        <partial name="Icons/Delete"/>
                    </a>
                </div>
            </div>
            </tbody>
        </table>
    </div>
</div>