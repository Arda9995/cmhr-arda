@model Quark.CMS.Business.Models.Responses.NewsResponses.NewsVersionLiveResponse

<div class="alert alert-dismissible bg-light-danger d-flex flex-column flex-sm-row p-8">
    <i class="ki-duotone ki-information-5 fs-2hx text-danger mb-5 me-4">
        <span class="path1"></span><span class="path2"></span><span class="path3"></span>
    </i>
    <div class="d-flex flex-column pe-0 pe-sm-10">
        <h4 class="mb-2">@_localizer["Draft"] @_localizer["News"]</h4>
        <span>@_localizer["AlertLiveText"]</span>
        <div class="mt-5">
            <a href="/News/Details/@Model.News.ID" class="btn btn-danger btn-sm me-3">@_localizer["GoToDraft"]</a>
        </div>
    </div>
    <button type="button" class="position-absolute position-sm-relative m-2 m-sm-0 top-0 end-0 btn btn-icon ms-sm-auto" data-bs-dismiss="alert">
        <i class="ki-duotone ki-cross-circle fs-2x">
            <span class="path1"></span><span class="path2"></span>
        </i>
    </button>
</div>