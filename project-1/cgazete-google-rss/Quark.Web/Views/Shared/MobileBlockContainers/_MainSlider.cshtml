@model MainPageResponse
@{
    var mainSliderNews = Model.PageNewsCachingResponses.Where(x => x.BlockKey == "AnaSayfa-AnaSlider").ToList();
}

<div class="splide mobile-top-slider mobile-pagination" role="group">
    <div class="splide__track">
        <ul class="splide__list">
            @foreach (var news in mainSliderNews)
            {
                <li class="splide__slide relative aspect-[16/9] w-full">
                    <a href="@news.NewsSlug" class="relative block" target="_blank">
                        <div class="aspect-[16/9]">
                            <img class="w-full h-full object-cover" src="@news.NewsPhoto" alt="@news.NewsHeadline">
                        </div>
                        @if (news.ShowHeadline)
                        {
                            <div class="absolute inset-0 manset-gradient"></div>
                            <div class="absolute bottom-0 left-0 right-0 py-2 flex flex-col justify-center items-center space-y-1">
                                @if (!string.IsNullOrEmpty(news.NewsUpHeadline) && news.ShowUpHeadline)
                                {
                                    <div class="py-1 px-2 bg-[#FF0101] text-white italic text-sm font-bold">@news.NewsUpHeadline</div>
                                }
                                <div class="font-semibold text-white line-clamp-2 text-center px-5">@news.NewsHeadline</div>
                            </div>
                         }
                    </a>
                </li>
            }
        </ul>
    </div>
</div>