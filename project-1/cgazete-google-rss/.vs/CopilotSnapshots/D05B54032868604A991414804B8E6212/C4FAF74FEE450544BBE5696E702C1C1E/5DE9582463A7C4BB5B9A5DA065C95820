    private void NormalizeNewsListSlugs(GetNewsListCachingResponse data)
    {
        if (data == null)
        {
            return;
        }

        var baseUrl = _appSettingsKeys.Common_ClientWebSite;

        if (!string.IsNullOrWhiteSpace(data.CategorySlug))
            data.CategorySlug = data.CategorySlug.ReplaceWebsiteUrl(baseUrl);
        if (!string.IsNullOrWhiteSpace(data.SourceSlug))
            data.SourceSlug = data.SourceSlug.ReplaceWebsiteUrl(baseUrl);
        if (!string.IsNullOrWhiteSpace(data.TagSlug))
            data.TagSlug = data.TagSlug.ReplaceWebsiteUrl(baseUrl);

        var newsLists = new[]
        {
            data.CategoryTwo, data.CategorySix, data.CategoryNine, data.CategoryTen,
            data.ZodiacSignNews, data.CategoryOthers, data.MobileCategoryNews,
            data.GovernmentAnnouncementNews
        };

        foreach (var list in newsLists)
        {
            if (list == null) continue;
            foreach (var news in list)
            {
                if (!string.IsNullOrWhiteSpace(news.Slug))
                    news.Slug = news.Slug.ReplaceWebsiteUrl(baseUrl);
            }
        }

        var surveyLists = new[] { data.SurveyNewsTwo, data.SurveyNewsSix, data.SurveyNewsOthers };
        foreach (var list in surveyLists)
        {
            if (list == null) continue;
            foreach (var news in list)
            {
                if (!string.IsNullOrWhiteSpace(news.Slug))
                    news.Slug = news.Slug.ReplaceWebsiteUrl(baseUrl);
            }
        }

        if (data.ZodiacSignNewsForSlider != null)
        {
            foreach (var news in data.ZodiacSignNewsForSlider)
            {
                if (!string.IsNullOrWhiteSpace(news.Slug))
                    news.Slug = news.Slug.ReplaceWebsiteUrl(baseUrl);
            }
        }
    }

