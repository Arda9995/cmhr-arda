-- Google AI Feed
-- Production tabloları: dbo schema, tablo adları "News.*" (EF [Table("News.News")] ile birebir).
-- Deploy sonrası CMS'de NewsPhotoTypes cache'inin yenilenmesi gerekir (veya ilk CMS istekte otomatik yenilenir).

IF COL_LENGTH(N'dbo.[News.News]', 'ExcludeFromGoogleAiFeed') IS NULL
BEGIN
    ALTER TABLE [dbo].[News.News]
    ADD [ExcludeFromGoogleAiFeed] BIT NOT NULL
        CONSTRAINT DF_News_ExcludeFromGoogleAiFeed DEFAULT (0);
END
GO

