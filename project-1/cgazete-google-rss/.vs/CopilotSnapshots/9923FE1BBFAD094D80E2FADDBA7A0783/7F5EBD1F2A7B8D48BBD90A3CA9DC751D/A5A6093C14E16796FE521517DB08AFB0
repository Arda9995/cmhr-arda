                await CacheXmlAsync(rss, categoryEntity.ID.ToString(),
                    string.Format(ElasticRssKeys.CategoryRssKey, categoryEntity.Url.ToLower()), IndexNames.Category_RSS);
            }
            catch (Exception ex)
            {
                result.Message = ex.Message;
            }

            return result;
        }

        public async Task<ServiceResult> RefreshGoogleAiRSS()
        {
            var result = new ServiceResult();
            try
            {
                var (feed, _) = await BuildAndArchiveGoogleAiFeedAsync();
                var updated = await CacheXmlAsync(feed,
                    ((int)ElasticRssKeysEnum.GoogleAiRssKey).ToString(),
                    ElasticRssKeys.GoogleAiRssKey, IndexNames.GoogleAiRSS);
                if (!updated)
                {
                    _logger.LogError("Google AI live feed could not be updated in Elasticsearch");
                    result.SetError("Google AI live feed could not be updated.");
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Google AI live feed refresh failed");
                result.SetError("Google AI live feed could not be refreshed.");
            }

            return result;
        }

        private static string CleanGoogleAiContent(string content)
        {
            if (string.IsNullOrEmpty(content))
                return string.Empty;

            var document = new HtmlDocument();
            document.LoadHtml(content);
            foreach (var node in document.DocumentNode.Descendants().Where(x =>
                         x.Name.Equals("script", StringComparison.OrdinalIgnoreCase) ||
                         x.Name.Equals("style", StringComparison.OrdinalIgnoreCase) ||
                         (x.Name.Equals("link", StringComparison.OrdinalIgnoreCase) &&
                          x.GetAttributeValue("rel", string.Empty).Split((char[])null, StringSplitOptions.RemoveEmptyEntries)
                              .Contains("stylesheet", StringComparer.OrdinalIgnoreCase))).ToList())
            {
                node.Remove();
            }

            foreach (var node in document.DocumentNode.Descendants())
            {
                foreach (var attribute in node.Attributes.Where(x =>
                             x.Name.Equals("style", StringComparison.OrdinalIgnoreCase) ||
                             x.Name.Equals("class", StringComparison.OrdinalIgnoreCase) ||
                             x.Name.StartsWith("on", StringComparison.OrdinalIgnoreCase) ||
                             ((x.Name.Equals("href", StringComparison.OrdinalIgnoreCase) ||
                               x.Name.Equals("src", StringComparison.OrdinalIgnoreCase) ||
                               x.Name.Equals("xlink:href", StringComparison.OrdinalIgnoreCase)) &&
                              IsGoogleAiScriptUrl(x.Value))).ToList())
                {
                    node.Attributes.Remove(attribute);
                }
            }

            return document.DocumentNode.InnerHtml;
        }

        private static bool IsGoogleAiScriptUrl(string value)
        {
            var url = new string(HtmlEntity.DeEntitize(value)
                .Where(x => !char.IsWhiteSpace(x) && !char.IsControl(x)).ToArray());
            return url.StartsWith("javascript:", StringComparison.OrdinalIgnoreCase) ||
                   url.StartsWith("vbscript:", StringComparison.OrdinalIgnoreCase);
        }

        private static IQueryable<NewsPublished> FilterGoogleAiNews(IQueryable<NewsPublished> news, DateTime now)
        {
            var since = now.ToUniversalTime().AddHours(-48).ToLocalTime();
            return news.Where(x => x.PublishedDate >= since && x.PublishedDate <= now &&
                                   x.AllowToSendRSS && !x.ExcludeFromGoogleAiFeed &&
                                   (x.NewsTypeID == (int)NewsTypesEnum.News ||
                                    x.NewsTypeID == (int)NewsTypesEnum.ColumnArticles));
        }

        private static string GetGoogleAiDescription(string subtitle)
        {
            var document = new HtmlDocument();
            document.LoadHtml(CleanGoogleAiContent(subtitle));
            return HtmlEntity.DeEntitize(document.DocumentNode.InnerText).Trim();
        }

        private static XElement CreateGoogleAiCreator(string authorName, string editorName)
        {
            var creatorName = string.IsNullOrWhiteSpace(authorName) ? editorName : authorName;
            return string.IsNullOrWhiteSpace(creatorName)
                ? null
                : new XElement(DcNamespace + "creator", creatorName.Trim());
        }

        private async Task<XDocument> BuildGoogleAiRssAsync(DateTime now)
        {
                var publishedNews = FilterGoogleAiNews(_context.NewsPublished.AsNoTracking(), now);

                var query = (from np in publishedNews
                    join author in _context.Authors on np.AuthorID equals author.ID into authors
                    from author in authors.DefaultIfEmpty()
                    let photo = (from ph in _context.NewsPublishedPhotos
                        where ph.NewsID == np.NewsID &&
                              !string.IsNullOrEmpty(ph.PhotoUrl) &&
                              (ph.PhotoTypeID == (int)NewsPhotoTypesEnum.GoogleAiHighResPhoto ||
                               ph.PhotoTypeID == (int)NewsPhotoTypesEnum.MainPhoto ||
                               ph.PhotoTypeID == (int)NewsPhotoTypesEnum.CoverPhoto)
                        orderby
                            ph.PhotoTypeID == (int)NewsPhotoTypesEnum.GoogleAiHighResPhoto
                                ? 0
                                : ph.PhotoTypeID == (int)NewsPhotoTypesEnum.MainPhoto
                                    ? 1
                                    : ph.PhotoTypeID == (int)NewsPhotoTypesEnum.CoverPhoto
                                        ? 2
                                        : 3
                        select ph).FirstOrDefault()
                    select new
                    {
                        Title = !string.IsNullOrEmpty(np.Title)
                            ? np.Title
                            : (!string.IsNullOrEmpty(np.Headline) ? np.Headline : string.Empty),
                        Content = !string.IsNullOrEmpty(np.Content) ? np.Content : string.Empty,
                        Subtitle = np.Subtitle ?? string.Empty,
                        Slug = !string.IsNullOrEmpty(np.Slug) ? np.Slug : string.Empty,
                        PublishedDate = np.PublishedDate,
                        AuthorName = author != null
                            ? ((author.Firstname ?? string.Empty) + " " + (author.Lastname ?? string.Empty)).Trim()
                            : string.Empty,
                        EditorName = (from article in _context.News
                            join editor in _context.Users on article.CreatedBy equals editor.ID
                            where article.ID == np.NewsID
                            select ((editor.Firstname ?? string.Empty) + " " + (editor.Lastname ?? string.Empty)).Trim())
                            .FirstOrDefault(),
                        IsGoogleAiHighResPhoto = photo != null &&
                                                 photo.PhotoTypeID == (int)NewsPhotoTypesEnum.GoogleAiHighResPhoto,
                        ImageWidth = photo != null ? photo.Width : null,
                        ImageHeight = photo != null ? photo.Height : null,
                        ImageURL = photo != null && !string.IsNullOrEmpty(photo.PhotoUrl)
                            ? photo.PhotoUrl.TrimStart('/').PrepareCDNUrl(_appSettingsKeys.CDN_BaseUrl,
                                _appSettingsKeys.CDN_MediaGalleryFolder)
                            : "https://media.cumhuriyet.com.tr/cumhuriyet-noimage.jpg",
                    }).OrderByDescending(x => x.PublishedDate);

                var news = await query.ToListAsync();

                var rss = CreateRssDocument("Cumhuriyet Gazetesi - Google AI Feed", _siteUrl,
                    "Cumhuriyet Gazetesi Google News AI Pilot Feed", "tr", GoogleAiFeedSelfUrl, now, now);

                foreach (var item in news)
                {
                    var itemUrl = $"{_siteUrl.TrimEnd('/')}/{item.Slug.TrimStart('/')}";
                    var mediaWidth = item.ImageWidth.HasValue && item.ImageWidth.Value > 0
                        ? item.ImageWidth.Value.ToString()
                        : (item.IsGoogleAiHighResPhoto ? "1600" : "1280");
                    var mediaHeight = item.ImageHeight.HasValue && item.ImageHeight.Value > 0
                        ? item.ImageHeight.Value.ToString()
                        : (item.IsGoogleAiHighResPhoto ? "1200" : "720");
                    var itemElement = CreateRssItem(item.Title, itemUrl, itemUrl,
                        item.PublishedDate, item.ImageURL, mediaHeight, mediaWidth,
                        CreateGoogleAiCreator(item.AuthorName, item.EditorName),
                        new XElement("description", GetGoogleAiDescription(item.Subtitle)),
                        new XElement(ContentNamespace + "encoded", new XCData(CleanGoogleAiContent(item.Content)))
                    );

                    rss.Root.Element("channel").Add(itemElement);
                }

                return rss;
        }

        public async Task<ServiceResult<string>> ArchiveGoogleAiNewsAsync(long newsId)
        {
            var result = new ServiceResult<string>();
            try
            {
                var publishedDate = await _context.NewsPublished
                    .Where(x => x.NewsID == newsId)
                    .Select(x => (DateTime?)x.PublishedDate)
                    .FirstOrDefaultAsync();
                if (!publishedDate.HasValue)
                {
                    result.Message = "The published article was not found.";
                    return result;
                }

                // Rebuild even when this article is excluded, so it is removed from the daily file.
                return await RefreshGoogleAiArchiveAsync();
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Google AI archive for news {NewsId} failed at {ArchivePath}", newsId, GoogleAiFeedArchiveBasePath);
                result.SetError("Google AI feed archive could not be written.");
            }

            return result;
        }

        public async Task<ServiceResult<string>> RefreshGoogleAiArchiveAsync()
        {
            var result = new ServiceResult<string>();
            try
            {
                var (_, path) = await BuildAndArchiveGoogleAiFeedAsync();
                result.Data = path;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Google AI daily archive failed at {ArchivePath}", GoogleAiFeedArchiveBasePath);
                result.SetError("Google AI feed archive could not be written.");
            }

            return result;
        }

        private async Task<(XDocument Feed, string Path)> BuildAndArchiveGoogleAiFeedAsync()
        {
            Directory.CreateDirectory(GoogleAiFeedArchiveBasePath);
            // Lock before capturing the date and querying, including refreshes across midnight.
            await using var archiveLock = await AcquireGoogleAiArchiveLockAsync(
                Path.Combine(GoogleAiFeedArchiveBasePath, "google-ai.lock"));
            var now = DateTime.Now;
            var yearDirectory = Path.Combine(GoogleAiFeedArchiveBasePath, now.Year.ToString(CultureInfo.InvariantCulture));
            Directory.CreateDirectory(yearDirectory);
            var stem = "feed-" + now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            var archiveFilePath = Path.Combine(yearDirectory, stem + ".xml");
            var feed = await BuildGoogleAiRssAsync(now);
            var temporaryPath = Path.Combine(yearDirectory, stem + "." + Guid.NewGuid().ToString("N") + ".tmp");
            try
            {
                // SerializeXml already includes the UTF-8 preamble; do not add a second one.
                await File.WriteAllTextAsync(temporaryPath, SerializeXml(feed), new UTF8Encoding(false));
                File.Move(temporaryPath, archiveFilePath, true);
                _logger.LogInformation("Google AI daily archive written to {ArchivePath} with {ItemCount} items",
                    archiveFilePath, feed.Root.Element("channel").Elements("item").Count());
                return (feed, archiveFilePath);
            }
            finally
            {
                if (File.Exists(temporaryPath))
                    File.Delete(temporaryPath);
            }
        }

        private static async Task<FileStream> AcquireGoogleAiArchiveLockAsync(string path)
        {
            for (var attempt = 0; ; attempt++)
            {
                try
                {
                    return new FileStream(path, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
                }
                catch (IOException ex) when (((ex.HResult & 0xFFFF) == 32 || (ex.HResult & 0xFFFF) == 33) && attempt < 100)
                {
                    await Task.Delay(100);
                }
            }
        }

