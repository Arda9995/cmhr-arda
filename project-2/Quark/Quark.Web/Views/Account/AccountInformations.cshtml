            e = document.getElementById("tc_no");
        if (n && e) {
            const t = e.parentElement;
            n.addEventListener("change", function () {
                t && (this.checked ? (t.style.display = "none", e.removeAttribute("required"), e.value = "") : (t.style.display = "block", e.setAttribute("required", "")))
