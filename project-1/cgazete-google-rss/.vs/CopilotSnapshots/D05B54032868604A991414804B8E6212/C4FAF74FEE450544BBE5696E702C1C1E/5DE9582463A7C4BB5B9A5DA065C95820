                        .Where(x => photoGalleryItemIds.Contains(x.ID))
                        .OrderBy(x => x.Order)
                        .Select(x => new CachingNewsDetailPhotoGalleryItem
                        {
                            ImageURL = x.PhotoUrl,
                            Content = x.Content
                        }).ToListAsync();
                }
            }

            #endregion

            #region Kaynaklar

            var sourceIDModel = procedureModel.Data.SourceIDs;
            if (sourceIDModel != null)
            {
                var sourceIds = sourceIDModel.Split(",").Select(int.Parse).ToList();
                var sourceCachingList = await sourceCachingService.GetNewsSourceList();
                if (sourceCachingList.IsSuccess)
                {
                    news.SourceList = sourceCachingList.Data
                        .Where(x => sourceIds.Contains(x.ID))
                        .Select(x => new CachingNewsDetailSourceList
                        {
                            ID = x.ID,
                            Name = x.Name,
                            Slug = _appSettingsKeys.Common_ClientWebSite + _appSettingsKeys.SlugPrefix_Sources + "/" +
