            if (news.NewsTypeID == (int)NewsTypesEnum.PhotoGallery)
            {
                var cachePhotoGalleryItems = await newsPhotosCachingService.GetNewsPublishedPhotoGalleryItems(news.ID);
                if (cachePhotoGalleryItems.IsSuccess)
