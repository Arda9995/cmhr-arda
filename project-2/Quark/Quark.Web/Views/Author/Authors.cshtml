								<!-- Image End -->
								<!-- Posts Count Start -->
								<div class="text-slate-900 text-sm font-helvetica">@author.TotalNewsCount Yazı</div>
								<!-- Posts Count End -->
							</div>
							<!-- Content Start -->
							<div class="space-y-1 flex flex-col">
								<!-- Name Start -->
								<a href="@author.Slug" class="text-gray-700 font-medium">@author.FullName</a>
								<!-- Name End -->
								<!-- Link Start -->
								<a href="@author.Slug" class="font-semibold text-slate-900 text-sm">@author.Description</a>
								<!-- Link End -->
								<a href="@author.Slug" class="text-xs font-semibold text-red-custom hover:text-secondary-400 transition-all">Tüm Yazıları</a>
