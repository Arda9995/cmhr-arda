@using Quark.Web.Models.ViewComponentResponses
@model Quark.Web.Models.ViewComponentResponses.MenuItems

@if (Model != null)
{
    var drawerId = $"drawer-{Model.ID}";
    <div class="@(Model.Children == null || !Model.Children.Any() ? "" : "border-b")" data-astro-cid-7j4fal7x>
        @if (string.IsNullOrEmpty(Model.URL))
        {
            <button type="button" 
                    class="drawer-category flex items-center justify-between w-full px-6 py-4 text-gray-700 hover:bg-gray-100 transition-colors duration-200" 
                    data-drawer-target="@drawerId"
                    data-astro-cid-7j4fal7x>
                <div class="flex items-center gap-3" data-astro-cid-7j4fal7x>
                    <span class="text-gray-400" data-astro-cid-7j4fal7x>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                        </svg>
                    </span> <span data-astro-cid-7j4fal7x>@(Model.Name ?? string.Empty)</span>
                </div>
                @if (Model.Children != null && Model.Children.Any())
                {
                    <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                }
            </button>
            <div id="@drawerId" class="hidden drawer-content" data-astro-cid-7j4fal7x>
                <div class="px-6 py-2 space-y-2" data-astro-cid-7j4fal7x>
                    @if (Model.Children != null && Model.Children.Any())
                    {
                        @foreach (var childMenu in Model.Children)
                        {
                            var newMenuItem = new MenuItems
                            {
                                Children = childMenu.Children,
                                ID = childMenu.ID,
                                Key = childMenu.Key,
                                Name = childMenu.Name,
                                OpenInNewWindow = childMenu.OpenInNewWindow,
                                Order = childMenu.Order,
                                ParentID = childMenu.ParentID,
                                URL = childMenu.URL
                            };
                            <partial name="~/Views/Shared/Components/Menu/_MenuItem.cshtml" model="newMenuItem" />
                        }
                    }
                </div>
            </div>
        }
        else
        {
            <a href="@(Model.URL ?? "#")" class="flex items-center justify-between w-full px-6 py-4 text-gray-700 hover:bg-gray-100 transition-colors duration-200" data-astro-cid-7j4fal7x>
                <div class="flex items-center gap-3" data-astro-cid-7j4fal7x>
                    <span class="text-gray-400" data-astro-cid-7j4fal7x>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                        </svg>
                    </span>  <span data-astro-cid-7j4fal7x>@(Model.Name ?? string.Empty)</span>
                </div>
            </a>
        }
    </div>
} 