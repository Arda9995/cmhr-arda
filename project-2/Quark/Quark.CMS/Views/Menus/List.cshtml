@{
    ViewData[ViewDataNames.Title] = _localizer["MenuManagement"];
    ViewData[ViewDataNames.AsideMenu] = "Content";
    ViewData[ViewDataNames.AsideSubMenu] = "Menus";
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Content"], string.Empty)
    };
}

<div class="card">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
            <div class="d-flex align-items-center position-relative my-1">
                <partial name="Icons/Search" />
                <input type="text" data-kt-filter="datatable-search" class="form-control form-control-solid w-250px ps-14" placeholder="@_localizer["Search"]">
            </div>
        </div>
        <div class="card-toolbar">
            <div class="d-flex justify-content-end" data-kt-category-table-toolbar="base">
                <a href="/Menus/CreateParentMenu" class="btn btn-primary">
                    <partial name="Icons/Add" />
                    @_localizer["New"] @_localizer["Menu"]
                </a>
            </div>
        </div>
    </div>
    <div class="card-body py-4">
        <table id="datatable">
            <thead>
                <tr>
                    <th>@_localizer["Name"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <div style="display:none">
                    <div id="Col2">
                        <a href="/Menus/Details/{0}">{1}</a>
                    </div>
                    <div id="Col3">
                        <span class="badge badge-light-{0}">{1}</span>
                    </div>
                    <div class="text-center" id="Col12">
                        <a href="/Menus/UpdateParent/{0}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Update"]">
                            <partial name="Icons/Edit" />
                        </a>
                    </div>
                </div>
            </tbody>
        </table>
    </div>
</div>
@section Scripts{
    <script src="/Scripts/Menus/List.js"></script>
}