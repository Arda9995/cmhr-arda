<script>
	// Highlight current URL in sidebar
	document.addEventListener('DOMContentLoaded', function () {
		const currentPath = window.location.pathname;
		const navLinks = document.querySelectorAll('nav a');

		navLinks.forEach(link => {
			if (link.getAttribute('href') === currentPath) {
				link.classList.remove('text-gray-900', 'hover:bg-gray-50');
				link.classList.add('text-red-600', 'bg-red-50', 'hover:bg-red-100');
			} else {
				link.classList.remove('text-red-600', 'bg-red-50', 'hover:bg-red-100');
				link.classList.add('text-gray-900', 'hover:bg-gray-50');
			}
		});
	});
</script>