<div id="block-modal" class="modal-body">
    <form id="form1" method="post" enctype="multipart/form-data">
        <div class="row g-6">
            <div class="col-6">
                <label class="form-label">Önizleme</label>
                <div id="photo">
                    <img id="edited-photo-org" src="/img/blank-placeholder.png" alt="" style="display: none;"/>
                    <img id="edited-photo" src="/img/blank-placeholder.png" alt="" style="width: 100%; height: 100%"/>
                </div>
            </div>
            <div class="col-6">
                <label class="form-label">Metin Konumu</label>
                <div id="groupInput" class="mb-10 h-200px auto p-2 d-flex justify-content-between flex-column border border-gray-300 border-1 rounded" style="background-image: url('https://metronic.avvamobile.com/8.2.1/Layout1/assets/media/svg/files/blank-image.svg'); background-size: contain; background-repeat: no-repeat; background-position: center;">
                    <div class="d-flex text-center justify-content-between p-2">
                        <input class="form-check-input w-25px h-25px border-3" type="radio" name="radioNoLabel" id="radioNoLabel1" value="1" >
                        <input class="form-check-input w-25px h-25px border-3" type="radio" name="radioNoLabel" id="radioNoLabel1" value="2" >
                        <input class="form-check-input w-25px h-25px border-3" type="radio" name="radioNoLabel" id="radioNoLabel1" value="3" >
                    </div>
                    <div class=" d-flex text-center justify-content-between p-2">
                        <input class="form-check-input w-25px h-25px border-3" checked="checked" type="radio" name="radioNoLabel" id="radioNoLabel1" value="4" >
                        <input class="form-check-input w-25px h-25px border-3" type="radio" name="radioNoLabel" id="radioNoLabel1" value="5" >
                        <input class="form-check-input w-25px h-25px border-3" type="radio" name="radioNoLabel" id="radioNoLabel1" value="6" >
                    </div>
                </div>
                <div class="mb-5 fv-row">
                    <label class="form-label">Metin (1. Satır)</label>
                    <input id="text1" type="text" class="form-control mb-2"/>
                    <span class="fv-plugins-message-container invalid-feedback"></span>
                </div>
                <div class="mb-5 fv-row">
                    <label class="form-label">Tema (1. Satır)</label>
                    <select id="templates1" onchange="preparePhoto()" class="form-select mb-2" data-control="select2" data-placeholder="-- Seçiniz --">
                        <option disabled selected>-- Seçiniz --</option>
                    </select>
                    <span class="fv-plugins-message-container invalid-feedback"></span>
                </div>
                <div class="mb-5 fv-row">
                    <label class="form-label">Metin (2. Satır)</label>
                    <input id="text2" type="text" class="form-control mb-2"/>
                </div>
                <div class="mb-5 fv-row">
                    <label class="form-label">Tema (2. Satır)</label>
                    <select id="templates2" onchange="preparePhoto()" class="form-select mb-2" data-control="select2" data-placeholder="-- Seçiniz --">
                        <option disabled selected>-- Seçiniz --</option>
                    </select>
                </div>
            </div>
        </div>
    </form>
</div>