var cleanContent = typeof(XmlFeedCachingService).GetMethod("CleanGoogleAiContent", BindingFlags.NonPublic | BindingFlags.Static)
    ?? throw new InvalidOperationException("Google AI content cleanup method is missing.");
string CleanContent(string html) => (string)cleanContent.Invoke(null, new object[] { html });

void CheckContent(string expected, string cleaned)
{
    // XML readers normalize CRLF and CR to LF, including text inside CDATA.
    string NormalizeXmlLineEndings(string text) => (text ?? string.Empty).Replace("\r\n", "\n").Replace('\r', '\n');
    var beforeHtml = new HtmlDocument();
    beforeHtml.LoadHtml(NormalizeXmlLineEndings(expected));
    var afterHtml = new HtmlDocument();
    afterHtml.LoadHtml(NormalizeXmlLineEndings(cleaned));
    var beforeNodes = beforeHtml.DocumentNode.Descendants().ToList();
    var afterNodes = afterHtml.DocumentNode.Descendants().ToList();
    if (beforeNodes.Count != afterNodes.Count || beforeHtml.DocumentNode.InnerText != afterHtml.DocumentNode.InnerText)
        throw new InvalidOperationException("HTML structure or article text changed during cleanup.");
    for (var i = 0; i < beforeNodes.Count; i++)
    {
        var expectedAttributes = beforeNodes[i].Attributes
            .Select(x => (x.Name, x.Value));
        if (beforeNodes[i].Name != afterNodes[i].Name ||
            !expectedAttributes.SequenceEqual(afterNodes[i].Attributes.Select(x => (x.Name, x.Value))))
            throw new InvalidOperationException("Cleaned HTML does not match the expected semantic markup and attributes.");
    }
}

if (args.Length == 1 && args[0] == "--check-content")
{
    (string Original, string Expected)[] samples =
    {
        (null, string.Empty), (string.Empty, string.Empty),
        ("Plain text: style=example class=example &amp; text", "Plain text: style=example class=example &amp; text"),
        ("<p style=\"color:red\" class='intro'>Türkçe <strong>bold</strong> <em>italic</em></p>", "<p>Türkçe <strong>bold</strong> <em>italic</em></p>"),
        ("<p STYLE='color:red' CLASS=lead><a href='https://example.com/?a=1&amp;b=2' title='style=keep' class='link'>Link</a><img src='photo.jpg' alt='Photo &amp; caption' style='width:100%' /></p>",
         "<p><a href='https://example.com/?a=1&amp;b=2' title='style=keep'>Link</a><img src='photo.jpg' alt='Photo &amp; caption' /></p>"),
        ("<span style='white-space: pre;'> </span><p class='one' class='two' style='a' style='b'>Text</p>", "<span> </span><p>Text</p>"),
        ("<p data-style='keep' data-class='keep' title='a > b; class=keep' STYLE='x > y'>Text &bull;</p>", "<p data-style='keep' data-class='keep' title='a > b; class=keep'>Text &bull;</p>"),
        ("<p style='color:red'>First paragraph</p>\r\n<p class='lead'>Second\rline</p>", "<p>First paragraph</p>\r\n<p>Second\rline</p>"),
        ("<p class='lead'>Unclosed <strong style='color:red'>formatting", "<p>Unclosed <strong>formatting"),
        ("<style>p { color:red; }</style><script>alert('x')</script><p>News</p>", "<p>News</p>"),
        ("<LINK REL='alternate STYLESHEET' href='theme.css'><p onclick='run()'>News<img src='photo.jpg' alt='News' onerror='run()'></p>", "<p>News<img src='photo.jpg' alt='News'></p>"),
        ("<a href='java&#x73;cript:run()'>Link</a><a href='java&#10;script:run()'>Other</a><a href='/article'>Safe</a>", "<a>Link</a><a>Other</a><a href='/article'>Safe</a>"),
        ("<p>Text with ]]> and &amp; Turkish: ıİşŞğĞüÜöÖçÇ</p>", "<p>Text with ]]> and &amp; Turkish: ıİşŞğĞüÜöÖçÇ</p>")
    };
    foreach (var sample in samples)
    {
        var cleaned = CleanContent(sample.Original);
        CheckContent(sample.Expected, cleaned);
        CheckContent(sample.Expected, XElement.Parse(new XElement("content", new XCData(cleaned)).ToString()).Value);
        if (CleanContent(cleaned) != cleaned)
            throw new InvalidOperationException("Content cleanup must be idempotent.");
    }
    var description = typeof(XmlFeedCachingService).GetMethod("GetGoogleAiDescription", BindingFlags.NonPublic | BindingFlags.Static);
    if ((string)description.Invoke(null, new object[] { "<style>p{color:red}</style><p class='lead'>Türkçe &amp; <strong>news</strong></p><script>run()</script>" }) != "Türkçe & news")
        throw new InvalidOperationException("Descriptions must be plain article summaries without CSS or scripts.");
    Console.WriteLine($"PASS {samples.Length} offline HTML/CDATA cleanup cases and description cleanup: CSS/scripts removed; text, semantic markup and images preserved.");
    return;
}

if (args.Length == 1 && args[0] == "--check-window")
{
    var filter = typeof(XmlFeedCachingService).GetMethod("FilterGoogleAiNews", BindingFlags.NonPublic | BindingFlags.Static)
        ?? throw new InvalidOperationException("Google AI publication filter is missing.");
    foreach (var now in new[] { new DateTime(2026, 9, 9, 10, 0, 0, DateTimeKind.Local), new DateTime(2026, 12, 31, 23, 59, 59, DateTimeKind.Local) })
    {
        var since = now.Date;
        NewsPublished Article(long id, DateTime date, bool allow = true, bool excluded = false, NewsTypesEnum type = NewsTypesEnum.News)
            => new() { NewsID = id, PublishedDate = date, AllowToSendRSS = allow, AllowGoogleAiFeed = !excluded, NewsTypeID = (int)type };
        var articles = new List<NewsPublished>
        {
            Article(1, since), Article(2, since.AddTicks(-1)), Article(3, now), Article(4, now.AddTicks(1)),
            Article(5, now.AddHours(-24)), Article(6, now.AddHours(-1), allow: false),
            Article(7, now.AddHours(-1), excluded: true), Article(8, now.AddHours(-1), type: NewsTypesEnum.ColumnArticles),
            Article(9, now.AddHours(-1), type: NewsTypesEnum.PhotoGallery)
        };
        articles.AddRange(Enumerable.Range(100, 150).Select(id => Article(id, now.AddHours(-2))));
        var actual = ((IQueryable<NewsPublished>)filter.Invoke(null, new object[] { articles.AsQueryable(), now }))
            .Select(x => x.NewsID).OrderBy(x => x).ToArray();
        var expected = new long[] { 1, 3, 8 }.Concat(Enumerable.Range(100, 150).Select(x => (long)x)).OrderBy(x => x).ToArray();
        if (!actual.SequenceEqual(expected))
            throw new InvalidOperationException("The daily window must include only eligible articles published today (from midnight up to now) and exclude previous-day, future and opted-out articles.");
        Console.WriteLine($"PASS {now:yyyy-MM-dd HH:mm:ss}: {actual.Length} eligible articles, today-only window, previous day excluded, opt-outs.");
    }
    return;
}

if (args.Length == 1 && args[0] == "--check-creator")
{
    var createCreator = typeof(XmlFeedCachingService).GetMethod("CreateGoogleAiCreator", BindingFlags.NonPublic | BindingFlags.Static)
        ?? throw new InvalidOperationException("Google AI creator method is missing.");
    (string Author, string Editor, string Expected)[] cases =
    {
        (null, "Ayşe Editör", "Ayşe Editör"),
        (string.Empty, "Ayşe Editör", "Ayşe Editör"),
        (" \t\n", "Ayşe Editör", "Ayşe Editör"),
        (" Ahmet Yazar ", "Ayşe Editör", "Ahmet Yazar"),
        ("Ahmet Yazar", null, "Ahmet Yazar"),
        (null, " Ayşe ", "Ayşe"),
        (null, "Ayşe & <Editör>", "Ayşe & <Editör>"),
        (null, null, null),
        (string.Empty, string.Empty, null),
        (" ", " \t ", null)
    };
    XNamespace dc = "http://purl.org/dc/elements/1.1/";
    foreach (var sample in cases)
    {
        var creator = (XElement)createCreator.Invoke(null, new object[] { sample.Author, sample.Editor });
        var rss = new XElement("rss", new XAttribute(XNamespace.Xmlns + "dc", dc.NamespaceName),
            new XElement("channel", new XElement("item", creator)));
        var serialized = rss.ToString();
        var item = XElement.Parse(serialized).Element("channel").Element("item");
        var actual = item.Element(dc + "creator");
        if ((string)actual != sample.Expected ||
            (sample.Expected != null && (!serialized.Contains("<dc:creator>") || item.Elements(dc + "creator").Count() != 1)) ||
            (sample.Expected == null && item.Elements().Any()))
            throw new InvalidOperationException("dc:creator must prefer the author, fall back to the creating editor, escape XML and omit unknown names.");
    }
    Console.WriteLine($"PASS {cases.Length} creator attribution cases: author priority, editor fallback, trimmed/missing names and XML namespace/escaping.");
    return;
}

