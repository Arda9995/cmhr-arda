var archiveRoot = Path.Combine(root, "GoogleAiFeedArchive");
var expectedPath = Path.Combine(archiveRoot, day.Year.ToString(), $"feed-{day:yyyy-MM-dd}.xml");
Dictionary<string, string> SnapshotFiles() => Directory.Exists(archiveRoot)
    ? Directory.EnumerateFiles(archiveRoot, "*.xml", SearchOption.AllDirectories)
        .ToDictionary(x => x, x => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(x))))
    : new Dictionary<string, string>();
