@{
    ViewData[ViewDataNames.Title] = _localizer["New"] + " " + _localizer["Category"];
    ViewData[ViewDataNames.AsideMenu] = "Content";
    ViewData[ViewDataNames.AsideSubMenu] = "Categories";
    ViewData["ShowBackButton"] = true;
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Content"], string.Empty),
        new BreadcrumbItem(_localizer["Categories"], "/Categories/List")
    };
}
@model Quark.CMS.Business.Models.Requests.CategoryRequests.CreateUpdateRequest

@section Scripts
{
    <script src="/Scripts/Categories/Validations.js" asp-append-version="true"></script>
}

<div class="card mb-5 mb-xl-10 col-8">
    <div class="card-header border-0">
        <div class="card-title m-0">
            <h3 class="fw-bolder m-0">@_localizer["Category"] @_localizer["Informations"]</h3>
        </div>
    </div>
    <form class="form" method="post" enctype="multipart/form-data" id="categoriesForm">
        <input type="hidden" asp-for="@Model.ParentID"/>
        <div class="card-body border-top p-9">
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6 required">@_localizer["Name"]</label>
                <div class="col-lg-8">
                    <div class="row">
                        <div class="justify-content-end">
                            <input type="text" asp-for="Name" class="form-control form-control-lg form-control-solid" placeholder="@_localizer["Name"]" />
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Name"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label required fw-bold fs-6">@_localizer["Photo"]</label>
                <div class="col-lg-8">
                    <div class="image-input image-input-outline" data-kt-image-input="true">
                        <div id="backgroundClichePhoto" class="image-input-wrapper w-125px h-125px bgi-position-center" style="background-size: 75%;
                            background-image: url('@(Model.PhotoUrl)')"></div>
                        <label class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow" data-kt-image-input-action="change" data-bs-toggle="tooltip" title="@_localizer["Update"]">
                            <i class="bi bi-pencil-fill fs-7"></i>
                            <input type="file" name="Photo" accept=".png, .jpg, .jpeg" />
                            <input type="hidden" name="avatar_remove" />
                        </label>
                        <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow" data-kt-image-input-action="cancel" data-bs-toggle="tooltip" title="@_localizer["Cancel"]">
                            <i class="bi bi-x fs-2"></i>
                        </span>
                    </div>
                    <div class="form-text">@_localizer["UploadImageHelpText"]</div>
                    <span class="fv-plugins-message-container invalid-feedback" id="imageValidation"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label required fw-bold fs-6">@_localizer["BackgroundPhoto"]</label>
                <div class="col-lg-8">
                    <div class="image-input image-input-outline" data-kt-image-input="true">
                        <div id="backgroundClichePhoto" class="image-input-wrapper w-125px h-125px bgi-position-center" style="background-size: 75%;
                            background-image: url('@(Model.BackgroundPhotoUrl)')"></div>
                        <label class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow" data-kt-image-input-action="change" data-bs-toggle="tooltip" title="@_localizer["Update"]">
                            <i class="bi bi-pencil-fill fs-7"></i>
                            <input type="file" name="BackgroundPhoto" accept=".png, .jpg, .jpeg" />
                            <input type="hidden" name="avatar_remove" />
                        </label>
                        <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-white shadow" data-kt-image-input-action="cancel" data-bs-toggle="tooltip" title="@_localizer["Cancel"]">
                            <i class="bi bi-x fs-2"></i>
                        </span>
                    </div>
                    <div class="form-text">@_localizer["UploadImageHelpText"]</div>
                    <span class="fv-plugins-message-container invalid-feedback" id="imageValidation"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label for="basic-url" class="required form-label">URL</label>
                <div class="input-group">
                    <span class="input-group-text" id="slug">@Model.BaseURL</span>
                    <input asp-for="@Model.Url" type="text" class="form-control maxlength" maxlength="500" id="basic-url" aria-describedby="basic-addon3"/>
                </div>
                <span asp-validation-for="@Model.Url" class="fv-plugins-message-container invalid-feedback"></span>
                <div id="url-note" class="text-muted fs-7">@_localizer["UrlDesc"]</div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6 required">@_localizer["SeoTitle"]</label>
                <div class="col-lg-8">
                    <div class="row">
                        <div class="justify-content-end">
                            <input type="text" asp-for="SeoTitle" class="form-control form-control-lg form-control-solid" placeholder="@_localizer["SeoTitle"]" />
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="SeoTitle"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6 required">@_localizer["SeoDescription"]</label>
                <div class="col-lg-8">
                    <div class="row">
                        <div class="justify-content-end">
                            <input type="text" asp-for="SeoDescription" class="form-control form-control-lg form-control-solid" placeholder="@_localizer["SeoDescription"]" />
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="SeoDescription"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-4 col-form-label fw-bold fs-6 required">Breadcrumb</label>
                <div class="col-lg-8">
                    <div class="row">
                        <div class="justify-content-end">
                            <input type="text" asp-for="Breadcrumb" class="form-control form-control-lg form-control-solid" placeholder="Breadcrumb" />
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Breadcrumb"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end py-6 px-9">
            <button type="submit" class="btn btn-primary me-2">@_localizer["Save"]</button>
            <a href="/Categories/List" class="btn btn-light btn-light-primary">@_localizer["Cancel"]</a>
        </div>
    </form>
</div>