    public async Task<ServiceResult> RefreshMainPageZodiacSignBlock()
    {
        var result = new ServiceResult<ZodiacSignBlockCacheResponse>
        {
            Data = new ZodiacSignBlockCacheResponse
            {
                ZodiacSignItems = new List<ZodiacSignBlockCacheResponseItem>(),
            }
        };

        var publishedDates = new List<DateTime>();


        var astrologer = await (from a in _context.Authors
            join ac in _context.AuthorCategories on a.ID equals ac.AuthorID
            where ac.CategoryID == (int)CategoryEnum.Astrologie
            select a).FirstOrDefaultAsync();

        foreach (ZodiacSignEnum sign in Enum.GetValues(typeof(ZodiacSignEnum)))
        {
            var latestNews = await (from np in _context.NewsPublished
                where np.CategoryID == (int)CategoryEnum.Astrologie &&
                      np.SecondaryCategoryMap.Contains(((int)sign).ToString())
                orderby np.PublishedDate descending
                select new ZodiacSignBlockCacheResponseItem
                {
                    NewsID = np.NewsID,
                    Slug = np.Slug.PrepareWebsiteUrl(_appSettingsKeys.Common_ClientWebSite),
                    ZodiacSignType = sign,
                    PublishDate = np.PublishedDate
                }).FirstOrDefaultAsync();

            if (latestNews != null)
            {
                publishedDates.Add(latestNews.PublishDate);
                result.Data.ZodiacSignItems.Add(latestNews);
            }
        }

        string weekRangeText;
        var culture = new CultureInfo("tr-TR");

        if (publishedDates.Any())
        {
            var minDate = publishedDates.Min();
            var maxDate = publishedDates.Max();

            if (minDate.Date == maxDate.Date)
            {
                var date = maxDate;
                var startOfWeek = date.AddDays(-(int)date.DayOfWeek + (int)DayOfWeek.Monday - 7);
                var endOfWeek = startOfWeek.AddDays(6);
                weekRangeText =
                    $"{startOfWeek.Day} {startOfWeek.ToString("MMMM", culture)} - {endOfWeek.Day} {endOfWeek.ToString("MMMM", culture)}";
            }
            else
            {
                weekRangeText =
                    $"{minDate.Day} {minDate.ToString("MMMM", culture)} - {maxDate.Day} {maxDate.ToString("MMMM", culture)}";
            }

            result.Data.DateStringForZodiacSignDateRange = weekRangeText;
        }

        if (astrologer != null)
        {
            result.Data.AstrologerName = astrologer.FullName;
            result.Data.AstrologerImageURL =
                astrologer.ClichePhoto.PrepareCDNUrl(_appSettingsKeys.CDN_BaseUrl, _appSettingsKeys.CDN_AuthorPhotos);
        }
        else
        {
            result.Data.AstrologerName = null;
            result.Data.AstrologerImageURL = null;
        }

        var serializedData = JsonConvert.SerializeObject(result.Data);
        var cacheResponse = await _cache.Set(RedisKeys.ZodiacSignBlock, serializedData,
            RedisTTLSeconds.MainPageZodiacSignBlock_TTL);

        if (!cacheResponse)
        {
            result.Message = "Redis veri güncellenirken hata oluştu.";
            return result;
        }

        return result;
    }

    private async Task<ServiceResult<DbProcedureNewsDetailResponse>> GetNewsDetailWithDbProcedure(int newsID)
    {
        var result = new ServiceResult<DbProcedureNewsDetailResponse>();
        DataTable dataTable = new DataTable();

        try
        {
            DbConnection connection = _context.Database.GetDbConnection();
            DbProviderFactory dbFactory = DbProviderFactories.GetFactory(connection);

            using (var cmd = dbFactory.CreateCommand())
            {
                cmd.Connection = connection;
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.CommandText = "[dbo].[NewsDetailCreateModel]";
                DbParameter dbParameter = cmd.CreateParameter();
                dbParameter.ParameterName = "@NewsId";
                dbParameter.DbType = DbType.Int32;
                dbParameter.Value = newsID;
                cmd.Parameters.Add(dbParameter);

                using (DbDataAdapter adapter = dbFactory.CreateDataAdapter())
                {
                    adapter.SelectCommand = cmd;
                    adapter.Fill(dataTable);
                }
            }
        }
        catch (Exception e)
        {
            result.IsSuccess = false;
            return result;
        }

        result.Data = ConvertDataTable<DbProcedureNewsDetailResponse>(dataTable).FirstOrDefault();
        return result;
    }

