@{
    ViewData[ViewDataNames.Title] = _localizer["News"] + " " + _localizer["PhotoType"] + " " + _localizer["Update"];
    ViewData[ViewDataNames.AsideMenu] = "Management";
    ViewData[ViewDataNames.AsideSubMenu] = "NewsPhotoTypes";
    ViewData["ShowBackButton"] = true;
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Management"], string.Empty),
        new BreadcrumbItem(_localizer["NewsPhotosSettings"], "/NewsPhotoTypes/List")
    };
}

@model Quark.CMS.Business.Models.Requests.NewsPhotoTypeRequests.CreateUpdateRequest

<div class="card mb-5 mb-xl-10 col-12">
    <div class="card-header border-0">
        <div class="card-title m-0">
            <h3 class="fw-bolder m-0">@_localizer["PhotoType"] @_localizer["Informations"]</h3>
        </div>
    </div>
    <form class="form" method="post" enctype="multipart/form-data">
        <input asp-for="ID" type="hidden" />
        <div class="card-body border-top p-9">
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6 required">@_localizer["Name"]</label>
                <div class="col-lg-9">
                    <input asp-for="Name" type="text" class="form-control form-control-lg form-control-solid" />
                    <div class="form-text">
                        @_localizer["PhotoTypeNameText"]
                    </div>
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Name"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6 required">@_localizer["KeyWord"]</label>
                <div class="col-lg-9">
                    <input asp-for="Key" type="text" class="form-control form-control-lg form-control-solid" />
                    <div class="form-text">
                        @_localizer["PhotoTypeKeyWordText"]
                    </div>
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Key"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6 required">@_localizer["Description"]</label>
                <div class="col-lg-9">
                    <input asp-for="Description" type="text" class="form-control form-control-lg form-control-solid" />
                    <div class="form-text">
                        @_localizer["PhotoTypeNameText"]
                    </div>
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Description"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6 required">@_localizer["Scalings"]</label>
                <div class="col-lg-9">
                    <div class="row">
                        <div class="col-lg-6 fv-row">
                            <input asp-for="Width" type="number" min="1" max="2048" class="form-control form-control-lg form-control-solid" placeholder="@_localizer["Width"] (px)" />
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Width"></span>
                        </div>
                        <div class="col-lg-6 fv-row">
                            <input asp-for="Height" type="number" min="1" max="2048" class="form-control form-control-lg form-control-solid" placeholder="@_localizer["Height"] (px)" />
                            <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Height"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6 required">@_localizer["Order"]</label>
                <div class="col-lg-9">
                    <div class="position-relative w-md-300px" data-kt-dialer="true" data-kt-dialer-min="1" data-kt-dialer-max="99" data-kt-dialer-step="1" data-kt-dialer-decimals="0">
                        <button type="button" class="btn btn-icon btn-active-color-gray-700 position-absolute translate-middle-y top-50 start-0" data-kt-dialer-control="decrease">
                            <i class="ki-duotone ki-minus-square fs-2">
                                <span class="path1"></span><span class="path2"></span>
                            </i>
                        </button>
                        <input asp-for="Order" type="text" class="form-control form-control-solid border-0 ps-12" data-kt-dialer-control="input" readonly />
                        <button type="button" class="btn btn-icon btn-active-color-gray-700 position-absolute translate-middle-y top-50 end-0" data-kt-dialer-control="increase">
                            <i class="ki-duotone ki-plus-square fs-2">
                                <span class="path1"></span><span class="path2"></span><span class="path3"></span>
                            </i>
                        </button>
                    </div>
                    <div class="form-text">
                        @_localizer["PhotoTypeOrderText"]
                    </div>
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Order"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6">@_localizer["Required"]</label>
                <div class="col-lg-9 fv-row">
                    <div class="form-check form-switch form-check-custom form-check-solid mt-2">
                        <input asp-for="IsRequired" class="form-check-input" type="checkbox" />
                        <span class="form-check-label text-muted">@_localizer["Required"]</span>
                    </div>
                    <div class="form-text">
                        @_localizer["PhotoTypeRequiredText"]
                    </div>
                    <span class="fv-plugins-message-container invalid-feedback"></span>
                </div>
            </div>
            @if (Model.ID != (int)NewsPhotoTypesEnum.PhotoGalleryItemPhoto)
            {
                <div class="row mb-6">
                    <label class="col-lg-3 col-form-label fw-bold fs-6">@_localizer["Status"]</label>
                    <div class="col-lg-9 fv-row">
                        <div class="form-check form-switch form-check-custom form-check-solid mt-2">
                            <input asp-for="IsEnabled" class="form-check-input" type="checkbox" checked />
                            <span class="form-check-label text-muted">@_localizer["Enabled"]</span>
                        </div>
                        <span class="fv-plugins-message-container invalid-feedback"></span>
                    </div>
                </div>
            }
        </div>
        <div class="card-footer d-flex justify-content-end py-6 px-9">
            <button type="submit" class="btn btn-primary me-2">@_localizer["Save"]</button>
            <a href="/NewsPhotoTypes/List" class="btn btn-light btn-light-primary">@_localizer["Cancel"]</a>
        </div>
    </form>
</div>