@using Quark.Core.Extentions

@{
    Layout = "~/Views/Shared/_LayoutNoAds.cshtml";
}

@model Quark.API.Business.Models.Responses.AuthorResponses.AuthorDetailResponse


@section Metatags {
    <meta name="title" itemprop="title" content="@Html.Raw(string.Format("{0} Tüm Yazıları | Cumhuriyet",Model.FullName))" />

    <meta name="description" content="@Html.Raw(string.Format("{0} Tüm Yazıları | Cumhuriyet",Model.FullName))">

    <title>@Html.Raw(string.Format("{0} Tüm Yazıları | Cumhuriyet", Model.FullName))</title>

    <meta name="keywords" content="@Model.FullName" />
    <meta property="fb:admins" content="619332001" />
    <meta property="fb:app_id" content="168546753348847" />
    <link rel="canonical" href="@Model.Slug" />
    <link rel="alternate" type="application/rss+xml" href="https://www.cumhuriyet.com.tr/rss" />
}

@section Scripts{
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [{
        "@@type": "ListItem",
        "position": 1,
        "item": {
            "@@id": "https://www.cumhuriyet.com.tr/",
            "name": "Cumhuriyet"
            }
        },{
        "@@type": "ListItem",
        "position": 2,
        "item": {
            "@@id": "https://www.cumhuriyet.com.tr/yazarlar",
            "name": "Yazarlar"
            }
        },{
        "@@type": "ListItem",
        "position": 3,
        "item": {
            "@@id": "@Model.Slug",
            "name": "@Model.FullName"
            }
        }]
        }
    </script>
    <script>
        PageCategories.push("Anasayfa");
    </script>
    <script>
        $(document).ready(function () {
            let currentPage = 1;
            const pageSize = 40;
            let isLoading = false;
            let hasMoreItems = true;
            let currentDateRange = '';

            // Handle filter button click
            $('#filterButton').on('click', function () {
                const dateRange = $('#datepicker').val();
                currentDateRange = dateRange;
                currentPage = 1;
                loadArticles(true);
            });

            // Handle load more button click
            $('#loadMoreBtn').on('click', function () {
                if (!isLoading && hasMoreItems) {
                    currentPage++;
                    loadArticles(false);
                }
            });

            // Function to load articles
            function loadArticles(resetContainer) {
                if (isLoading) return;

                isLoading = true;

                $.ajax({
                    url: '/Author/GetFilteredArticles',
                    type: 'GET',
                    data: {
                        authorId: @Model.ID,
                        dateRange: currentDateRange,
                        page: currentPage,
                        pageSize: pageSize
                    },
                    success: function (response) {
                        isLoading = false;
                        hasMoreItems = response.hasMore;

                        // Toggle load more button visibility
                        if (!hasMoreItems) {
                            $('#loadMoreBtn').hide();
                        } else {
                            $('#loadMoreBtn').show();
                        }

                        // Clear container if resetting
                        if (resetContainer) {
                            $('#articles-container').empty();
                        }

                        // Append articles
                        if (response.articles && response.articles.length > 0) {
                            response.articles.forEach(function (article) {
                                const articleHtml = `
                                            <a href="${article.slug}" class="bg-[#FAFAFA] hover:bg-[#F2F2F7] p-5 flex flex-col gap-y-1 transition-all">
                                                <div class="flex justify-between">
                                                    <div class="font-semibold line-clamp-2">${article.headline}</div>
                                                </div>
                                                <div class="line-clamp-2 text-[#6B6B7D] font-helvetica text-sm">${article.upSubtitle}</div>
                                                <div class="flex justify-between mt-auto">
                                                    <div class="text-sm mt-auto font-helvetica">Devamını Oku</div>
                                                    <span class="text-[#080827] text-sm">${article.publishDate}</span>
                                                </div>
                                            </a>
                                        `;
                                $('#articles-container').append(articleHtml);
                            });
                        } else if (resetContainer) {
                            $('#articles-container').html('<div class="col-span-full text-center p-5">Bu tarih aralığında yazı bulunamadı.</div>');
                            $('#loadMoreBtn').hide();
                        }
                    },
                    error: function () {
                        isLoading = false;
                    }
                });
            }
        });
    </script>
}

