    public async Task<ServiceResult<GetCachingNewsDetailResponse>> GetNewsDetailByID(int id)
    {
        var result = new ServiceResult<GetCachingNewsDetailResponse>();

        var getNewsDetailResponse =
            await _cache.Get<GetCachingNewsDetailResponse>(string.Format(RedisKeys.NewsDetail, id));

        if (getNewsDetailResponse == null)
        {
            var isPublished = await _context.NewsPublished
                .Where(x => x.NewsID == id).AnyAsync();

            if (!isPublished)
            {
                result.SetError("Haber bulunamadı.");
                return result;
            }

            var newsDetail = await CreateNewsDetail(id);

            if (newsDetail.Data != null)
            {
                result.Data = newsDetail.Data;

                var jsonData = JsonConvert.SerializeObject(newsDetail.Data);
                await _cache.Set(string.Format(RedisKeys.NewsDetail, id), jsonData, RedisTTLSeconds.NewsDetail_TTL);
                getNewsDetailResponse =
                    await _cache.Get<GetCachingNewsDetailResponse>(string.Format(RedisKeys.NewsDetail, id));
            }
            else
            {
                result.IsSuccess = false;
                return result;
            }
        }

        result.Data = getNewsDetailResponse;
        return result;
    }

    public async Task<ServiceResult> RefreshNewsPublishedSearch()
    {
        var result = new ServiceResult();

        var searchNews = await (from np in _context.NewsPublished.Select(x => new
            {
                NewsID = x.NewsID,
                Title = x.Title,
                Subtitle = x.Subtitle,
                Headline = x.Headline,
                UpSubtitle = x.UpSubtitle,
                Slug = x.Slug,
                PublishedDate = x.PublishedDate,
                CategoryID = x.CategoryID,
                AuthorID = x.AuthorID,
                SourceIDs = x.SourceIDs,
                NewsTypeID = x.NewsTypeID
            })
            let photo = (from ph in _context.NewsPublishedPhotos
                where ph.NewsID == np.NewsID &&
                      (ph.PhotoTypeID == (int)NewsPhotoTypesEnum.MainPhoto ||
                       ph.PhotoTypeID == (int)NewsPhotoTypesEnum.CoverPhoto)
                orderby
                    ph.PhotoTypeID == (int)NewsPhotoTypesEnum.MainPhoto && !string.IsNullOrEmpty(ph.PhotoUrl)
                        ? 0
                        : ph.PhotoTypeID == (int)NewsPhotoTypesEnum.CoverPhoto && !string.IsNullOrEmpty(ph.PhotoUrl)
                            ? 1
                            : 2
                select ph).FirstOrDefault()
            select new GetNewsPublishedCacheResponse()
            {
                ID = (int)np.NewsID,
                Title = np.Title ?? string.Empty,
                SubTitle = np.Subtitle ?? string.Empty,
                Headline = np.Headline ?? string.Empty,
                UpSubtitle = np.UpSubtitle ?? string.Empty,
                Slug = np.Slug.PrepareWebsiteUrl(_appSettingsKeys.Common_ClientWebSite),
                CoverPhoto = photo != null && !string.IsNullOrEmpty(photo.PhotoUrl)
                    ? photo.PhotoUrl.TrimStart('/').PrepareCDNUrl(_appSettingsKeys.CDN_BaseUrl,
                        _appSettingsKeys.CDN_MediaGalleryFolder)
                    : string.Empty,
                PublishDate = np.PublishedDate,
                CategoryID = np.CategoryID,
                AuthorID = np.AuthorID,
                SoruceIDs = np.SourceIDs,
                NewsTypeID = np.NewsTypeID
            }).ToListAsync();

        if (searchNews.Any())
        {
            var addElastic =
                await elasticSearchService.BulkIndexDocumentsAsync<GetNewsPublishedCacheResponse>(searchNews,
                    "prod_news_published_search");
            if (!addElastic)
            {
                result.SetError("ElasticSearch'e veri eklenemedi.");
                return result;
            }
        }

        return result;
    }

