@{
    ViewData[ViewDataNames.Title] = _localizer["Roles"];
    ViewData[ViewDataNames.AsideMenu] = "Management";
    ViewData[ViewDataNames.AsideSubMenu] = "Roles";
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(@_localizer["Management"], string.Empty),
        new BreadcrumbItem(@_localizer["Roles"], "/Roles/List")
    };
}
@model Quark.CMS.Business.Models.Requests.RoleRequests.GetFiltersRequest

<partial name="_ListFilterPartial" model="Model" />

<div class="card">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
        </div>
        <div class="card-toolbar">
            <div class="d-flex justify-content-end" data-kt-user-table-toolbar="base">
                <a href="/Roles/Create" class="btn btn-primary">
                    <partial name="Icons/Add" />
                    @_localizer["New"] @_localizer["Role"]
                </a>
            </div>
        </div>
    </div>
    <div class="card-body py-4">
        <table id="datatable">
            <thead>
                <tr>
                    <th class="w-70px text-center"></th>
                    <th class="w-200px">@_localizer["Role"]</th>
                    <th>@_localizer["Description"]</th>
                    <th class="text-center">@_localizer["ActiveUser"]</th>
                    <th class="text-center">@_localizer["PassiveUser"]</th>
                    <th class="w-70px text-center">@_localizer["Status"]</th>
                    <th class="w-100px text-center"></th>
                </tr>
            </thead>
            <tbody>
                <div style="display:none">
                    <div id="Col1">
                        {0}
                    </div>
                    <div id="Col2">
                        {0}
                    </div>
                    <div id="Col3">
                        {0}
                    </div>
                    <div id="Col4">
                        {0}
                    </div>
                    <div id="Col5">
                        {0}
                    </div>
                    <div id="Col6">
                        <span class="badge fw-bolder badge-{0}">{1}</span>
                    </div>
                    <div class="text-center" id="Col12">                      
                        <a href="/Roles/Update/{0}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Update"]">
                            <partial name="Icons/Edit" />
                        </a>
                        <a onclick="DeleteRecordAndRefreshPage('/Roles/Delete/{1}')" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Delete"]">
                            <partial name="Icons/Delete" />
                        </a>
                    </div>
                </div>
            </tbody>
        </table>
    </div>
</div>
@section Scripts{
    <script src="/Scripts/Roles/List.js"></script>
}