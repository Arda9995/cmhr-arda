@{
    ViewData[ViewDataNames.Title] = _localizer["Products"];
    ViewData[ViewDataNames.AsideMenu] = "PaymentManagements";
    ViewData[ViewDataNames.AsideSubMenu] = "Products";
    ViewData["ShowBackButton"] = true;
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["PaymentManagements"], string.Empty),
        new BreadcrumbItem(_localizer["Products"], "/PaymentManagement/Products"),
    };
}

@model Quark.Business.Common.PaymentServices.Models.Requests.CreateCumhuriyetProductRequest

<div class="card mb-5 mb-xl-10 col-12">
    <div class="card-header border-0">
        <div class="card-title m-0">
            <h3 class="fw-bolder m-0">@_localizer["ProductInformation"]</h3>
        </div>
    </div>
    <form class="form" method="post" id="productForm">
        <div class="card-body top p-9">
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6 required">@_localizer["ProductName"]</label>
                <div class="col-lg-9 fv-row">
                    <input type="text" asp-for="Name" class="form-control form-control-lg form-control-solid mb-3 mb-lg-0" />
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6">@_localizer["Description"]</label>
                <div class="col-lg-9 fv-row">
                    <textarea asp-for="Description" class="form-control form-control-lg form-control-solid" rows="4"></textarea>
                </div>
            </div>
            <input type="hidden" asp-for="ConversationId" />
        </div>
        <div class="card-footer d-flex justify-content-end py-6 px-9">
            <button type="submit" class="btn btn-primary me-2">@_localizer["Save"]</button>
            <a href="/PaymentManagement/Products" class="btn btn-light btn-light-primary">@_localizer["Cancel"]</a>
        </div>
    </form>
</div>
