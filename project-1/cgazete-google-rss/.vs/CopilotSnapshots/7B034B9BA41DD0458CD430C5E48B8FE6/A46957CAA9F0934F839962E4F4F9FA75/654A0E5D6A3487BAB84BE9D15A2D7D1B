		@if (isMobile)
		{
			<partial name="~/Views/Shared/AdContainers/_NewsDetailUnderSpotAdArea.cshtml"/>
		}
		@if (string.IsNullOrEmpty(Model.Video))
		{
			<partial name="~/Views/Shared/AdContainers/_GeneralMembranaAdArea.cshtml"/>
		}
		<div class="mt-6 prose font-helvetica max-w-full text-xl text-content">
			@if (Model.Video != null && Model.VideoPlayerID != null)
			{
				if (Model.VideoPlayerID == 1)
				{
					<div class="aspect-[16/9] relative overflow-hidden">
						<iframe id="videoPlayer"
						        src="https://www.youtube.com/embed/@Model.Video"
						        style="
									width: 100%;
									height: 100%;
									position: absolute;
									left: 0px;
									top: 0px;
									overflow: hidden;
									border: none;"
						        allowfullscreen
						        title="YouTube Video Player"
						        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share">
						</iframe>
					</div>
				}

				if (Model.VideoPlayerID == 2)
				{
					<div class="aspect-[16/9] relative overflow-hidden">
						<iframe id="videoPlayer" src="https://geo.dailymotion.com/player.html?video=@Model.Video"
						        style="
										width: 100%;
										height: 100%;
										position: absolute;
										left: 0px;
										top: 0px;
										overflow: hidden;
										border: none;
						" allowfullscreen title="Dailymotion Video Player" allow="web-share">
						</iframe>
					</div>
				}
			}
			<div class="text-content articleDetails" data-content-news-id="@Model.ID" property="articleBody">
				@Html.Raw(Model.Content)
			</div>
		</div>
		@if (Model.TagList.Any())
		{
			<!-- Related Topics Start -->
			<div class="flex flex-wrap text-sm font-semibold mt-4 mb-6 gap-2">
				<span
					class="inline-block text-transparent bg-clip-text bg-gradient-to-r from-[#FF0101] to-[#0D4ABC] shrink-0">İlgili Konular:</span>
				@foreach (var tag in Model.TagList)
				{
					<a href="@tag.Slug" class="text-gray-500 hover:text-black transition-all"> #@Html.Raw(tag.Text) </a>
				}
			</div>
			<!-- Related Topics End -->
			@if (Model.RelatedNewsList.Any())
			{
				<partial name="~/Views/Shared/AdContainers/_GeneralTaboolaTopAdArea.cshtml"/>
			}
		}
		@{
			var pagesBodyEnd = _appSettings.Pages_Body_End;
		}
		@if (!string.IsNullOrWhiteSpace(pagesBodyEnd))
		{
			<div class="md:col-span-4" data-astro-cid-j7pv25f6>
				@Html.Raw(pagesBodyEnd)
			</div>
		}
	</div>
	@await Component.InvokeAsync("News", new NewsViewComponentModel
	{
		MethodName = "MostViewedNews",
		NewsCount = 4
	})
</div>
