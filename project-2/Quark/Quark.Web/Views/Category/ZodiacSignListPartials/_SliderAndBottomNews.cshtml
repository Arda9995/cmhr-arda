	<div class="splide third--slider with-page-numbers mt-6" role="group">
		<div class="splide__track">
			<ul class="splide__list">
				@foreach(var news in Model.ZodiacSignNewsForSlider)
				{
					<li class="splide__slide relative">
						<a class="flex flex-col h-full" href="@news.Slug" data-astro-cid-j7pv25f6>
						<img class="w-full h-56 lg:h-96 object-cover" src="@news.ImageURL" alt="@Html.Raw(news.Headline)" loading="lazy">
						<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-b from-transparent to-black/70 p-2 lg:p-5 flex flex-col items-center justify-center text-center space-y-3">
							@if(news.ShowUpHeadline && !string.IsNullOrEmpty(news.Headline))
							{
								<div class="bg-[#FF0101] text-white py-1 px-3 font-medium text-sm lg:text-xl">@Html.Raw(news.UpHeadline)</div>
							}
							<div class="text-base lg:text-[32px] text-white font-bold lg:leading-tight">@Html.Raw(news.Headline)</div>
						</div>
						</a>
					</li>
				}
			</ul>
		</div>
	</div>
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-4" id="category-news-container">
