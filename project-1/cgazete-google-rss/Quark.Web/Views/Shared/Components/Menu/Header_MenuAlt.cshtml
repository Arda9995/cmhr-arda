@model List<Quark.Web.Models.ViewComponentResponses.MenuItems>


<nav class="flex items-center gap-8 shrink-0 xl:absolute xl:left-1/2 xl:-translate-x-1/2 xl:w-full xl:justify-center" style="z-index:1;">
    @for(int i = 0; i <Model.Count; i++)
    {
        var menu = Model[i];
        var isLast = i == Model.Count - 1;
        <a href="@menu.URL" target="_blank"
        class="text-secondary-500 hover:text-secondary-500/50 transition-all font-semibold relative 
        @(isLast ? "" : "before:absolute before:top-1/2 before:-translate-y-1/2 before:w-px before:bg-[#CECED4] before:rounded-sm before:-right-4 before:h-2")">
        @menu.Name</a>

    }
</nav>