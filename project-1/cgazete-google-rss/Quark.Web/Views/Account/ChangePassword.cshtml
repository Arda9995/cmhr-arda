@model Quark.API.Business.Models.Requests.AccountRequests.ChangePasswordRequest
@{
	Layout = "_LayoutNoAds";
}

<head>
	<meta name="description" content="Reklamsız Cumhuriyet parola değiştirme sayfası.">
	<title>Parola Değiştir - Reklamsız Cumhuriyet</title><!-- Plugins -->
</head>

<partial name="_Header"/>

<!-- MAIN START -->
<main id="main" class="my-4 px-5 tablet:px-0">
	<div class="max-w-container mx-auto space-y-6 max-w-none">
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full font-helvetica">
			<div class="flex flex-col lg:flex-row gap-8"> <!-- Sidebar Navigation -->
				<partial name="~/Views/Account/_AccountSideBar.cshtml" />
				<div class="flex-1">
					<div class="bg-white shadow rounded-lg overflow-hidden">
						<div class="p-6 sm:p-8">
							<h2 class="text-2xl font-bold text-gray-900 mb-8">Parola Değiştir</h2>
							@if (ViewBag.Success == true)
							{
								<div class="p-4 bg-green-50 border border-green-100 rounded-lg text-green-800">
									<p>Parolanız başarıyla değiştirildi.</p>
								</div>
							}
							else
							{
								<form class="space-y-6" asp-action="ChangePassword" asp-controller="Account" method="post">
									<div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
									<div>
										<label for="currentPassword" class="block text-sm font-medium text-gray-700">Mevcut Şifre <span class="text-red-600">*</span></label>
										<input type="password" asp-for="OldPassword" id="currentPassword" required
											   class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-red-500 focus:border-red-500 sm:text-sm">
										<span asp-validation-for="OldPassword" class="text-red-500 text-sm"></span>
									</div>
									<div>
										<label for="newPassword" class="block text-sm font-medium text-gray-700">Yeni Şifre <span class="text-red-600">*</span></label>
										<input type="password" asp-for="NewPassword" id="newPassword" required minlength="6"
											   class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-red-500 focus:border-red-500 sm:text-sm">
										<span asp-validation-for="NewPassword" class="text-red-500 text-sm"></span>
									</div>
									<div>
										<label for="confirmPassword" class="block text-sm font-medium text-gray-700">Yeni Şifre Tekrar <span class="text-red-600">*</span></label>
										<input type="password" asp-for="ConfirmPassword" id="confirmPassword" required minlength="6"
											   class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-red-500 focus:border-red-500 sm:text-sm">
										<span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
									</div>
									<div>
										<button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
											Şifreyi Değiştir
										</button>
									</div>
								</form>
							}
						</div>
					</div>
				</div>
			</div>
		</main>
	</div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

