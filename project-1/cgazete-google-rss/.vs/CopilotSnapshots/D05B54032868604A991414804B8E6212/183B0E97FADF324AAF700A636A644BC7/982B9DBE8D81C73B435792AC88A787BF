ELSE
BEGIN
    UPDATE [dbo].[News.NewsPhotoTypes]
    SET [Key] = 'GoogleAiHighResPhoto',
        [Name] = N'Google AI Yüksek Çözünürlüklü Görsel',
        [Description] = N'Google AI Feed için yüksek çözünürlüklü görsel. Minimum 1600x1200, maksimum 3200x3200.',
        [Width] = 1600,
        [Height] = 1200,
        [IsEnabled] = 1,
        [IsRequired] = 0
    WHERE [ID] = 10;
