<div class="modal fade" tabindex="-1" id="kt_modal_1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">@_localizer["New"] @_localizer["File"]</h3>
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <i class="ki-duotone ki-cross-circle fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <div class="modal-body">
                <input type="hidden"/>
                <div class="row mb-6">
                    <label class="col-lg-4 col-form-label required fw-bold fs-6">@_localizer["Name"]</label>
                    <div class="col-lg-8 fv-row">
                        <input id="folder-name" type="text" class="form-control form-control-lg form-control-solid mb-3 mb-lg-0"/>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">@_localizer["Cancel"]</button>
                <button onclick="AddGallery()" type="submit" class="btn btn-primary">@_localizer["Save"]</button>
            </div>
        </div>
    </div>
</div>
