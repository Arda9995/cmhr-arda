<script>
	document.getElementById("citySelect").addEventListener("change", function () {
		var selectedUrl = this.value;
		if (selectedUrl) {
			window.location.href = selectedUrl;
		}
	});

	// Prayer times countdown functionality
	function updatePrayerTimesCountdown() {
		const todayPrayerTimes = {
			fajr: '@todayPrayerTimes.Fajr',
			sunrise: '@todayPrayerTimes.Sunrise',
			dhuhr: '@todayPrayerTimes.Dhuhr',
			asr: '@todayPrayerTimes.Asr',
			maghrib: '@todayPrayerTimes.Maghrib',
			isha: '@todayPrayerTimes.Isha'
		};

		function getNextPrayerTime() {
			const now = new Date();
			const currentTime = now.getHours() * 60 + now.getMinutes();
			
			const prayerTimes = [
				{ name: 'İmsak', time: convertTimeToMinutes(todayPrayerTimes.fajr) },
				{ name: 'Güneş', time: convertTimeToMinutes(todayPrayerTimes.sunrise) },
				{ name: 'Öğle', time: convertTimeToMinutes(todayPrayerTimes.dhuhr) },
				{ name: 'İkindi', time: convertTimeToMinutes(todayPrayerTimes.asr) },
				{ name: 'Akşam', time: convertTimeToMinutes(todayPrayerTimes.maghrib) },
				{ name: 'Yatsı', time: convertTimeToMinutes(todayPrayerTimes.isha) }
			];

			// Find the next prayer time
			for (let i = 0; i < prayerTimes.length; i++) {
				if (prayerTimes[i].time > currentTime) {
					return prayerTimes[i];
				}
			}
			
			// If all prayers for today are passed, return first prayer of next day
			return prayerTimes[0];
		}

		function convertTimeToMinutes(timeStr) {
			const [hours, minutes] = timeStr.split(':').map(Number);
			return hours * 60 + minutes;
		}

		function formatTime(minutes) {
			const hours = Math.floor(minutes / 60);
			const mins = minutes % 60;
			return `${hours.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}`;
		}

		function updateCountdown() {
			const nextPrayer = getNextPrayerTime();
			const now = new Date();
			const currentTime = now.getHours() * 60 + now.getMinutes();
			
			let timeRemaining = nextPrayer.time - currentTime;
			
			// If time remaining is negative, it means we're past all prayers for today
			if (timeRemaining < 0) {
				timeRemaining += 24 * 60; // Add 24 hours
			}

			const hours = Math.floor(timeRemaining / 60);
			const minutes = timeRemaining % 60;
			const seconds = 60 - now.getSeconds();

			// Update the countdown display
			document.querySelector('.text-blue-800.font-semibold').textContent = `${nextPrayer.name} Vaktine Kalan Süre`;
			document.querySelector('.bg-blue-800.rounded-3xl').innerHTML = `
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M14.3763 3.75H5.6263C5.57105 3.75 5.51806 3.77195 5.47899 3.81102C5.43992 3.85009 5.41797 3.90308 5.41797 3.95833V4.45833C5.42209 4.89465 5.5319 5.32346 5.73799 5.70806C5.94407 6.09266 6.2403 6.42158 6.6013 6.66667L8.33464 7.9C8.68464 8.13167 8.9763 8.44167 9.18464 8.8075C9.39915 9.16829 9.51238 9.58026 9.51238 10C9.51238 10.4197 9.39915 10.8317 9.18464 11.1925C8.9763 11.5575 8.68464 11.8683 8.33464 12.1L6.6013 13.3333C6.2403 13.5784 5.94407 13.9073 5.73799 14.2919C5.5319 14.6765 5.42209 15.1054 5.41797 15.5417V16.0417C5.41797 16.0969 5.43992 16.1499 5.47899 16.189C5.51806 16.2281 5.57105 16.25 5.6263 16.25H14.3763C14.4316 16.25 14.4845 16.2281 14.5236 16.189C14.5627 16.1499 14.5846 16.0969 14.5846 16.0417V15.5417C14.5805 15.1054 14.4707 14.6765 14.2646 14.2919C14.0585 13.9073 13.7623 13.5784 13.4013 13.3333L11.668 12.1C11.3171 11.8687 11.0258 11.5578 10.818 11.1925C10.6034 10.8317 10.4902 10.4197 10.4902 10C10.4902 9.58026 10.6034 9.16829 10.818 8.8075C11.0263 8.4425 11.318 8.13167 11.668 7.9L13.4013 6.66667C13.7623 6.42158 14.0585 6.09266 14.2646 5.70806C14.4707 5.32346 14.5805 4.89465 14.5846 4.45833V3.95833C14.5846 3.90308 14.5627 3.85009 14.5236 3.81102C14.4845 3.77195 14.4316 3.75 14.3763 3.75Z" fill="#FAFAFA"></path>
				</svg>
				${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}
			`;
		}

		// Update countdown every second
		setInterval(updateCountdown, 1000);
		updateCountdown(); // Initial update
	}

	// Start the countdown when the page loads
	document.addEventListener('DOMContentLoaded', updatePrayerTimesCountdown);
</script>