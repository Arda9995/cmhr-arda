
@model MainPageResponse

@{
    var newsList = Model.PageNewsCachingResponses.Where(x => x.BlockKey == "AnaSayfa-SurmansetSlider").ToList();
}

<div class="grid grid-cols-1 md:grid-cols-12 gap-6 slider--area" data-astro-cid-j7pv25f6>
    <div class="md:col-span-8" data-astro-cid-j7pv25f6>
        <div class="splide slider" role="group">
            <div class="splide__track">
                <ul class="splide__list">
                    @foreach (var news in newsList)
                    {
                        <li class="splide__slide relative" data-astro-cid-j7pv25f6>
                            <a target="_blank" tabindex="0" href="@news.NewsSlug" class="block relative h-60"
                               data-astro-cid-j7pv25f6>
                                <div class="absolute inset-0 primary-manset-gradient w-4/5 z-20"
                                     data-astro-cid-j7pv25f6></div>
                                <div class="aspect-[16/9] absolute right-0 top-0 bottom-0" data-astro-cid-j7pv25f6>
                                    <img class="object-cover block w-full h-full" src="@news.NewsPhoto" alt=""
                                         data-astro-cid-j7pv25f6>
                                </div>
                                <div class="absolute inset-0 w-2/3 text-white z-30 p-8 text-3xl font-black space-y-3 flex flex-col justify-center"
                                     data-astro-cid-j7pv25f6>
                                    <div class="text-yellow-500 " data-astro-cid-j7pv25f6>@news.NewsSubHeading</div>
                                    @if (news.ShowUpSubHeading && !string.IsNullOrEmpty(news.NewsUpSubHeading))
                                    {
                                        <div data-astro-cid-j7pv25f6>@news.NewsUpSubHeading</div>
                                    }
                                    else
                                    {
                                        <div data-astro-cid-j7pv25f6>@news.NewsHeadline</div>
                                    }
                                </div>

                            </a>
                        </li>
                    }
                </ul>
                <div>
                   
                </div>
            </div>
            </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(pagesBodyEnd))
            {
                    <div class="shrink-0">
                    @Html.Raw(pagesBodyEnd)
                    </div>
            }
            </div>
