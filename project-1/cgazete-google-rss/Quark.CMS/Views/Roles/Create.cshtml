@{
    ViewData[ViewDataNames.Title] = _localizer["New"] + " " + _localizer["Role"];
    ViewData[ViewDataNames.AsideMenu] = "Management";
    ViewData[ViewDataNames.AsideSubMenu] = "Roles";
    ViewData["ShowBackButton"] = true;
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(@_localizer["Management"], string.Empty),
        new BreadcrumbItem(@_localizer["Roles"], "/Roles/List")
    };
}

@model Quark.CMS.Business.Models.Requests.RoleRequests.CreateUpdateRequest

<div class="card mb-5 mb-xl-10 col-12">
    <div class="card-header border-0">
        <div class="card-title m-0">
            <h3 class="fw-bolder m-0">@_localizer["Role"] @_localizer["Informations"]</h3>
        </div>
    </div>
    <form class="form" method="post">
        <div class="card-body border-top p-9">
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6 required">@_localizer["Name"]</label>
                <div class="col-lg-9 fv-row">
                    <input type="text" asp-for="Name" class="form-control form-control-lg form-control-solid mb-3 mb-lg-0"/>
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Name"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6 required">@_localizer["Description"]</label>
                <div class="col-lg-9 fv-row">
                    <textarea asp-for="Description" class="form-control form-control-lg form-control-solid mb-3 mb-lg-0" rows="4"></textarea>
                    <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="Description"></span>
                    <div class="form-text">@_localizer["AdministratorsForNote"]</div>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6">@_localizer["Rights"]</label>
                <div class="col-lg-9 fv-row">
                    <table class="table table-rounded table-striped border gy-7 gs-7 table-hover">
                        <tbody>
                        @for (var i = 0; i < @Model.SecurityClaims.Count; i++)
                        {
                            <tr>
                                <td class="w-50px flex-center text-center">
                                    <input type="hidden" asp-for="@Model.SecurityClaims[i].Key"/>
                                    <input type="hidden" asp-for="@Model.SecurityClaims[i].Description"/>
                                    <label class="form-check form-switch form-check-custom form-check-solid">
                                        <input class="form-check-input w-40px h-25px" type="checkbox" asp-for="@Model.SecurityClaims[i].IsAllowed"/>
                                    </label>
                                </td>
                                <td>@Model.SecurityClaims[i].Key</td>
                                <td>@Model.SecurityClaims[i].Description</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 col-form-label fw-bold fs-6">@_localizer["Status"]</label>
                <div class="col-lg-9 fv-row">
                    <div class="form-check form-switch form-check-custom form-check-solid mt-2">
                        <input asp-for="IsEnabled" class="form-check-input" type="checkbox"/>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end py-6 px-9">
            <button type="submit" class="btn btn-primary me-2">@_localizer["Save"]</button>
            <a href="/Roles/List" class="btn btn-light btn-light-primary">@_localizer["Cancel"]</a>
        </div>
    </form>
</div>