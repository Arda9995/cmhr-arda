@{
    ViewData[ViewDataNames.Title] = Model.TagName + _localizer["Informations"];
    ViewData[ViewDataNames.AsideMenu] = "Content";
    ViewData[ViewDataNames.AsideSubMenu] = "Tags";
    ViewData["ShowBackButton"] = true;
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(_localizer["Content"], string.Empty),
        new BreadcrumbItem(_localizer["TagManagement"], "/Tags/List")
    };
}

@model Quark.CMS.Business.Models.Responses.TagResponses.DetailsResponse

@section Scripts {
    <script src="/Scripts/Tags/Details.js" asp-append-version="true"></script>
}
<input type="hidden" id="tagId" value="@Model.ID"/>

<div class="card mb-7">
    <div class="card-body">
        <div class="d-flex justify-content-between">
            <p class="text-gray-800 fs-2 fw-bolder me-3">@Model.TagName</p>
            <div>
                <button class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
                    <i class="ki-solid ki-dots-horizontal fs-2x me-1"></i>
                </button>
                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
                    <div class="menu-item px-3">
                        <div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">
                            @_localizer["Actions"]
                        </div>
                    </div>
                    <div class="menu-item px-3">
                        <a href="/Tags/Update/@Model.ID" class="menu-link px-3">
                            @_localizer["Update"]
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="card card-flush">
    <div class="card-header border-0 pt-6">
        <div class="card-title">
            <div class="d-flex align-items-center position-relative my-1">
                <partial name="Icons/Search" />
                <input type="text" data-kt-filter="datatable-search" id="search-value" class="form-control form-control-solid w-250px ps-14" placeholder="@_localizer["Search"]">
            </div>
        </div>
    </div>
    <div class="card-body py-4">
        <table id="datatable">
            <thead>
            <tr>
                <th class="w-75px">@_localizer["News"]</th>
                <th></th>
                <th>@_localizer["Category"]</th>
                <th>@_localizer["NewsType"]</th>
                <th>@_localizer["PublishDate"]</th>
                <th class="text-center">@_localizer["Last15Minutes"]</th>
                <th>@_localizer["Status"]</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            <div style="display:none">
                <div id="Col2">
                    {0}
                </div>
                <div id="Col3">
                    <a href="/News/Details/{0}">{1}</a>
                </div>
                <div id="Col4">
                    {0}
                </div>
                <div id="Col5">
                    {0}
                </div>
                <div id="Col6">
                    {0}
                </div>
                <div id="Col7">
                    <div id="impression_chart_{0}" class="h-50px mt-n8 pe-7" data-kt-chart-color="success"></div>
                </div>
                <div id="Col8">
                    {0}
                </div>
                <div class="text-center" id="Col12">
                    {0}
                </div>
            </div>
            </tbody>
        </table>
    </div>
</div>