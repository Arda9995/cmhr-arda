@model Quark.CMS.Business.Models.Responses.HomeResponses.HomeResponse

@section Scripts
{
    <script src="/Scripts/Home/Index.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
      
            $('#webPushNotificationForm').on('submit', function(e) {
                e.preventDefault();
                
                var formData = {
                    title: $('#webTitle').val(),
                    message: $('#webMessage').val(),
                    iconUrl: $('#iconUrl').val(),
                    url: $('#webUrl').val()
                };
                
                $.ajax({
                    url: '/Home/SendTestWebPushNotification"',
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        var resultDiv = $('#webNotificationResult');
                        var alertDiv = resultDiv.find('.alert');
                        
                        resultDiv.show();
                        if (response.success) {
                            alertDiv.removeClass('alert-danger').addClass('alert-success');
                            alertDiv.text(response.message + ' (notification key ' + response.notificationKey + ')');
                        } else {
                            alertDiv.removeClass('alert-success').addClass('alert-danger');
                            alertDiv.text(response.message);
                        }
                    },
                    error: function() {
                        var resultDiv = $('#webNotificationResult');
                        var alertDiv = resultDiv.find('.alert');
                        
                        resultDiv.show();
                        alertDiv.removeClass('alert-success').addClass('alert-danger');
                        alertDiv.text('An error occurred while sending the web push notification.');
                    }
                });
            });
        });
    </script>
}


