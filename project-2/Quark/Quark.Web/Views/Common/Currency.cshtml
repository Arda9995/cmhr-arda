@using System.Globalization
@using Quark.Web.ViewComponents.Models
@model Quark.API.Business.Models.Responses.CommonResponses.GetCurrencyPageResponse


<partial name="~/Views/Shared/_Header.cshtml" />

<main id="main" class="my-4 px-5 tablet:px-0">
    <div class="max-w-container mx-auto space-y-6 undefined">
        <div class="grid grid-cols-12 gap-6">
            <div class="col-span-12 lg:col-span-8">
                <!-- Breadcrumb Start -->
                <nav class="flex items-center gap-2 text-xs undefined">
                    <a href="/" class="text-gray-500 hover:text-gray-600 transition-all font-medium"> Anasayfa </a><span>
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M6 12L10 8L6 4" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </span><a href="/doviz/1-@Model.SelectedCurrencySlug-kac-tl" class="text-red-600 font-semibold "> Döviz Hesaplama </a>
                </nav> <!-- Breadcrumb End --> <!-- Content Start -->
                <div class="mt-5">
                    <!-- Top Title Start -->
                    <div class="flex gap-2 text-slate-900 text-xs font-semibold items-center">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M17.5 7.08333V14.7917C17.5 15.51 17.2147 16.1988 16.7067 16.7067C16.1988 17.2147 15.51 17.5 14.7917 17.5H5.20833C4.49004 17.5 3.80116 17.2147 3.29325 16.7067C2.78534 16.1988 2.5 15.51 2.5 14.7917V7.08333H17.5ZM6.04167 12.5C5.7654 12.5 5.50045 12.6097 5.3051 12.8051C5.10975 13.0004 5 13.2654 5 13.5417C5 13.8179 5.10975 14.0829 5.3051 14.2782C5.50045 14.4736 5.7654 14.5833 6.04167 14.5833C6.31793 14.5833 6.58289 14.4736 6.77824 14.2782C6.97359 14.0829 7.08333 13.8179 7.08333 13.5417C7.08333 13.2654 6.97359 13.0004 6.77824 12.8051C6.58289 12.6097 6.31793 12.5 6.04167 12.5ZM10 12.5C9.72373 12.5 9.45878 12.6097 9.26343 12.8051C9.06808 13.0004 8.95833 13.2654 8.95833 13.5417C8.95833 13.8179 9.06808 14.0829 9.26343 14.2782C9.45878 14.4736 9.72373 14.5833 10 14.5833C10.2763 14.5833 10.5412 14.4736 10.7366 14.2782C10.9319 14.0829 11.0417 13.8179 11.0417 13.5417C11.0417 13.2654 10.9319 13.0004 10.7366 12.8051C10.5412 12.6097 10.2763 12.5 10 12.5ZM6.04167 8.75C5.7654 8.75 5.50045 8.85975 5.3051 9.0551C5.10975 9.25045 5 9.5154 5 9.79167C5 10.0679 5.10975 10.3329 5.3051 10.5282C5.50045 10.7236 5.7654 10.8333 6.04167 10.8333C6.31793 10.8333 6.58289 10.7236 6.77824 10.5282C6.97359 10.3329 7.08333 10.0679 7.08333 9.79167C7.08333 9.5154 6.97359 9.25045 6.77824 9.0551C6.58289 8.85975 6.31793 8.75 6.04167 8.75ZM10 8.75C9.72373 8.75 9.45878 8.85975 9.26343 9.0551C9.06808 9.25045 8.95833 9.5154 8.95833 9.79167C8.95833 10.0679 9.06808 10.3329 9.26343 10.5282C9.45878 10.7236 9.72373 10.8333 10 10.8333C10.2763 10.8333 10.5412 10.7236 10.7366 10.5282C10.9319 10.3329 11.0417 10.0679 11.0417 9.79167C11.0417 9.5154 10.9319 9.25045 10.7366 9.0551C10.5412 8.85975 10.2763 8.75 10 8.75ZM13.9583 8.75C13.6821 8.75 13.4171 8.85975 13.2218 9.0551C13.0264 9.25045 12.9167 9.5154 12.9167 9.79167C12.9167 10.0679 13.0264 10.3329 13.2218 10.5282C13.4171 10.7236 13.6821 10.8333 13.9583 10.8333C14.2346 10.8333 14.4996 10.7236 14.6949 10.5282C14.8903 10.3329 15 10.0679 15 9.79167C15 9.5154 14.8903 9.25045 14.6949 9.0551C14.4996 8.85975 14.2346 8.75 13.9583 8.75ZM14.7917 2.5C15.51 2.5 16.1988 2.78534 16.7067 3.29325C17.2147 3.80116 17.5 4.49004 17.5 5.20833V5.83333H2.5V5.20833C2.5 4.49004 2.78534 3.80116 3.29325 3.29325C3.80116 2.78534 4.49004 2.5 5.20833 2.5H14.7917Z" fill="#080827"></path>
                        </svg>
                        @{
                            string dayOfWeek = DateTime.Now.ToString("dddd", new CultureInfo("tr-TR"));

                            string formattedDate = DateTime.Now.ToString("dd MMMM yyyy", new CultureInfo("tr-TR"));
                        }

                        @formattedDate @dayOfWeek Döviz Kuru Üzerinden Hesaplama
                    </div> <!-- Top Title End  --> <!-- Form Start -->
                    <div class="grid grid-cols-2 md:flex gap-4 my-4" id="currencyForm">
                        <!-- Currency Type Start -->
                        <!-- <div
                            class="relative md:flex-1 currency-select hidden"
                            id="currencyType">
                            <div
                                class="absolute top-full translate-y-1 w-full divide-y divide-gray-100 border neutral-300 dropdown hidden bg-white">
                                {
                                    currencyTypes.map((item) => (
                                        <button class="px-2 py-1 w-full text-slate-900 font-semibold text-left hover:bg-gray-50">
                                            {item}
                                        </button>
                                    ))
                                }
                            </div>
                        </div> -->
                        <!-- Currency Type End --> <!-- Input Start -->

                        <input id="amountInput" value="@Model.Value" type="text" placeholder="Miktar" class="h-14 bg-neutral-50 border border-gray-100 text-gray-500 font-medium !ring-0 !outline-none px-4 md:flex-1 currency-input"> <!-- Input End  --> <!-- Select Start -->
                        <div class="relative md:flex-1 currency-select bg-neutral-50 border border-gray-100 flex items-center" id="valueType">
                            <select id="currency-select" asp-items="@Model.CurrencySelectListItems" asp-for="SelectedCurrencySlug" class="h-14 bg-transparent text-gray-500 font-medium !ring-0 !outline-none px-4 w-full appearance-none cursor-pointer ">
                                <option value="" disabled selected>Döviz Türü Seçin</option>
                            </select> <svg class="absolute right-3 top-1/2 -translate-y-1/2" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M17.5239 8.87491C17.6232 8.97434 17.6843 9.10542 17.6968 9.24532C17.7093 9.38522 17.6724 9.52508 17.5923 9.64052L17.5239 9.72451L12.1239 15.1245C12.0245 15.2237 11.8934 15.2849 11.7535 15.2974C11.6136 15.3099 11.4738 15.2729 11.3583 15.1929L11.2743 15.1245L5.87434 9.72451C5.76804 9.61869 5.70524 9.47688 5.6983 9.32705C5.69137 9.17721 5.74081 9.03021 5.83688 8.91502C5.93295 8.79982 6.06868 8.72479 6.21733 8.70471C6.36597 8.68462 6.51675 8.72094 6.63995 8.80651L6.72394 8.87491L11.6991 13.8513L16.6743 8.87491C16.7301 8.81904 16.7963 8.77471 16.8692 8.74446C16.9421 8.71421 17.0202 8.69864 17.0991 8.69864C17.1781 8.69864 17.2562 8.71421 17.3291 8.74446C17.402 8.77471 17.4682 8.81904 17.5239 8.87491Z" fill="#080827" stroke="#080827" stroke-width="0.75"></path>
                            </svg>
                        </div> <!-- Select End  --> <!-- Button Start -->

                        <button onclick="calculateCurrency()" class="px-7 py-3.5 bg-neutral-300 border border-gray-700 hover:bg-[#080827] hover:text-white transition-all font-semibold col-span-2" id="submit">Hesapla</button> <!-- Button End  -->
                    </div>
                    <!-- Form End  --> <!-- Result Start -->
                    <div class="my-5 space-y-5 text-center result-screen font-helvetica" id="resultScreen">
                        <div>@Model.Value @Model.SelectedCurrencyName <b>Satış Fiyatı: @Model.SellingValue Türk Lirası</b></div>
                        <div>@Model.Value @Model.SelectedCurrencyName <b>Alış Fiyatı: @Model.BuyingValue Türk Lirası</b></div>
                    </div> <!-- Result End  --> <!-- Text Content Start	 -->
                    <div class="text--content font-helvetica">
                        <b> @Model.Value @Model.SelectedCurrencyName ne kadar? @Model.Value @Model.SelectedCurrencyName kaç TL? Canlı @Model.SelectedCurrencyName alış kuru ve @Model.SelectedCurrencyName satış kuru fiyatı, döviz kuru hesaplama. </b>
                        <p class="!text-sm"> @Model.SelectedCurrencyName kuru bugün itibariyle, <b>alışta 34,5488 TL</b>, <b> satışta 34,5745 TL </b> seviyesinde bulunuyor. @Model.SelectedCurrencyName alış kuru ve @Model.SelectedCurrencyName satış kuru tarihi itibariyle güncellenmiştir. @Model.Value @Model.SelectedCurrencyName <b>34,5745</b> Türk Lirası karşılık gelmektedir. @Model.Value @Model.SelectedCurrencyName karşılığında <b>34,5745</b> Türk Lirası alınabilmektedir. </p> <b>@Model.Value @Model.SelectedCurrencyName serbest piyasa fiyatı ne kadar?</b>
                        <p class="!text-sm"> @Model.SelectedCurrencyName, düne göre %<b>@Model.ChangePercent</b> değişiklik ile, @Model.SelectedCurrencyName alış kuru <b>34,5488</b> TL, @Model.SelectedCurrencyName satış kuru 34,5745 TL’dir. @Model.SelectedCurrencyName kuru en son tarihinde güncellenmiştir. </p>
                    </div> <!-- Text Content End  --> <!-- Links Start -->
                    <div class="mt-4 grid grid-cols-1 xs:grid-cols-2 md:grid-cols-3 gap-y-2 xs:gap-x-6 xs:gap-y-5">
                        <a href="/doviz/@Model.Value-@Model.SelectedCurrencySlug-kac-tl" class="px-3 py-1 bg-gray-200 text-gray-700 font-semibold text-center transition-all hover:bg-black hover:text-white block"> @Model.Value @Model.SelectedCurrencyName Kaç TL? </a>
                        <a href="/doviz/10-@Model.SelectedCurrencySlug-kac-tl" class="px-3 py-1 bg-gray-200 text-gray-700 font-semibold text-center transition-all hover:bg-black hover:text-white block"> 10 @Model.SelectedCurrencyName Kaç TL ? </a>
                        <a href="/doviz/240-@Model.SelectedCurrencySlug-kac-tl" class="px-3 py-1 bg-gray-200 text-gray-700 font-semibold text-center transition-all hover:bg-black hover:text-white block"> 240 @Model.SelectedCurrencyName Kaç TL ? </a>
                        <a href="/doviz/500-@Model.SelectedCurrencySlug-kac-tl" class="px-3 py-1 bg-gray-200 text-gray-700 font-semibold text-center transition-all hover:bg-black hover:text-white block"> 500 @Model.SelectedCurrencyName Kaç TL ? </a>
                        <a href="/doviz/420-@Model.SelectedCurrencySlug-kac-tl" class="px-3 py-1 bg-gray-200 text-gray-700 font-semibold text-center transition-all hover:bg-black hover:text-white block"> 420 @Model.SelectedCurrencyName Kaç TL ? </a>
                        <a href="/doviz/350-@Model.SelectedCurrencySlug-kac-tl" class="px-3 py-1 bg-gray-200 text-gray-700 font-semibold text-center transition-all hover:bg-black hover:text-white block"> 350 @Model.SelectedCurrencyName Kaç TL ? </a>
                        <a href="/doviz/870-@Model.SelectedCurrencySlug-kac-tl" class="px-3 py-1 bg-gray-200 text-gray-700 font-semibold text-center transition-all hover:bg-black hover:text-white block"> 870 @Model.SelectedCurrencyName Kaç TL ? </a>
                        <a href="/doviz/950-@Model.SelectedCurrencySlug-kac-tl" class="px-3 py-1 bg-gray-200 text-gray-700 font-semibold text-center transition-all hover:bg-black hover:text-white block"> 950 @Model.SelectedCurrencyName Kaç TL ? </a>
                        <a href="/doviz/600-@Model.SelectedCurrencySlug-kac-tl" class="px-3 py-1 bg-gray-200 text-gray-700 font-semibold text-center transition-all hover:bg-black hover:text-white block"> 600 @Model.SelectedCurrencyName Kaç TL ? </a>
                    </div> <!-- Links End  --> <!-- Ad Start -->
                    <div class="ads-box" style=""> <img class="mt-5 mx-auto mx-auto" src="https://placehold.co/480x320" alt="" loading="lazy"> </div> <!-- Ad End -->
                </div> <!-- Content End  -->
            </div>
            @await Component.InvokeAsync("News", new NewsViewComponentModel { MethodName = "CategoryListMostViewedNews", NewsCount = 4 })

        </div>
        <div class="mt-6 col-span-12">
            <!-- Title Start -->
            <div class="flex items-center lg:gap-3 mb-4 undefined">
                <span class="w-6 h-1 rounded-full bg-[#14A41C] lg:bg-[#FF0101] mr-3 lg:mr-0"></span>
                <h3 class="text-slate-900 text-sm lg:text-xl font-semibold mr-6 lg:mr-0">Döviz Haberleri</h3> <span class="h-0.5 bg-[#E5E5EA] flex-1 mr-3 lg:mr-0"></span>
            </div> <!-- Title End --> <!-- List Start -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <!-- Item Start -->
                @foreach (var news in Model.CurrencyNews)
                {
                    <div class="space-y-1 group relative">
                        <button onclick="saveNewsID(@news.ID)" class="opacity-0 group-hover:opacity-100 transition-all duration-500 font-semibold text-sm z-10 absolute right-3 top-3 bg-white/70 size-7 flex items-center justify-center rounded-lg">
                            <svg width="12" height="16" viewBox="0 0 12 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M0 2.5C0 1.83696 0.263392 1.20107 0.732233 0.732233C1.20107 0.263392 1.83696 0 2.5 0H9.5C10.163 0 10.7989 0.263392 11.2678 0.732233C11.7366 1.20107 12 1.83696 12 2.5V15.5C11.9999 15.5922 11.9744 15.6826 11.9261 15.7611C11.8779 15.8397 11.8089 15.9034 11.7267 15.9452C11.6446 15.987 11.5525 16.0053 11.4606 15.998C11.3687 15.9907 11.2806 15.9582 11.206 15.904L6 12.118L0.794 15.904C0.719435 15.9582 0.631335 15.9907 0.539436 15.998C0.447537 16.0053 0.355417 15.987 0.273255 15.9452C0.191094 15.9034 0.122089 15.8397 0.0738659 15.7611C0.0256429 15.6826 7.93406e-05 15.5922 0 15.5V2.5ZM2.5 1C2.10218 1 1.72064 1.15804 1.43934 1.43934C1.15804 1.72064 1 2.10218 1 2.5V14.518L5.706 11.096C5.79144 11.0339 5.89436 11.0004 6 11.0004C6.10564 11.0004 6.20856 11.0339 6.294 11.096L11 14.518V2.5C11 2.10218 10.842 1.72064 10.5607 1.43934C10.2794 1.15804 9.89782 1 9.5 1H2.5Z" fill="#FF0101"></path>
                            </svg>
                        </button> <!-- Thumbnail Start -->

                        <a href="@news.Slug" class="overflow-hidden aspect-[16/9] block">
                            <img src="@news.ImageURL" class="w-full h-full animate-img" alt="@news.Headline" loading="lazy">
                        </a> <!-- Thumnbanil End --> <!-- Title Start -->

                        <a href="@news.Slug" class="line-clamp-3 text-secondary-500 font-semibold"> @news.UpSubtitle </a> <!-- Title End -->
                    </div> <!-- Item End -->
                    <!-- Item Start -->
                }
            </div> <!-- List End -->
        </div>
    </div>
</main>