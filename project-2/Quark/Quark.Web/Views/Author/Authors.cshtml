					{
						<div data-filter="@author.FullName" class="p-4 bg-neutral-50 hover:bg-[#F2F2F7] flex gap-3 transition-all post">
							<div class="text-center space-y-3 shrink-0">
								<!-- Image Start -->
								<a href="@author.Slug"> 
