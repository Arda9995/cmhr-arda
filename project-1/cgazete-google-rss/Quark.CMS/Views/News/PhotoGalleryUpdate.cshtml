@{
    Layout = "_Layout";
    ViewData[ViewDataNames.Title] = _localizer["PhotoGallery"] +" " + _localizer["Update"];
    ViewData[ViewDataNames.AsideMenu] = "News";
    ViewData[ViewDataNames.AsideSubMenu] = "News";
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Haberler", "/News/List")
    };
}

@model Quark.CMS.Business.Models.Requests.NewsRequests.NewsRequest

@section Styles{
<link href="https://metronic.b-cdn.net/8.1.5/assets/plugins/custom/jstree/jstree.bundle.css" rel="stylesheet" type="text/css"/>
}

@section Scripts
{
    <script src="https://metronic.avvamobile.com/8.1.9/assets/plugins/custom/formrepeater/formrepeater.bundle.js"></script>
<script src="/Scripts/News/Update.js" asp-append-version="true"></script>
    <partial name="_NewsEditScriptFiles"/>
    <script src="/Scripts/News/Category.js" asp-append-version="true"></script>
}

<p id="promptResult"></p>

<form method="post" class="form row g-10" enctype="multipart/form-data" id="newsFormCreate">
    
    <input asp-for="@Model.NewsTypeID" type="hidden"/>
    <input id="url-prefix" type="hidden" value="@_appSettings.News_URLSchema"/>


    <div class="row justify-content-between mt-5">
        <div class="col-auto">
            <a onclick="history.back()" class="btn btn-sm btn-secondary">
                <i class="ki-outline ki-left"></i> @_localizer["GoBack"]
            </a>
        </div>
        <div class="col-auto">
            <button asp-action="Update" asp-controller="News" type="submit" class="btn btn-primary">@_localizer["Save"]</button>
            <a onclick="CancelUpdate(@Model.ID)" class="btn btn-light btn-light-primary">@_localizer["Cancel"]</a>
        </div>
    </div>
    
    
    <!--begin::Content-->
    <div class="col-12">
        <partial name="_Edit/_Category" />
        <div class="card card-flush mb-10">
            <div class="card-header">
                <div class="card-title d-block mt-5 mb-5">
                    <h2 >@_localizer["NewsType"] : @Model.NewsTypeName</h2>
                </div>
            </div>
            <div class="card-body pt-0">
                <partial name="_Edit/_Title" model="Model"/>
                <partial name="_Edit/_UpHeadline" model="Model" />
                <partial name="_Edit/_Headline" model="Model" />
                <partial name="_Edit/_UpSubHeading" model="Model" />
                <partial name="_Edit/_SubHeading" model="Model" />
                <partial name="_Edit/_PhotoGallery/_Subtitle" model="Model"/>
                <partial name="_Edit/_Seo" model="Model"/>
                <div class="d-flex justify-content-between mb-10 gap-5">
                    <partial name="_Edit/_Tags" />
                    <partial name="_Edit/_Source" />
                </div>
                <partial name="_Edit/_PublishDate" model="Model" />
                <partial name="_Edit/_Url" model="Model" />
                <partial name="_Edit/_ManuelUpdatedDate" model="Model" />
            </div>
        </div>

        <partial name="_Edit/_Permissions" model="Model" />
        <partial name="_Edit/_Video" model="Model" />
        <partial name="_Edit/_PhotoUpload" />
    </div>

    <!--end::Content-->

</form>
<partial name="_Edit/_PhotoEditModal"/>
<partial name="_Edit/_MediaGallery"/> 
<partial name="_Edit/_MainCategoryJsTree"/>
<partial name="_Edit/_SecondaryCategoryJsTree"/>