@{
    ViewData[ViewDataNames.Title] = _localizer["Books"];
    ViewData[ViewDataNames.AsideMenu] = "Content";
    ViewData[ViewDataNames.AsideSubMenu] = "Books";
    ViewData["ShowBackButton"] = true;
    ViewData[ViewDataNames.Breadcrumb] = new List<BreadcrumbItem>
    {
        new BreadcrumbItem(@_localizer["Content"], string.Empty),
        new BreadcrumbItem(@_localizer["Books"], "/Books/List")
    };
}

@model Quark.CMS.Business.Models.Responses.BookResponses.BookDetailsResponse

<div class="card mb-5 mb-xl-10 col-12">
    <div class="card-header border-0">
        <div class="card-title m-0">
            <h3 class="fw-bolder m-0">@_localizer["BookInformation"]</h3>
        </div>
        <div class="d-flex justify-content-center pt-lg-5">
            <div>
                <button class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
                    <i class="ki-solid ki-dots-horizontal fs-2x me-1"></i>
                </button>
                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
                    <div class="menu-item px-3">
                        <a href="/Books/Update/@Model.ID" class="menu-link px-3">
                            @_localizer["Update"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form class="form" method="post" enctype="multipart/form-data" id="booksForm">
        <input type="hidden" asp-for="ID" />
        <div class="card-body top p-9">
            <div class="row mb-6">
                <label class="col-lg-3 fw-semibold text-muted">@_localizer["Image"]</label>
                <div class="col-lg-8">
                    <div class="image-input image-input-outline" data-kt-image-input="true">
                        <div id="backgroundPhoto" class="image-input-wrapper w-125px h-125px bgi-position-center" style="background-size: 75%;
                            background-image: url('@(Model.ImageURL)')">
                        </div>
                    </div>
                    <span class="fv-plugins-message-container invalid-feedback" id="imageValidation"></span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 fw-semibold text-muted">@_localizer["BookName"]</label>
                <div class="col-lg-9 fv-row">
                    <span class="fw-bold fs-6 text-gray-800">@Model.Name</span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 fw-semibold text-muted">@_localizer["Author"]</label>
                <div class="col-lg-9 fv-row">
                    <span class="fw-bold fs-6 text-gray-800">@Model.Author</span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 fw-semibold text-muted">@_localizer["Description"]</label>
                <div class="col-lg-9 fv-row">
                    <span class="fw-bold fs-6 text-gray-800" >@Model.Description</span>
                </div>
            </div>


            <div class="row mb-6">
                <label class="col-lg-3 fw-semibold text-muted">@_localizer["Url"]</label>
                <div class="col-lg-9 fv-row">
                    <a href="@Model.Slug" class="fw-bold fs-6 text-gray-800" target="_blank"> @Model.Slug </a>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 fw-semibold text-muted">@_localizer["SeoTitle"]</label>
                <div class="col-lg-9 fv-row">
                    <span class="fw-bold fs-6 text-gray-800">@Model.SeoTitle</span>
                </div>
            </div>
            <div class="row mb-6">
                <label class="col-lg-3 fw-semibold text-muted">@_localizer["SeoDescription"]</label>
                <div class="col-lg-9 fv-row">
                    <span class="fw-bold fs-6 text-gray-800">@Model.SeoDescription</span>
                </div>
            </div>
        </div>
    </form>
</div>
