@using Quark.Data.Models
@model Quark.API.Business.Models.Responses.CommonResponses.GetTodayCurrencyDataResponse


<div class="splide mobile-cryptos-area bg-slate-900 py-2 mt-4 mb-5" role="group">
	<div class="splide__track">
		<ul class="splide__list">

			@foreach(var currency in Model.TodayCurrencyDataItems)
			{
				<li class="splide__slide">
					<!-- Item Start -->
					<div class="flex items-center gap-1 font-semibold text-white relative after:absolute after:w-1 after:h-1 after:-right-3.5 after:bg-secondary-500/40 after:rounded-full">
						<span>@currency.CurrencyName</span> <span>@currency.CurrencyValue</span>

						@if (currency.Status == (int)CurrencyStateEnum.Increased)
						{
							<svg class="shrink-0" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
