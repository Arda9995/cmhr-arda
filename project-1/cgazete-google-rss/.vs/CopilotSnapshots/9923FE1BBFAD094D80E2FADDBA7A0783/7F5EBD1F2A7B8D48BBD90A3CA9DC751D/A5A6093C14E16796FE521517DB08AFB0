        public async Task<ServiceResult> RefreshNewsSiteMap()
        {
            var result = new ServiceResult();
            try
            {
                var news = await _context.NewsPublished
                    .Where(n => n.PublishedDate >= DateTime.Now.AddHours(-48))
                    .Where(n => n.AllowToSendGoogleSideMap)
                    .OrderByDescending(n => n.PublishedDate)
                    .Select(n => new
                    {
                        n.Slug,
                        n.PublishedDate,
                        n.Title,
                        n.CategoryID
                    })
                    .ToListAsync();

                var newsNs = XNamespace.Get("http://www.google.com/schemas/sitemap-news/0.9");
                var sitemapNs = XNamespace.Get("http://www.sitemaps.org/schemas/sitemap/0.9");

                var sitemap = new XDocument(
                    new XDeclaration("1.0", "utf-8", null),
                    new XElement(sitemapNs + "urlset",
                        new XAttribute(XNamespace.Xmlns + "news", newsNs)));

                foreach (var item in news)
                {
                    sitemap.Root.Add(
                        new XElement(sitemapNs + "url",
                            new XElement(sitemapNs + "loc",
                                item.Slug.PrepareWebsiteUrl(_appSettingsKeys.Common_ClientWebSite)),
                            new XElement(newsNs + "news",
                                new XElement(newsNs + "publication",
                                    new XElement(newsNs + "name", "Cumhuriyet"),
                                    new XElement(newsNs + "language", "tr")),
                                new XElement(newsNs + "publication_date",
                                    ConvertToIso8601WithOffset(item.PublishedDate)),
                                new XElement(newsNs + "title", item.Title))));
                }

                await CacheXmlAsync(sitemap,
                    ((int)ElasticSitemapKeysEnum.NewsSitemapKey).ToString(),
                    ElasticSitemapKeys.NewsSitemapKey, IndexNames.Sitemaps);
            }
            catch (Exception ex)
            {
                result.Message = ex.Message;
            }

            return result;
        }

        public async Task<ServiceResult> RefreshPostsSiteMap()
        {
            var result = new ServiceResult();
            try
            {
                var sitemapNs = XNamespace.Get("http://www.sitemaps.org/schemas/sitemap/0.9");

                var sitemapResults = await _context.NewsPublished
                    .Where(n => n.AllowToSendGoogleSideMap)
                    .GroupBy(n => new { n.PublishedDate.Year, n.PublishedDate.Month })
                    .Select(g => new
                    {
                        PublishedYear = g.Key.Year,
                        PublishedMonth = g.Key.Month,
                        LastModifiedDate = g
                            .Select(n => n.ManuelUpdatedDate < n.PublishedDate ? n.PublishedDate : n.ManuelUpdatedDate)
                            .Max()
                    })
                    .OrderByDescending(x => x.PublishedYear)
                    .ThenByDescending(x => x.PublishedMonth)
                    .ToListAsync();

                var sitemap = new XDocument(
                    new XDeclaration("1.0", "utf-8", null),
                    new XElement(sitemapNs + "sitemapindex"));

                foreach (var sitemapItem in sitemapResults)
                {
                    sitemap.Root.Add(
                        new XElement(sitemapNs + "sitemap",
                            new XElement(sitemapNs + "loc",
                                $"{_siteUrl.TrimEnd('/')}/sitemaps/posts-{sitemapItem.PublishedYear}-{sitemapItem.PublishedMonth}.xml"),
                            new XElement(sitemapNs + "lastmod",
                                ConvertToIso8601WithOffset((DateTime)sitemapItem.LastModifiedDate))));
                }

                await CacheXmlAsync(sitemap,
                    ((int)ElasticSitemapKeysEnum.PostsSitemapKey).ToString(),
                    ElasticSitemapKeys.PostsSitemapKey, IndexNames.Sitemaps);
            }
            catch (Exception ex)
            {
                result.Message = ex.Message;
            }

            return result;
        }

        public async Task<ServiceResult> RefreshTagsSiteMap()
        {
            var result = new ServiceResult();
            try
            {
                var sitemapNs = XNamespace.Get("http://www.sitemaps.org/schemas/sitemap/0.9");

                var sitemapResults = await (
                    from nt in _context.NewsTags
                    join t in _context.Tags on nt.TagID equals t.ID
                    join n in _context.NewsPublished on nt.NewsID equals n.NewsID
                    where n.AllowToSendGoogleSideMap
                    group n by new { t.CreatedDate.Value.Year, t.CreatedDate.Value.Month }
                    into g
                    orderby g.Key.Year descending, g.Key.Month descending
                    select new
                    {
                        TagCreatedYear = g.Key.Year,
                        TagCreatedMonth = g.Key.Month,
                        LastModifiedDate = g.Max(item => item.ManuelUpdatedDate)
                    }).ToListAsync();

                var sitemap = new XDocument(
                    new XDeclaration("1.0", "utf-8", null),
                    new XElement(sitemapNs + "sitemapindex"));

                foreach (var sitemapItem in sitemapResults)
                {
                    sitemap.Root.Add(
                        new XElement(sitemapNs + "sitemap",
                            new XElement(sitemapNs + "loc",
                                $"{_siteUrl.TrimEnd('/')}/sitemaps/tag-{sitemapItem.TagCreatedYear}-{sitemapItem.TagCreatedMonth}.xml"),
                            new XElement(sitemapNs + "lastmod",
                                ConvertToIso8601WithOffset((DateTime)sitemapItem.LastModifiedDate))));
                }

                await CacheXmlAsync(sitemap,
                    ((int)ElasticSitemapKeysEnum.TagsSitemapKey).ToString(),
                    ElasticSitemapKeys.TagsSitemapKey, IndexNames.Sitemaps);
            }
            catch (Exception ex)
            {
                result.Message = ex.Message;
            }

            return result;
        }

        public async Task<ServiceResult> RefreshSourcesSiteMap()
        {
            var result = new ServiceResult();
            try
            {
                var now = DateTime.Now;

                var sitemapResults = (await (
                    from nt in _context.NewsSources
                    join ns in _context.Sources on nt.SourceID equals ns.ID
                    join n in _context.NewsPublished.Select(x => new
                        { x.NewsID, x.AllowToSendGoogleSideMap, x.ManuelUpdatedDate, x.Slug }) on nt.NewsID equals n
                        .NewsID
                    where n.AllowToSendGoogleSideMap
                    group new { ns, n } by new { ns.Url }
                    into g
                    select new
                    {
                        Slug = g.Select(n => n.ns.Url).FirstOrDefault(),
                        LastModifiedDate = g.Max(item => item.n.ManuelUpdatedDate)
                    }).ToListAsync()).Select(item =>
                {
                    var lastMod = item.LastModifiedDate;
                    var daysDiff = (now - lastMod).Value.TotalDays;
                    var hoursDiff = (now - lastMod).Value.TotalHours;

                    string changefreq;
                    string priority;

                    if (hoursDiff <= 24)
                    {
                        changefreq = "always";
                        priority = "1.0";
                    }
                    else if (hoursDiff <= 48)
                    {
                        changefreq = "hourly";
                        priority = "0.9";
                    }
                    else if (daysDiff <= 7)
                    {
                        changefreq = "daily";
                        priority = "0.8";
                    }
                    else if (daysDiff <= 30)
                    {
                        changefreq = "weekly";
                        priority = "0.7";
                    }
                    else if (daysDiff <= 365)
                    {
                        changefreq = "monthly";
                        priority = "0.6";
                    }
                    else
                    {
                        changefreq = "yearly";
                        priority = "0.5";
                    }

                    return new
                    {
                        LastMod = ConvertToIso8601WithOffset((DateTime)lastMod),
                        ChangeFreq = changefreq,
                        Priority = priority,
                        Slug = item.Slug
                    };
                }).OrderByDescending(x => x.LastMod).ToList();

                var sitemapNs = XNamespace.Get("http://www.sitemaps.org/schemas/sitemap/0.9");

                var sitemap = new XDocument(
                    new XDeclaration("1.0", "utf-8", null),
                    new XElement(sitemapNs + "urlset"));

                sitemapResults = sitemapResults.Where(x =>
                    x.ChangeFreq != null
                    && x.LastMod != null
                    && x.Priority != null
                    && x.Slug != null).ToList();

                foreach (var source in sitemapResults)
                {
                    sitemap.Root.Add(
                        new XElement(sitemapNs + "url",
                            new XElement(sitemapNs + "loc",
                                $"{_appSettingsKeys.Common_ClientWebSite.TrimStart('/') + _appSettingsKeys.SlugPrefix_Sources.TrimStart('/') + "/" + source.Slug.TrimStart('/')}"),
                            new XElement(sitemapNs + "changefreq", source.ChangeFreq),
                            new XElement(sitemapNs + "priority", source.Priority)));
                }

                await CacheXmlAsync(sitemap,
                    ((int)ElasticSitemapKeysEnum.SourceSitemapKey).ToString(),
                    ElasticSitemapKeys.SourceSitemapKey, IndexNames.Sitemaps);
            }
            catch (Exception ex)
            {
                result.Message = ex.Message;
            }

            return result;
        }

        public async Task<ServiceResult> RefreshMainRSS()
        {
            var result = new ServiceResult();
            try
            {
                var news = await (from np in _context.NewsPublished
                    let photo = (from ph in _context.NewsPublishedPhotos
                        where ph.NewsID == np.NewsID &&
                              (ph.PhotoTypeID == (int)NewsPhotoTypesEnum.MainPhoto ||
                               ph.PhotoTypeID == (int)NewsPhotoTypesEnum.CoverPhoto)
                        orderby
                            ph.PhotoTypeID == (int)NewsPhotoTypesEnum.MainPhoto && !string.IsNullOrEmpty(ph.PhotoUrl)
                                ? 0
                                : ph.PhotoTypeID == (int)NewsPhotoTypesEnum.CoverPhoto &&
                                  !string.IsNullOrEmpty(ph.PhotoUrl)
                                    ? 1
                                    : 2
                        select ph).FirstOrDefault()
                    where np.AllowToSendRSS
                    select new
                    {
                        Title = !string.IsNullOrEmpty(np.Title)
                            ? np.Title
                            : (!string.IsNullOrEmpty(np.Headline) ? np.Headline : string.Empty),
                        Subtitle = !string.IsNullOrEmpty(np.Subtitle)
                            ? np.Subtitle
                            : (!string.IsNullOrEmpty(np.UpSubtitle)
                                ? np.UpSubtitle
                                : (!string.IsNullOrEmpty(np.Content)
                                    ? np.Content.ExtractTextFromHtml()
                                    : string.Empty)),
                        Slug = !string.IsNullOrEmpty(np.Slug) ? np.Slug : string.Empty,
                        PublishedDate = np.PublishedDate,
                        ImageURL = photo != null && !string.IsNullOrEmpty(photo.PhotoUrl)
                            ? photo.PhotoUrl.TrimStart('/').PrepareCDNUrl(_appSettingsKeys.CDN_BaseUrl,
                                _appSettingsKeys.CDN_MediaGalleryFolder)
                            : "https://media.cumhuriyet.com.tr/cumhuriyet-noimage.jpg",
                    }).OrderByDescending(x => x.PublishedDate).Take(MAX_RSS_ITEMS).ToListAsync();

                var rss = CreateRssDocument("Cumhuriyet Gazetesi", _siteUrl, "Cumhuriyet Gazetesi", "tr-TR",
                    $"{_siteUrl.TrimEnd('/')}/rss", DateTime.Now, DateTime.Now);

                foreach (var item in news)
                {
                    rss.Root.Element("channel").Add(
                        CreateRssItem(item.Title, $"{_siteUrl.TrimEnd('/')}/{item.Slug}",
                            $"{_siteUrl.TrimEnd('/')}/{item.Slug.TrimStart('/')}",
                            item.PublishedDate, item.ImageURL, "720", "1280",
                            new XElement("description", new XCData(item.Subtitle))));
                }

                await CacheXmlAsync(rss,
                    ((int)ElasticRssKeysEnum.MainRssKey).ToString(),
                    ElasticRssKeys.MainRssKey, IndexNames.MainRSS);
            }
            catch (Exception ex)
            {
                result.Message = ex.Message;
            }

            return result;
        }

        public async Task<ServiceResult> RefreshCategoryRSS(string category)
        {
            var result = new ServiceResult();
            try
            {
                var categoryEntity = await _context.Categories
                    .FirstOrDefaultAsync(c => c.Url == category);

                if (categoryEntity == null)
                    return result;

                bool isColumnArticleCategory = categoryEntity.ID == (int)CategoryEnum.Authors;

                var news = await (from np in _context.NewsPublished
                    join c in _context.Categories on np.CategoryID equals c.ID into cat
                    from c in cat.DefaultIfEmpty()
                    let photo = (from ph in _context.NewsPublishedPhotos
                        where ph.NewsID == np.NewsID &&
                              (ph.PhotoTypeID == (int)NewsPhotoTypesEnum.MainPhoto ||
                               ph.PhotoTypeID == (int)NewsPhotoTypesEnum.CoverPhoto)
                        orderby
                            ph.PhotoTypeID == (int)NewsPhotoTypesEnum.MainPhoto && !string.IsNullOrEmpty(ph.PhotoUrl)
                                ? 0
                                : ph.PhotoTypeID == (int)NewsPhotoTypesEnum.CoverPhoto &&
                                  !string.IsNullOrEmpty(ph.PhotoUrl)
                                    ? 1
                                    : 2
                        select ph).FirstOrDefault()
                    where np.AllowToSendRSS && (isColumnArticleCategory
                        ? np.NewsTypeID == (int)NewsTypesEnum.ColumnArticles
                        : np.CategoryID == categoryEntity.ID)
                    select new
                    {
                        Title = !string.IsNullOrEmpty(np.Title)
                            ? np.Title
                            : (!string.IsNullOrEmpty(np.Headline) ? np.Headline : string.Empty),
                        Subtitle = !string.IsNullOrEmpty(np.Subtitle)
                            ? np.Subtitle
                            : (!string.IsNullOrEmpty(np.UpSubtitle)
                                ? np.UpSubtitle
                                : (!string.IsNullOrEmpty(np.Content)
                                    ? np.Content.ExtractTextFromHtml()
                                    : string.Empty)),
                        Slug = !string.IsNullOrEmpty(np.Slug) ? np.Slug : string.Empty,
                        PublishedDate = np.PublishedDate,
                        CategoryName = c != null && !string.IsNullOrEmpty(c.Name) ? c.Name : string.Empty,
                        ImageURL = photo != null && !string.IsNullOrEmpty(photo.PhotoUrl)
