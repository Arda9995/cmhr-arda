@using Quark.Business.Caching.Models.Responses.NewsCachingResponses
@model MainPageResponse
@{
    var survey = Model.PageNewsCachingResponses.Where(x => x.BlockKey == "AnaSayfa-AnketHaberi").FirstOrDefault();

    var underAuthors2 = Model.PageNewsCachingResponses.Where(x => x.BlockKey == "Anasayfa-YazarAlti").Take(2).ToList();
    var underAuthors4 = Model.PageNewsCachingResponses.Where(x => x.BlockKey ==
                                                                  "Anasayfa-YazarAlti").Skip(2).Take(6).ToList();

    var daily2 = Model.PageNewsCachingResponses.Where(x => x.BlockKey == "AnaSayfa-GundemHaberleri").Take(2).ToList();
    var daily4 = Model.PageNewsCachingResponses.Where(x => x.BlockKey ==
                                                           "AnaSayfa-GundemHaberleri").Skip(2).Take(6).ToList();
}


<div class="px-5 mt-4">
    <!-- Poll Start -->

    @if (survey != null && survey.SurveyItem != null)
    {
        <a href="@survey.NewsSlug" target="_blank" class="primary-gradient p-3 text-white block">
            <!-- Title Start -->
            <div class="flex items-center gap-4 justify-between">
                <span class="font-semibold">Cumhuriyet Soruyor?</span>
                <!-- <span class="flex-1 bg-gradient-to-r from-white to-transparent h-px"></span> -->

                <span
                    class="text-sm text-[#72C877] font-helvetica">@survey.SurveyItem.JoinedUserCount kişi katıldı</span>
            </div> <!-- Title End -->
            <div class="flex gap-3 items-end mt-2">
                <!-- Text Start -->
                <div class="font-medium line-clamp-2">@survey.SurveyItem.Question</div> <!-- Text End -->
                <!-- Button Start -->
                <div class="flex justify-end">
                    <div class="font-bold">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M6.07794 2.74405C6.22144 2.60057 6.41235 2.51438 6.61487 2.50164C6.8174 2.48891 7.01761 2.55051 7.17794 2.67488L7.25628 2.74405L13.9229 9.41072C14.0664 9.55421 14.1526 9.74513 14.1653 9.94765C14.1781 10.1502 14.1165 10.3504 13.9921 10.5107L13.9229 10.5891L7.25628 17.2557C7.10631 17.4052 6.90508 17.4919 6.69346 17.4984C6.48183 17.5049 6.27568 17.4305 6.11688 17.2905C5.95807 17.1505 5.85852 16.9553 5.83844 16.7445C5.81837 16.5337 5.87926 16.3232 6.00877 16.1557L6.07794 16.0774L12.1554 9.99989L6.07794 3.92238C5.92171 3.76611 5.83395 3.55419 5.83395 3.33322C5.83395 3.11225 5.92171 2.90032 6.07794 2.74405Z"
                                fill="#F2F2F7"></path>
                        </svg>
                    </div>
                </div> <!-- Button End -->
            </div>
        </a>
        <!-- Poll End -->
    }
    <!-- Items Start -->
    <!-- Authors Start -->
    <div class="px-5 py-4 bg-neutral-50 mt-4 mb-5">
        <!-- Title Start -->
        <div class="text-slate-900 font-semibold text-center mb-5"> Cumhuriyet Gazetesi Yazarları</div>
        <!-- Title End --> <!-- Slider Start -->
        <div class="splide authors--slider" role="group">
            <div
                class="splide__arrows absolute top-1/2 -translate-y-1/2 flex items-center justify-between z-10 w-[calc(100%+40px)] -left-5">
                <button class="prev splide__arrow--prev rotate-180">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M13.9221 2.74405C13.7786 2.60057 13.5876 2.51438 13.3851 2.50164C13.1826 2.48891 12.9824 2.55051 12.8221 2.67488L12.7437 2.74405L6.07706 9.41072C5.93358 9.55421 5.84739 9.74513 5.83465 9.94765C5.82192 10.1502 5.88352 10.3504 6.00789 10.5107L6.07706 10.5891L12.7437 17.2557C12.8937 17.4052 13.0949 17.4919 13.3065 17.4984C13.5182 17.5049 13.7243 17.4305 13.8831 17.2905C14.0419 17.1505 14.1415 16.9553 14.1616 16.7445C14.1816 16.5337 14.1207 16.3232 13.9912 16.1557L13.9221 16.0774L7.84456 9.99989L13.9221 3.92238C14.0783 3.76611 14.166 3.55419 14.166 3.33322C14.166 3.11225 14.0783 2.90032 13.9221 2.74405Z"
                            fill="#080827"></path>
                    </svg>
                </button>
                <button class="next splide__arrow--next -right-5">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M6.07794 2.74405C6.22144 2.60057 6.41235 2.51438 6.61487 2.50164C6.8174 2.48891 7.01761 2.55051 7.17794 2.67488L7.25628 2.74405L13.9229 9.41072C14.0664 9.55421 14.1526 9.74513 14.1653 9.94765C14.1781 10.1502 14.1165 10.3504 13.9921 10.5107L13.9229 10.5891L7.25628 17.2557C7.10631 17.4052 6.90508 17.4919 6.69346 17.4984C6.48183 17.5049 6.27568 17.4305 6.11688 17.2905C5.95807 17.1505 5.85852 16.9553 5.83844 16.7445C5.81837 16.5337 5.87926 16.3232 6.00877 16.1557L6.07794 16.0774L12.1554 9.99989L6.07794 3.92238C5.92171 3.76611 5.83395 3.55419 5.83395 3.33322C5.83395 3.11225 5.92171 2.90032 6.07794 2.74405Z"
                            fill="#080827"></path>
                    </svg>
                </button>
            </div>
            <div class="splide__track">
                <ul class="splide__list">

                    @for (int i = 0; i < Math.Ceiling((double)Model.AuthorCachingResponse.Count / 4); i++)
                    {
                        <li class="splide__slide grid grid-cols-2 gap-x-3 gap-y-3">
                            @for (int j = 0; j < 4; j++)
                            {
                                var index = i * 4 + j;

                                if (index >= Model.AuthorCachingResponse.Count)
                                {
                                    break;
                                }

                                var author = Model.AuthorCachingResponse[index];

                                <a href="@author.LastCreatedNewsSlug" target="_blank" class="text-center">
                                    <!-- Image Start -->
                                    <img src="@author.ImageURL"
                                         class="w-[68px] h-[68px] rounded-full object-cover mx-auto"
                                         alt="" loading="lazy"/>
                                    <!-- Image End -->
                                    <!-- Name Start -->
                                    <div class="text-gray-500 text-sm font-medium mt-1 mb-2">
                                        @author.FullName
                                    </div>
                                    <!-- Name End -->
                                    <!-- Featured Text Start -->
                                    <div class="text-slate-900 text-xs font-semibold line-clamp-3">
                                        @author.LastCreatedNewsHeadline
                                    </div>
                                    <!-- Featured Text End -->
                                </a>
                            }
                        </li>
                    }

                </ul>
            </div>
        </div> <!-- Slider End -->
    </div> <!-- Authors End -->

