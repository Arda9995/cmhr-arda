                categoryResponseModel.SurveyNewsTwo = allSurveyNews.Take(2).ToList();
                categoryResponseModel.SurveyNewsSix = allSurveyNews.Skip(2).Take(8).ToList();
                categoryResponseModel.SurveyNewsOthers = allSurveyNews.Skip(8).ToList();
            }
