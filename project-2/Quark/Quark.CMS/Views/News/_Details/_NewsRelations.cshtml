@model Quark.CMS.Business.Models.Responses.NewsResponses.DetailsNewsResponse
<div class="card card-flush mt-5">
    <div class="card-header" id="kt_activities_header">
        <h3 class="card-title fw-bold text-gray-900">
            @_localizer["RelatedNews"]
        </h3>
        <div class="card-toolbar">
            <button type="button" class="btn btn-sm btn-primary btn-active-light-primary me-n5" data-bs-toggle="modal" data-bs-target="#publishedNewsModal">
                <partial name="Icons/Add"/>
                @_localizer["Add"]
            </button>
        </div>
    </div>
    <div class="card-body py-4">
        <table id="newsDatatable">
            <thead>
                <tr>
                    <th class="w-75px">@_localizer["News"]</th>
                    <th></th>
                    <th>@_localizer["PublishDate"]</th>
                    <th class="text-center"></th>
                </tr>
            </thead>
            <tbody>
                <div style="display:none">
                    <div id="Col10">
                        {0}
                    </div>
                    <div id="Col11">
                        <div class="d-flex">
                            <a href="/News/Details/{4}">{1}</a>
                        </div>
                        <div class="d-flex mt-2">
                            <div class="badge badge-light-primary fw-bold me-2" data-bs-toggle="tooltip" data-bs-custom-class="tooltip-inverse" data-bs-placement="top" title="@_localizer["Category"]">{2}</div>
                            <div class="badge badge-light-success fw-bold me-2" data-bs-toggle="tooltip" data-bs-custom-class="tooltip-inverse" data-bs-placement="top" title="@_localizer["NewsType"]">{3}</div>
                        </div>
                    </div>
                    <div id="Col12">
                        {0}
                    </div>
                    <div class="text-center" id="Col13">
                        <a onclick="DeleteNewsRelations('/News/RemoveRelatedNews/{0}')" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm me-1" data-bs-toggle="tooltip" data-bs-placement="top" title="@_localizer["Delete"]">
                            <partial name="Icons/Delete" />
                        </a>
                    </div>
                </div>
            </tbody>
        </table>
    </div>
</div>

<style>
    body.modal-open {
        overflow: hidden;
    }

    #publishedNewsModal .modal-dialog {
        max-width: 1000px;
        margin: 1.75rem auto;
    }

    #publishedNewsModal .modal-content {
        max-height: 90vh;
        display: flex;
        flex-direction: column;
    }

    #publishedNewsModal .modal-body {
        flex: 1;
        overflow-y: auto;
    }

    #publishedNewsModal .modal-header,
    #publishedNewsModal .modal-footer {
        flex-shrink: 0;
    }
</style>

<div class="modal fade" tabindex="-1" id="publishedNewsModal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">@_localizer["News"]</h3>
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                </div>
            </div>
            <div class="modal-body">
                <div class="row pb-10">
                    <div class="d-flex align-items-center">
                        <div class="col-6 datatable-search-bar">
                            <i class="bi bi-search position-absolute ms-6 mt-5"></i>
                            <input type="text" id="search-value" data-kt-filter="datatable-search" class="form-control form-control-solid w-450px ps-14" placeholder="Ara"/>
                        </div>
                        <div class="d-flex align-items-center">
                            <button onclick="applyFilterGetAllPublishedNewsPaged()" class="btn btn-primary me-5">@_localizer["Search"]</button>
                        </div>
                    </div>
                </div>
                <table id="publishedNewsDatatable">
                    <thead>
                        <tr>
                            <th class="w-75px">@_localizer["News"]</th>
                            <th class="w-500px"></th>
                            <th>@_localizer["UpdatedDate"]</th>
                            <th>@_localizer["PublishDate"]</th>
                            <th class="text-center"></th>
                            <th class="text-center"></th>
                            <th class="text-center"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <div style="display:none">
                            <div id="Col20">
                                {0}
                            </div>
                            <div id="Col21">
                                <div class="d-flex">
                                    <a style="cursor: pointer;" onclick="addSelectedNews('{0}')" >{1}</a>
                                </div>
                                <div class="d-flex mt-2">
                                    <div class="badge badge-light-primary fw-bold me-2" data-bs-toggle="tooltip" data-bs-custom-class="tooltip-inverse" data-bs-placement="top" title="@_localizer["Category"]">{2}</div>
                                    <div class="badge badge-light-success fw-bold me-2" data-bs-toggle="tooltip" data-bs-custom-class="tooltip-inverse" data-bs-placement="top" title="@_localizer["NewsType"]">{3}</div>
                                </div>
                            </div>
                            <div id="Col22">
                                {0}
                            </div>   
                            <div id="Col23">
                                {0}
                            </div>
                            <div id="Col24">
                                <a class="btn btn-sm btn-primary selectButton_{0}" onclick="addSelectedNews('{0}')">@_localizer["Select"]</a>
                            </div>           
                            <div id="Col25">
                                <a class="btn btn-sm btn-danger deleteButton_{0} d-none" onclick="removeSelectedNews('{0}')">@_localizer["Delete"]</a>
                            </div>           
                            <div id="Col26">
                                <a class="btn btn-sm btn-info" href="/News/Details/{0}" target="_blank">@_localizer["View"]</a>
                            </div>
                        </div>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>