                @* <h2 class="font-helvetica mt-7 mb-8">@Model.SubTitle</h2> <!-- Description End --> *@
                <!-- Only Mobile Area End --> <!-- Thumbnail Start -->
            <div class="mt-6 prose font-helvetica max-w-full text-xl text-content articleDetails" property="articleBody">
                    @if (Model.Video != null && Model.VideoPlayerID != null)
                    {
                        if (Model.VideoPlayerID == 1)
                        {
                            <div class="aspect-[16/9] relative overflow-hidden">
                                <iframe id="videoPlayer"
                                        src="https://www.youtube.com/embed/@Model.Video"
                                        style="
									width: 100%;
									height: 100%;
									position: absolute;
									left: 0px;
									top: 0px;
									overflow: hidden;
									border: none;"
                                        allowfullscreen
                                        title="YouTube Video Player"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share">
                                </iframe>
                            </div>

                        }
                        if (Model.VideoPlayerID == 2)
                        {
                            <div class="aspect-[16/9] relative overflow-hidden">
                                <iframe id="videoPlayer" src="https://geo.dailymotion.com/player.html?video=@Model.Video" style="
										width: 100%;
										height: 100%;
										position: absolute;
										left: 0px;
										top: 0px;
										overflow: hidden;
										border: none;
                                                                " allowfullscreen title="Dailymotion Video Player" allow="web-share">
                                </iframe>
                            </div>
                        }
                    }

                    <!-- Ad Start --> <!-- Ad Start -->
                <partial name="~/Views/Shared/AdContainers/_GeneralMembranaAdArea.cshtml" /> <!-- Ad End --> <!-- Ad End -->
                    @* 	<blockquote class="border-l-4 border border-gray-300/40 italic text-lg text-gray-800 bg-gray-50 p-4 rounded-lg shadow-sm">
                    <p class="m-0 p-0">Örnek bir blockquote alanıdır burası.</p>
                    <footer class="mt-2 text-sm text-gray-500"> — Yazar Adı </footer>
                    </blockquote> *@
                    @Html.Raw(Model.Content)
                </div>
                @if (Model.TagList.Any())
                {
                    <!-- Related Topics Start -->
                    <div class="flex flex-wrap text-sm font-semibold mt-4 mb-6 gap-2">
                        <span class="inline-block text-transparent bg-clip-text bg-gradient-to-r from-[#FF0101] to-[#0D4ABC] shrink-0">İlgili Konular:</span>
                        @foreach (var tag in Model.TagList)
                        {
                            <a href="@tag.Slug" class="text-gray-500 hover:text-black transition-all"> #@Html.Raw(tag.Text) </a>
                        }
                    </div> <!-- Related Topics End -->
                }
            <partial name="~/Views/Shared/AdContainers/_GeneralTaboolaTopAdArea.cshtml" />
            </div>
            @await Component.InvokeAsync("ColumArticlesWidgetComponent")
