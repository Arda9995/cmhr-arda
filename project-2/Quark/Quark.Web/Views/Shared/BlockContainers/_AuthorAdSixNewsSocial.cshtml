@model Quark.API.Business.Models.Responses.PageResponses.MainPageResponse

@{
    var newsList = Model.PageNewsCachingResponses.Where(x => x.BlockKey == "Anasayfa-YazarAlti").ToList();
    var authors = Model.AuthorCachingResponse;
}

<div class="grid grid-cols-12 gap-6" data-astro-cid-j7pv25f6>
        <div class="col-span-12 md:col-span-12" data-astro-cid-j7pv25f6>
     <!-- Authors Start -->
        <div class="px-5 py-4 bg-neutral-50 mb-4" data-astro-cid-j7pv25f6>
            <!-- Title Start -->
            <div class="text-slate-900 text-xl font-semibold text-center mb-5" data-astro-cid-j7pv25f6><a target="_blank" href="/gunun-kose-yazilari" target="_blank">Cumhuriyet Gazetesi Yazarları</a></div>
