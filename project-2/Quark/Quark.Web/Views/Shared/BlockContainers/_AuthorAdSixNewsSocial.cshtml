                        </svg>
                    </button>
                </div>
                <div class="splide__track">
                    <ul class="splide__list">
                     @{
                                int counter = 0;
                            }

                            @for (int i = 0; i < authors.Count; i++)
                            {
                                if (counter % 6 == 0)
                                {
                                    @:<li class="splide__slide grid grid-cols-12 md:grid-cols-6 gap-x-3 gap-y-3" data-astro-cid-j7pv25f6>
                                }

                                <a target="_blank" href="@authors[i].LastCreatedNewsSlug" class="text-center">
                                    <img src="@authors[i].ImageURL"
                                         class="w-[68px] h-[68px] rounded-full object-cover mx-auto"
                                         alt="@authors[i].FullName"
                                         loading="lazy" />
                                    <div class="text-gray-500 text-sm font-medium mt-1 mb-2">
                                        @authors[i].FullName
                                    </div>
                                    <div class="text-slate-900 text-sm font-semibold leading-5">
                                        @authors[i].LastCreatedNewsHeadline
                                    </div>
                                </a>

                                counter++;

                                if (counter % 6 == 0 || i == authors.Count - 1)
                                {
                                    @:</li>
                                }
                            }

                    </ul>
                </div>
            </div>
