        sourceWithResponse.CategoryNine = finalResult.Take(9).ToList();
        sourceWithResponse.CategoryOthers = finalResult.Skip(9).Take(20).ToList();

        sourceWithResponse.ID = sourceId;

        result.Data = sourceWithResponse;

        var jsonData = JsonConvert.SerializeObject(sourceWithResponse);
        await _cache.Set(string.Format(RedisKeys.NewsBySourceSlug, sourceSlug), jsonData,
            RedisTTLSeconds.NewsBySourceSlug_TTL);

        return result;
