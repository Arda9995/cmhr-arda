<div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
    <h1 class="page-heading d-flex text-gray-900 fw-bold fs-3 flex-column justify-content-center my-0 mb-2">
        @ViewData[ViewDataNames.Title]
    </h1>
    <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
        <li class="breadcrumb-item text-muted">
            <a href="/" class="text-muted text-hover-primary">
                @_localizer["HomePage"]
            </a>
        </li>
        @{
            if (ViewData[ViewDataNames.Breadcrumb] != null)
            {
                var breadcrumbList = ViewData[ViewDataNames.Breadcrumb] as List<BreadcrumbItem>;
                foreach (BreadcrumbItem item in breadcrumbList)
                {
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-400 w-5px h-2px"></span>
                    </li>

                    if (string.IsNullOrEmpty(item.Url))
                    {
                        <li class="breadcrumb-item text-muted">@item.Name</li>
                    }
                    else
                    {
                        <li class="breadcrumb-item text-muted">
                            <a href="@item.Url" class="text-muted text-hover-primary">@item.Name</a>
                        </li>
                    }
                }
            }
        }
    </ul>
</div>