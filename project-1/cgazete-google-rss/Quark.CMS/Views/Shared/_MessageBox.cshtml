            <span class="path1"></span><span class="path2"></span><span class="path3"></span>
        </i>
        <div class="d-flex flex-column text-light pe-0 pe-sm-10 fs-5">
            <h4 class="mb-2 text-light">@_localizer["Error"]</h4>
