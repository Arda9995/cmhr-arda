-- Google AI Feed
-- Production tabloları: dbo schema, tablo adları "News.*" (EF [Table("News.News")] ile birebir).
-- Deploy sonrası CMS'de NewsPhotoTypes cache'inin yenilenmesi gerekir (veya ilk CMS istekte otomatik yenilenir).

-- ExcludeFromGoogleAiFeed -> AllowGoogleAiFeed
DECLARE @tables TABLE ([Name] SYSNAME, [Constraint] SYSNAME);
INSERT INTO @tables VALUES
    (N'News.News', N'DF_News_AllowGoogleAiFeed'),
    (N'News.NewsPublished', N'DF_NewsPublished_AllowGoogleAiFeed'),
    (N'News.NewsVersions', N'DF_NewsVersions_AllowGoogleAiFeed');

DECLARE @table SYSNAME, @constraint SYSNAME, @full NVARCHAR(300), @oldDefault SYSNAME, @sql NVARCHAR(MAX);
DECLARE table_cursor CURSOR LOCAL FAST_FORWARD FOR SELECT [Name], [Constraint] FROM @tables;
OPEN table_cursor;
FETCH NEXT FROM table_cursor INTO @table, @constraint;
WHILE @@FETCH_STATUS = 0
BEGIN
    SET @full = N'dbo.' + QUOTENAME(@table);

    IF COL_LENGTH(@full, 'ExcludeFromGoogleAiFeed') IS NOT NULL AND COL_LENGTH(@full, 'AllowGoogleAiFeed') IS NULL
    BEGIN
        SELECT @oldDefault = dc.[name]
        FROM sys.default_constraints dc
        JOIN sys.columns c ON c.object_id = dc.parent_object_id AND c.column_id = dc.parent_column_id
        WHERE dc.parent_object_id = OBJECT_ID(@full) AND c.[name] = 'ExcludeFromGoogleAiFeed';

        IF @oldDefault IS NOT NULL
        BEGIN
            SET @sql = N'ALTER TABLE ' + @full + N' DROP CONSTRAINT ' + QUOTENAME(@oldDefault);
            EXEC sp_executesql @sql;
        END

        SET @sql = N'UPDATE ' + @full + N' SET [ExcludeFromGoogleAiFeed] = CASE WHEN [ExcludeFromGoogleAiFeed] = 1 THEN 0 ELSE 1 END';
        EXEC sp_executesql @sql;

        SET @sql = @full + N'.ExcludeFromGoogleAiFeed';
        EXEC sp_rename @sql, N'AllowGoogleAiFeed', N'COLUMN';
    END

    IF COL_LENGTH(@full, 'AllowGoogleAiFeed') IS NULL
    BEGIN
        SET @sql = N'ALTER TABLE ' + @full + N' ADD [AllowGoogleAiFeed] BIT NOT NULL CONSTRAINT ' + QUOTENAME(@constraint) + N' DEFAULT (0)';
        EXEC sp_executesql @sql;
    END
    ELSE IF NOT EXISTS (
        SELECT 1 FROM sys.default_constraints dc
        JOIN sys.columns c ON c.object_id = dc.parent_object_id AND c.column_id = dc.parent_column_id
        WHERE dc.parent_object_id = OBJECT_ID(@full) AND c.[name] = 'AllowGoogleAiFeed')
    BEGIN
        SET @sql = N'ALTER TABLE ' + @full + N' ADD CONSTRAINT ' + QUOTENAME(@constraint) + N' DEFAULT (0) FOR [AllowGoogleAiFeed]';
        EXEC sp_executesql @sql;
    END

    SET @oldDefault = NULL;
    FETCH NEXT FROM table_cursor INTO @table, @constraint;
END
CLOSE table_cursor;
DEALLOCATE table_cursor;
GO

