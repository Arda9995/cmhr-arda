    <div class="grid grid-cols-12 gap-6" id="contentArea">
        <div class="col-span-12 lg:col-span-8">
            <!-- Thumbnail Start -->
            <div class="aspect-[16/9]">
                <img class="w-full h-full object-cover" src="@Model.CoverPhoto" alt="@Html.Raw(Model.Title)">
            </div>
            <!-- Thumbnail End -->
            <h2 class="text-2xl font-metropolis font-semibold mt-6 description" data-subtitle-news-id="@Model.ID">@Html.Raw(Model.SubTitle)</h2>
            <div class="mt-6 prose font-helvetica text-xl max-w-full text-content articleDetails" id="photoGallery" property="articleBody">
                @if (isMobile)
                {
                    <partial name="~/Views/Shared/AdContainers/_NewsDetailUnderSpotAdArea.cshtml" />
                }
                <partial name="~/Views/Shared/AdContainers/_GeneralMembranaAdArea.cshtml" />
                <div class="text-content" data-content-news-id="@Model.ID">
                    @Html.Raw(Model.Content)
                </div>
                @{
                    var counter = 1;
                }
                @foreach (var photoGalleryItem in Model.PhotoGalleryItems)
                {
                    <div id="photo-@counter" class="photo">
                        <div class="aspect-[16/9]">
                            <img class="w-full h-full object-cover" src="@photoGalleryItem.ImageURL" alt="@Html.Raw(Model.Title)"
                                 loading="lazy">
                        </div>
                        @Html.Raw(photoGalleryItem.Content)
                    </div>
                    counter++;
                }
            </div> <!-- Related Topics Start -->
            <div class="flex flex-wrap text-sm font-semibold mt-4 mb-6 gap-2">
                <span class="inline-block text-transparent bg-clip-text bg-gradient-to-r from-[#FF0101] to-[#0D4ABC] shrink-0">İlgili Konular:</span>
                @foreach (var tag in Model.TagList)
                {
                    <a href="@tag.Slug" class="text-gray-500 hover:text-black transition-all"> #@Html.Raw(tag.Text) </a>
                }

            </div>
        </div>
        @await Component.InvokeAsync("News", new NewsViewComponentModel
       {
           MethodName = "MostViewedNews",
           NewsCount = 4
       })
    </div>
    <partial name="~/Views/News/DetailPartials/_RelatedNews.cshtml" model="Model" />
</div>
<div id="load-sentinel" style="height: 1px;"></div>