    public async Task<ServiceResult> RefreshAll()
    {
        var result = new ServiceResult();

        var govAnnounceResult = await RefreshMainPageGovernmentAnnouncement();
        if (!govAnnounceResult.IsSuccess)
            result.SetError("RefreshDailyGovernmentAnnouncement failed: " + govAnnounceResult.Message);

        var columnArticlesResult = await RefreshAuthorSideColumnArticles();
        if (!columnArticlesResult.IsSuccess)
            result.SetError("RefreshTodaysColumnArticles failed: " + columnArticlesResult.Message);

        var zodiacSign = await RefreshMainPageZodiacSignBlock();
        if (!zodiacSign.IsSuccess)
            result.SetError("RefreshZodiacSignBlock failed: " + zodiacSign.Message);

        var todayColumnArticles = await RefreshNewsByCategorySlug((int)CategoryEnum.GovernmentAnnouncement);
        if (!todayColumnArticles.IsSuccess)
            result.SetError("TodayColumnArticles failed: " + todayColumnArticles.Message);

        var refreshAuthorsMainpageAndTodayNewsList =
            await authorCachingService.RefreshAll();
        if (!refreshAuthorsMainpageAndTodayNewsList.IsSuccess)
            result.SetError("Mainpage Authors failed: " + refreshAuthorsMainpageAndTodayNewsList.Message);

        return result;
    }

