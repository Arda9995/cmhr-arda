    public async Task HandlePublishCacheOperations(News news)
    {
        await xmlFeedCachingService.RefreshGoogleAiRSS();

        await RefreshNewsDetails(news.ID);
        await RefreshNewsByCategorySlug(news.CategoryID);
        await RefreshNewsPublishedSearchByID(news.ID);

        if (news.NewsTypeID == (int)NewsTypesEnum.ColumnArticles)
        {
            var authorSlug = _context.Authors.Where(x => x.ID == news.AuthorID).Select(x => x.Url).FirstOrDefault();
            await RefreshAuthorLastNews(news.AuthorID ?? 0);
            await RefreshAuthorDetailLastColumnArticles(authorSlug);
            await RefreshAuthorSideColumnArticles();
            await authorCachingService.RefreshMainPageAuthorsAll();
            await authorCachingService.RefreshAuthorNewsTodayList();
            await authorCachingService.RefreshAuthorCategoryNewsTodayList(authorSlug);
        }

        if (news.NewsTypeID == (int)NewsTypesEnum.PhotoGallery)
        {
            await newsPhotosCachingService.RefreshNewsPublishedPhotoGalleryItems(news.ID);
        }

        if (news.NewsTypeID == (int)NewsTypesEnum.GovernmentAnnouncement)
        {
            await RefreshMainPageGovernmentAnnouncement();
        }

        if (news.NewsTypeID == (int)NewsTypesEnum.ZodiacSigns)
        {
            var zodiacSignBlockResponse = await RefreshMainPageZodiacSignBlock();
        }

        var tags = await (from nt in _context.NewsTags
            join t in _context.Tags on nt.TagID equals t.ID
            where nt.NewsID == news.ID
            select new { t.Url }).ToListAsync();

        if (tags.Count > 0)
        {
            foreach (var tag in tags)
            {
                await RefreshNewsByTagSlug(tag.Url);
            }
        }

        var sources = await (from nt in _context.NewsSources
            join t in _context.Sources on nt.SourceID equals t.ID
            where nt.NewsID == news.ID
            select new { t.Url }).ToListAsync();

        if (sources.Count > 0)
        {
            foreach (var source in sources)
            {
                await RefreshNewsBySourceSlug(source.Url);
            }
        }

        var blockKey = await (from bi in _context.BlockItems
            join b in _context.Blocks on bi.BlockID equals b.ID
            where bi.NewsID == news.ID
            select b.Key).ToListAsync();

        if (blockKey.Any())
        {
            foreach (var block in blockKey)
            {
                await RefreshBlockNewsWithKey(block);
            }
        }

        cloudflareAdapter.Purge(news.Slug.TrimStart('/').PrepareWebsiteUrl(_appSettingsKeys.Common_ClientWebSite));
    }

