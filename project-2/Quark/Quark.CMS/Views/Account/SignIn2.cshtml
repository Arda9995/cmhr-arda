@{
    Layout = "_LayoutPublic";
    ViewData[ViewDataNames.Title] = _localizer["SecureLogin"];
}

@model Quark.CMS.Business.Models.Requests.AccountRequests.SignInRequest

<style>
    body {
        background-image: url('https://metronic.avvamobile.com/8.2.0/assets/media/auth/bg4.jpg');
    }

    [data-bs-theme="dark"] body {
        background-image: url('https://metronic.avvamobile.com/8.2.0/assets/media/auth/bg4-dark.jpg');
    }
</style>


<div class="d-flex flex-column flex-column-fluid flex-lg-row">
    <div class="d-flex flex-center w-lg-50 pt-15 pt-lg-0 px-10">
        <div class="d-flex flex-center flex-lg-start flex-column">
            <img alt="Logo" src="/img/logo-white.svg" class="h-75px"/>
            <h2 class="text-white fw-normal m-0">
                Pozitron CMS
            </h2>
        </div>
    </div>
    <div class="d-flex flex-column-fluid flex-lg-row-auto justify-content-center justify-content-lg-end p-12 p-lg-20">
        <div class="bg-body d-flex flex-column align-items-stretch flex-center rounded-4 w-md-600px p-20">
            <div class="d-flex flex-center flex-column flex-column-fluid px-lg-10 pb-15 pb-lg-20">
                <form class="form w-100" method="post" onsubmit="return validateForm();">
                    <input type="hidden" id="ReCaptchaToken" asp-for="@Model.ReCaptchaToken"/>
                    <div class="text-center mb-11">
                        <h1 class="text-dark fw-bolder mb-3">
                            @_localizer["SecureLogin"]
                        </h1>
                        <div class="text-gray-500 fw-semibold fs-6">
                            @_localizer["SecureLoginDescription"]
                        </div>
                    </div>
                    <partial name="_MessageBox"/>
                    <div class="fv-row mb-8">
                        <input class="form-control bg-transparent h-60px w-100 fs-3 mx-1 my-2" type="text" asp-for="Credential" placeholder="@_localizer["Phone"]"/>
                        <span class="fv-plugins-message-container invalid-feedback" asp-validation-for="@Model.Credential"></span>
                    </div>

                    <div class="fv-row justify-content-center mb-10">
                        <div id="captcha_holder"></div>
                    </div>

                    <div class="fv-row mb-8 fv-plugins-icon-container fv-plugins-bootstrap5-row-valid">
                        <label class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="toc" value="1">
                            <span class="form-check-label fw-semibold text-gray-700 fs-base ms-1">
                                @Html.Raw(_localizer["UserAgreementText"])
                            </span>
                        </label>
                        <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback" id="agreementMessage"></div> <!-- Feedback container -->
                    </div>

                    <div class="d-grid mb-10">
                        <button type="submit" class="btn btn-primary">@_localizer["SignIn"]</button>
                    </div>
                </form>
            </div>
            <div class="d-flex flex-stack px-lg-10">
                <div class="me-0">
                    <button class="btn btn-flex btn-link btn-color-gray-700 btn-active-color-primary rotate fs-base" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-start" data-kt-menu-offset="0px, 0px">
                        @Html.Raw(string.Format(_localizer["CurrentLanguageWithFlagsSignIn"], _appSettings.CDN_AssetsFolderFullUrl))
                        <i class="ki-duotone ki-down fs-5 text-muted rotate-180 m-0"></i>
                    </button>
                    <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-4 fs-7" data-kt-menu="true" id="kt_auth_lang_menu" style="">
                        <div class="menu-item px-3">
                            <a href="/Account/ChangeLanguage?lang=tr" class="menu-link d-flex px-5 @(_localizer["CurrentLanguage"] == "Türkçe" ? "active" : "")" data-kt-lang="Turkish">
                                <span class="symbol symbol-20px me-4">
                                    <img data-kt-element="lang-flag" class="rounded-1" src="@_appSettings.CDN_AssetsFolderFullUrl/assets/media/flags/turkey.svg" alt="">
                                </span>
                                <span data-kt-element="lang-name">@_localizer["Turkish"]</span>
                            </a>
                        </div>
                        <div class="menu-item px-3">
                            <a href="/Account/ChangeLanguage?lang=en" class="menu-link d-flex px-5 @(_localizer["CurrentLanguage"] == "English" ? "active" : "")" data-kt-lang="English">
                                <span class="symbol symbol-20px me-4">
                                    <img data-kt-element="lang-flag" class="rounded-1" src="@_appSettings.CDN_AssetsFolderFullUrl/assets/media/flags/united-states.svg" alt="">
                                </span>
                                <span data-kt-element="lang-name">@_localizer["English"]</span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="d-flex fw-semibold text-primary fs-base gap-5">
                    <a href="#" target="_blank">@_localizer["UserAgreement"]</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var onloadCallback = function () {
        grecaptcha.render('captcha_holder', {
            'sitekey': '@Model.ReCaptchaSiteKey',
            'callback': verifyCallback,
            'theme': 'light'
        });
    };

    function verifyCallback(token) {
        document.getElementById('ReCaptchaToken').value = token;
    }
    
    function validateForm() {
        var agreementChecked = document.querySelector('input[name="toc"]').checked;
        var agreementMessage = document.getElementById('agreementMessage');
        
        if (!agreementChecked) {
            agreementMessage.innerHTML = 'Lütfen kullanıcı sözleşmesini kabul ediniz.';
            agreementMessage.style.display = 'block';
            return false; 
        }
        
        agreementMessage.innerHTML = ''; 
        agreementMessage.style.display = 'none'; 
        return true;
    }
</script>

<script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit" async defer>
</script>
